    "2d2ed0e5-0d81-4856-b4d4-9081de297302": {
      "type": "section-testimonials",
      "blocks": {
        "template--20725139243329__2d2ed0e5-0d81-4856-b4d4-9081de297302-testimonial-1": {
          "type": "testimonial",
          "settings": {
            "initials": false,
            "initials_color_palette": "accent",
            "author": "Daniel Smith",
            "place": "London",
            "text": "I recently invested in these high-end audiophile speakers, and I'm absolutely blown away by their performance. The audio quality is nothing short of a masterpiece. The sound is incredibly detailed, with crystal-clear highs that make every instrument and vocal come alive. The midrange is warm and inviting, adding depth to every song, while the bass is deep and powerful without ever being overpowering.",
            "score": 4
          }
        },
        "template--20725139243329__2d2ed0e5-0d81-4856-b4d4-9081de297302-testimonial-2": {
          "type": "testimonial",
          "settings": {
            "initials": false,
            "initials_color_palette": "accent",
            "author": "Hanna Steele",
            "place": "Amsterdam",
            "text": "What truly sets these speakers apart is their precision and accuracy. I can hear nuances in my favorite music that I've never noticed before – it's like rediscovering my entire music collection. Whether I'm listening to classical music, rock, or electronic beats, these speakers reproduce the sound faithfully and with an astonishing level of clarity.",
            "score": 5
          }
        },
        "template--20725139243329__2d2ed0e5-0d81-4856-b4d4-9081de297302-testimonial-3": {
          "type": "testimonial",
          "settings": {
            "initials": false,
            "initials_color_palette": "accent",
            "author": "Frank Spears",
            "place": "Canada",
            "text": "This soundbar with a subwoofer has transformed my home entertainment experience. The soundbar provides clear dialogue and impressive virtual surround sound, making movies and TV shows come to life. What really sets it apart is the subwoofer, which adds a powerful, room-shaking bass that enhances action sequences and music. The setup was a breeze, and the remote control is intuitive. It's like having a full-fledged home theater system without the clutter, making it a fantastic addition to any living room for a cinematic experience.",
            "score": 5
          }
        },
        "66365eb3-2e59-442e-bf2a-5efa9e41bfce": {
          "type": "testimonial",
          "settings": {
            "initials": false,
            "initials_color_palette": "accent",
            "author": "Frank Gazillo",
            "place": "Los Angeles",
            "text": "These bookshelf hi-fi speakers are a must-have for any serious audiophile. The sound quality is nothing short of extraordinary, delivering a wide and detailed soundstage. The midrange is warm and inviting, while the high frequencies are crisp without being harsh. They truly shine when it comes to classical and jazz music, rendering every instrument and note with precision. The elegant design makes them a statement piece in any room, and they're a perfect addition to a dedicated music listening setup.",
            "score": 5
          }
        }
      },
