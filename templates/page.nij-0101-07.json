olor 180ms ease, color 180ms ease;\n  }\n\n  #ars-componentes-{{ section.id }} .ars-componentes__option + label {\n    border-left: 1px solid #cfd5d5;\n  }\n\n  #ars-componentes-{{ section.id }} .ars-componentes__details {\n    margin-top: 28px;\n    padding-top: 24px;\n    border-top: 1px solid #cfd5d5;\n  }\n\n  #ars-componentes-{{ section.id }} .ars-componentes__description {\n    margin: 0;\n    color: var(--ars-gray);\n    font-size: 15px;\n    line-height: 1.5;\n  }\n\n  #ars-componentes-{{ section.id }} .ars-componentes__note {\n    margin: 28px 0 0;\n    color: var(--ars-gray);\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  #ars-componentes-{{ section.id }} .ars-componentes__sin {\n    display: none;\n  }\n\n  #ars-con-{{ section.id }}:checked\n  ~ .ars-componentes__layout .ars-componentes__option--con,\n  #ars-sin-{{ section.id }}:checked\n  ~ .ars-componentes__layout .ars-componentes__option--sin {\n    color: #ffffff;\n    background: var(--ars-orange);\n  }\n\n  #ars-sin-{{ section.id }}:checked\n  ~ .ars-componentes__layout .ars-componentes__con {\n    display: none;\n  }\n\n  #ars-sin-{{ section.id }}:checked\n  ~ .ars-componentes__layout .ars-componentes__sin {\n    display: block;\n  }\n\n  #ars-con-{{ section.id }}:focus-visible\n  ~ .ars-componentes__layout .ars-componentes__option--con,\n  #ars-sin-{{ section.id }}:focus-visible\n  ~ .ars-componentes__layout .ars-componentes__option--sin {\n    outline: 2px solid var(--ars-dark);\n    outline-offset: -4px;\n  }\n\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    #ars-componentes-{{ section.id }} .ars-componentes__content {\n      padding: 28px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__title {\n      font-size: 40px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__intro {\n      font-size: 15px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #ars-componentes-{{ section.id }} {\n      padding: 28px 20px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__layout {\n      grid-template-columns: minmax(0, 1fr);\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__content {\n      padding: 24px 16px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__label {\n      margin-bottom: 18px;\n      font-size: 10px;\n      letter-spacing: 1.3px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__title {\n      margin-bottom: 18px;\n      font-size: 40px;\n      line-height: 1;\n      letter-spacing: -1px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__intro {\n      margin-bottom: 18px;\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__option {\n      padding: 12px 14px;\n      font-size: 13px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__details {\n      margin-top: 22px;\n      padding-top: 20px;\n    }\n\n    #ars-componentes-{{ section.id }} .ars-componentes__note {\n      margin-top: 22px;\n      font-size: 10px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #ars-componentes-{{ section.id }} .ars-componentes__option {\n      transition: none;\n    }\n  }\n</style>\n\n<section\n  id=\"ars-componentes-{{ section.id }}\"\n  aria-labelledby=\"ars-componentes-title-{{ section.id }}\"\n>\n  <div class=\"ars-componentes__inner\">\n\n    <input\n      class=\"ars-componentes__radio\"\n      type=\"radio\"\n      id=\"ars-con-{{ section.id }}\"\n      name=\"ars-vista-{{ section.id }}\"\n      aria-label=\"Mostrar panel con funda YUMA\"\n      checked\n    >\n\n    <input\n      class=\"ars-componentes__radio\"\n      type=\"radio\"\n      id=\"ars-sin-{{ section.id }}\"\n      name=\"ars-vista-{{ section.id }}\"\n      aria-label=\"Mostrar panel sin funda\"\n    >\n\n    <div class=\"ars-componentes__layout\">\n\n      <div class=\"ars-componentes__media\">\n        <img\n          class=\"ars-componentes__image ars-componentes__con\"\n          src=\"{{ imagen_con_funda | escape }}\"\n          alt=\"Panel femenino con funda negra YUMA sobre maniquí.\"\n          width=\"1122\"\n          height=\"1402\"\n          loading=\"lazy\"\n        >\n\n        <img\n          class=\"ars-componentes__image ars-componentes__sin\"\n          src=\"{{ imagen_sin_funda | escape }}\"\n          alt=\"Panel femenino sin funda, con material amarillo visible sobre maniquí.\"\n          width=\"1122\"\n          height=\"1402\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"ars-componentes__content\">\n\n        <p class=\"ars-componentes__label\">\n          Del panel a su funda\n        </p>\n\n        <h2\n          class=\"ars-componentes__title\"\n          id=\"ars-componentes-title-{{ section.id }}\"\n        >\n          <span class=\"ars-componentes__word\">Cada</span>\n          <span class=\"ars-componentes__word\">componente</span>\n          <span class=\"ars-componentes__word\">tiene</span>\n          <span class=\"ars-componentes__word\">una</span>\n          <span class=\"ars-componentes__word\">función.</span>\n        </h2>\n\n        <p class=\"ars-componentes__intro\">\n          Explora las fotografías del panel femenino y de su\n          funda de YUMA de 200 deniers, respetando la forma\n          y los acabados del producto.\n        </p>\n\n        <div class=\"ars-componentes__controls\">\n          <label\n            class=\"ars-componentes__option ars-componentes__option--con\"\n            for=\"ars-con-{{ section.id }}\"\n          >\n            Con funda YUMA\n          </label>\n\n          <label\n            class=\"ars-componentes__option ars-componentes__option--sin\"\n            for=\"ars-sin-{{ section.id }}\"\n          >\n            Sin funda\n          </label>\n        </div>\n\n        <div class=\"ars-componentes__details\">\n          <p class=\"ars-componentes__description ars-componentes__con\">\n            Funda de YUMA de 200 deniers: tejido negro mate\n            y acabado perimetral visible.\n          </p>\n\n          <p class=\"ars-componentes__description ars-componentes__sin\">\n            Panel sin funda: vista de su conformación\n            y de los acabados visibles del conjunto.\n          </p>\n        </div>\n\n        <p class=\"ars-componentes__note\">\n          Estas vistas no asignan un modelo ni un nivel\n          de protección al panel femenino mostrado.\n        </p>\n\n      </div>\n    </div>\n  </div>\n</section>",
