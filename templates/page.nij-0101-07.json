    margin: 0 0 22px;\n    color: #626c70;\n    font-size: 16px;\n    line-height: 1.5;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__link {\n    display: inline-block;\n    max-width: 100%;\n    padding-bottom: 5px;\n\n    border-bottom: 1px solid currentColor;\n    color: #1d2426;\n\n    font-size: 12px;\n    line-height: 1.5;\n    text-decoration: none;\n    transition: color 180ms ease;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__link:hover {\n    color: #DD5409;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__link:focus-visible {\n    outline: 2px solid #DD5409;\n    outline-offset: 5px;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__steps {\n    min-width: 0;\n    padding: 0;\n    margin: 0;\n    list-style: none;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__step {\n    display: grid;\n    grid-template-columns: 42px minmax(0, 1fr);\n    gap: 18px;\n\n    padding: 26px 0;\n    margin: 0;\n    border-top: 1px solid #c7d0c8;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__number {\n    display: block;\n    padding-top: 2px;\n    color: #7e8d81;\n    font-size: 32px;\n    line-height: 1;\n    letter-spacing: -0.5px;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__step-title {\n    margin: 0 0 12px;\n    color: #1d2426;\n\n    font-family: var(--font-heading-family, inherit);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 700);\n\n    font-size: 26px;\n    line-height: 1;\n    letter-spacing: -0.5px;\n    text-transform: none;\n  }\n\n  #ars-verificacion-{{ section.id }} .ars-verificacion__step-copy {\n    margin: 0;\n    color: #626c70;\n    font-size: 15px;\n    line-height: 1.5;\n  }\n\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    #ars-verificacion-{{ section.id }} .ars-verificacion__inner {\n      gap: 32px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__title {\n      font-size: 56px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__step {\n      grid-template-columns: 34px minmax(0, 1fr);\n      gap: 14px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__step-title {\n      font-size: 24px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #ars-verificacion-{{ section.id }} {\n      padding: 28px 20px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__inner {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 28px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__label {\n      margin-bottom: 18px;\n      font-size: 10px;\n      letter-spacing: 1.3px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__title {\n      margin-bottom: 20px;\n      font-size: 40px;\n      line-height: 1;\n      letter-spacing: -1px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__intro {\n      margin-bottom: 18px;\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__link {\n      font-size: 11px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__step {\n      grid-template-columns: 32px minmax(0, 1fr);\n      gap: 14px;\n      padding: 22px 0;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__step:last-child {\n      padding-bottom: 0;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__number {\n      font-size: 28px;\n    }\n\n    #ars-verificacion-{{ section.id }} .ars-verificacion__step-title {\n      margin-bottom: 10px;\n      font-size: 24px;\n      line-height: 1;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #ars-verificacion-{{ section.id }} .ars-verificacion__link {\n      transition: none;\n    }\n  }\n</style>\n\n<section\n  id=\"ars-verificacion-{{ section.id }}\"\n  aria-labelledby=\"ars-verificacion-title-{{ section.id }}\"\n>\n  <div class=\"ars-verificacion__inner\">\n\n    <div class=\"ars-verificacion__content\">\n\n      <p class=\"ars-verificacion__label\">\n        05 / Información verificable\n      </p>\n\n      <h2\n        class=\"ars-verificacion__title\"\n        id=\"ars-verificacion-title-{{ section.id }}\"\n      >\n        <span class=\"ars-verificacion__word\">Una</span>\n        <span class=\"ars-verificacion__word\">prueba</span>\n        <span class=\"ars-verificacion__word\">y</span>\n        <span class=\"ars-verificacion__word\">una</span>\n        <span class=\"ars-verificacion__word\">certificación</span>\n        <span class=\"ars-verificacion__word\">tienen</span>\n        <span class=\"ars-verificacion__word\">alcances</span>\n        <span class=\"ars-verificacion__word\">distintos.</span>\n      </h2>\n\n      <p class=\"ars-verificacion__intro\">\n        La certificación corresponde a un modelo específico\n        e incluye la evaluación y el seguimiento del\n        programa NIJ CTP.\n      </p>\n\n      <a\n        class=\"ars-verificacion__link\"\n        href=\"https://cjttec.org/cpl-ballistic-armor-07/\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n      >\n        Consultar la lista oficial NIJ\n        <span aria-hidden=\"true\">↗</span>\n        <span class=\"visually-hidden\">\n          (se abre en una pestaña nueva)\n        </span>\n      </a>\n\n    </div>\n\n    <ol class=\"ars-verificacion__steps\">\n\n      <li class=\"ars-verificacion__step\">\n        <span class=\"ars-verificacion__number\" aria-hidden=\"true\">\n          01\n        </span>\n\n        <div>\n          <h3 class=\"ars-verificacion__step-title\">\n            Identifica el modelo\n          </h3>\n\n          <p class=\"ars-verificacion__step-copy\">\n            Revisa la designación exacta del producto\n            y su etiqueta.\n          </p>\n        </div>\n      </li>\n\n      <li class=\"ars-verificacion__step\">\n        <span class=\"ars-verificacion__number\" aria-hidden=\"true\">\n          02\n        </span>\n\n        <div>\n          <h3 class=\"ars-verificacion__step-title\">\n            Consulta la lista CPL\n          </h3>\n\n          <p class=\"ars-verificacion__step-copy\">\n            Verifica fabricante, norma, nivel y estado\n            del modelo.\n          </p>\n        </div>\n      </li>\n\n      <li class=\"ars-verificacion__step\">\n        <span class=\"ars-verificacion__number\" aria-hidden=\"true\">\n          03\n        </span>\n\n        <div>\n          <h3 class=\"ars-verificacion__step-title\">\n            Revisa la configuración\n          </h3>\n\n          <p class=\"ars-verificacion__step-copy\">\n            Solicita la documentación aplicable al sistema\n            que vas a adquirir.\n          </p>\n        </div>\n      </li>\n\n    </ol>\n\n  </div>\n</section>",
