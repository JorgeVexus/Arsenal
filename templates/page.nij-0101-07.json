      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "{% liquid\n  assign panel_gr507 = all_products['panel-balistico-gr-507']\n  assign panel_gr407 = all_products['panel-balistico-gr-407']\n%}\n\n<style>\n  #ars-paneles-{{ section.id }} {\n    --ars-orange: #DD5409;\n    --ars-dark: #1d2426;\n    --ars-gray: #626c70;\n\n    background: #ffffff;\n    color: var(--ars-dark);\n    padding: 40px 24px;\n\n    font-family: var(--font-body-family, inherit);\n    font-style: var(--font-body-style, normal);\n    font-weight: var(--font-body-weight, 400);\n  }\n\n  #ars-paneles-{{ section.id }},\n  #ars-paneles-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #ars-paneles-{{ section.id }} h2,\n  #ars-paneles-{{ section.id }} h3,\n  #ars-paneles-{{ section.id }} p,\n  #ars-paneles-{{ section.id }} h2 *,\n  #ars-paneles-{{ section.id }} h3 *,\n  #ars-paneles-{{ section.id }} p * {\n    -webkit-hyphens: none !important;\n    hyphens: none !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__word {\n    display: inline-block;\n    white-space: nowrap !important;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__inner {\n    max-width: 1250px;\n    margin: 0 auto;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__eyebrow {\n    margin: 0 0 24px;\n    color: var(--ars-orange);\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__header {\n    display: grid;\n    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);\n    align-items: end;\n    gap: 40px;\n    margin-bottom: 40px;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__header > * {\n    min-width: 0;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__title {\n    margin: 0;\n    color: var(--ars-dark);\n\n    font-family: var(--font-heading-family, inherit);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 700);\n\n    font-size: 64px;\n    line-height: 1;\n    letter-spacing: -1.5px;\n    text-transform: none;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__intro {\n    max-width: 440px;\n    margin: 0;\n    color: var(--ars-gray);\n    font-size: 16px;\n    line-height: 1.5;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    align-items: start;\n    gap: 32px;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__card {\n    min-width: 0;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__media {\n    position: relative;\n    display: block;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    margin: 0 0 24px;\n    overflow: hidden;\n    border-radius: 3px;\n    background: #e9eae7;\n    color: var(--ars-dark);\n    text-decoration: none;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__image {\n    display: block;\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    object-fit: contain;\n    object-position: center;\n    transition: transform 220ms ease;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__media:hover\n  .ars-paneles__image {\n    transform: scale(1.025);\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__badge {\n    position: absolute;\n    top: 20px;\n    left: 20px;\n    z-index: 1;\n\n    padding: 10px 12px;\n    background: #ffffff;\n    color: var(--ars-dark);\n\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 1px;\n    white-space: nowrap;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__placeholder {\n    display: flex;\n    width: 100%;\n    height: 100%;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    text-align: center;\n    color: var(--ars-gray);\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__category {\n    margin: 0 0 14px;\n    color: var(--ars-orange);\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__model-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 16px;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__model {\n    margin: 0;\n\n    font-family: var(--font-heading-family, inherit);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 700);\n\n    font-size: 44px;\n    line-height: 1;\n    letter-spacing: -1px;\n    text-transform: none;\n    white-space: nowrap;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__model a {\n    color: var(--ars-dark);\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__arrow {\n    display: flex;\n    flex: 0 0 48px;\n    align-items: center;\n    justify-content: center;\n\n    width: 48px;\n    height: 48px;\n\n    border: 1px solid #d9ddde;\n    border-radius: 50%;\n    color: var(--ars-dark);\n    background: transparent;\n    text-decoration: none;\n\n    transition:\n      color 180ms ease,\n      background-color 180ms ease,\n      border-color 180ms ease;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__arrow:hover {\n    background: var(--ars-orange);\n    border-color: var(--ars-orange);\n    color: #ffffff;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__arrow svg {\n    display: block;\n    width: 22px;\n    height: 22px;\n  }\n\n  #ars-paneles-{{ section.id }} .ars-paneles__description {\n    max-width: 490px;\n    margin: 0;\n    color: var(--ars-gray);\n    font-size: 15px;\n    line-height: 1.5;\n  }\n\n  #ars-paneles-{{ section.id }} a:focus-visible {\n    outline: 2px solid var(--ars-orange);\n    outline-offset: 4px;\n  }\n\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    #ars-paneles-{{ section.id }} .ars-paneles__title {\n      font-size: 56px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__header {\n      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);\n      gap: 24px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__grid {\n      gap: 24px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__model {\n      font-size: 38px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #ars-paneles-{{ section.id }} {\n      padding: 28px 20px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__eyebrow {\n      margin-bottom: 18px;\n      font-size: 10px;\n      letter-spacing: 1.5px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__header {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 18px;\n      margin-bottom: 26px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__title {\n      font-size: 40px;\n      line-height: 1;\n      letter-spacing: -1px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__intro {\n      max-width: none;\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 32px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__media {\n      margin-bottom: 20px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__badge {\n      top: 14px;\n      left: 14px;\n      padding: 9px 10px;\n      font-size: 10px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__category {\n      margin-bottom: 12px;\n      font-size: 10px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__model-row {\n      margin-bottom: 12px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__model {\n      font-size: 36px;\n    }\n\n    #ars-paneles-{{ section.id }} .ars-paneles__arrow {\n      flex-basis: 44px;\n      width: 44px;\n      height: 44px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #ars-paneles-{{ section.id }} .ars-paneles__image,\n    #ars-paneles-{{ section.id }} .ars-paneles__arrow {\n      transition: none;\n    }\n  }\n</style>\n\n<section\n  id=\"ars-paneles-{{ section.id }}\"\n  aria-labelledby=\"ars-paneles-title-{{ section.id }}\"\n>\n  <div class=\"ars-paneles__inner\">\n\n    <p class=\"ars-paneles__eyebrow\">\n      04 / Arsenal Protection Mexico\n    </p>\n\n    <div class=\"ars-paneles__header\">\n      <h2\n        id=\"ars-paneles-title-{{ section.id }}\"\n        class=\"ars-paneles__title\"\n      >\n        <span class=\"ars-paneles__word\">Conoce</span>\n        <span class=\"ars-paneles__word\">nuestros</span><br>\n        <span class=\"ars-paneles__word\">paneles</span>\n        <span class=\"ars-paneles__word\">certificados.</span>\n      </h2>\n\n      <p class=\"ars-paneles__intro\">\n        GR507 y GR407: modelos con certificación bajo\n        NIJ 0101.07, de acuerdo con la información de\n        Arsenal Protection Mexico.\n      </p>\n    </div>\n\n    <div class=\"ars-paneles__grid\">\n\n      {% for numero in (1..2) %}\n        {% liquid\n          if numero == 1\n            assign panel = panel_gr507\n            assign modelo = 'GR507'\n            assign destino = '/products/panel-balistico-gr-507'\n            assign descripcion = 'Consulta la documentación del modelo y las opciones de integración para tu institución.'\n          else\n            assign panel = panel_gr407\n            assign modelo = 'GR407'\n            assign destino = '/products/panel-balistico-gr-407'\n            assign descripcion = 'Solicita asesoría sobre el nivel certificado y la configuración correspondiente al modelo.'\n          endif\n\n          assign imagen_panel = panel.featured_image\n          assign texto_alternativo = 'Panel balístico ' | append: modelo | append: ' de Arsenal Protection Mexico'\n        %}\n\n        <article class=\"ars-paneles__card\">\n          <a\n            class=\"ars-paneles__media\"\n            href=\"{{ destino }}\"\n            aria-label=\"Consultar el panel {{ modelo }}\"\n          >\n            <span class=\"ars-paneles__badge\">\n              NIJ 0101.07\n            </span>\n\n            {% if imagen_panel != blank %}\n              {{\n                imagen_panel\n                | image_url: width: 1400\n                | image_tag:\n                  class: 'ars-paneles__image',\n                  loading: 'lazy',\n                  widths: '360, 540, 720, 960, 1200, 1400',\n                  sizes: '(max-width: 749px) calc(100vw - 40px), (max-width: 1298px) calc((100vw - 80px) / 2), 609px',\n                  alt: texto_alternativo\n              }}\n            {% else %}\n              <div class=\"ars-paneles__placeholder\">\n                Imagen del panel {{ modelo }} no disponible.\n              </div>\n            {% endif %}\n          </a>\n\n          <p class=\"ars-paneles__category\">\n            Panel balístico\n          </p>\n\n          <div class=\"ars-paneles__model-row\">\n            <h3 class=\"ars-paneles__model\">\n              <a href=\"{{ destino }}\">\n                {{ modelo }}\n              </a>\n            </h3>\n\n            <a\n              class=\"ars-paneles__arrow\"\n              href=\"{{ destino }}\"\n              aria-label=\"Consultar el panel {{ modelo }}\"\n            >\n              <svg\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.6\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                aria-hidden=\"true\"\n              >\n                <path d=\"M6 18 18 6M6 6h12v12\"/>\n              </svg>\n            </a>\n          </div>\n\n          <p class=\"ars-paneles__description\">\n            {{ descripcion }}\n          </p>\n        </article>\n      {% endfor %}\n\n    </div>\n  </div>\n</section>",
