ars-compare__heading {\n      grid-template-columns: 1fr;\n      gap: 16px;\n      margin-bottom: 24px;\n    }\n\n    .ars-compare h2 {\n      font-size: 40px;\n      letter-spacing: -1px;\n    }\n\n    .ars-compare .ars-compare__intro {\n      font-size: 15px;\n    }\n\n    .ars-compare__toolbar {\n      gap: 10px;\n      margin-bottom: 16px;\n    }\n\n    .ars-compare__filters {\n      width: 100%;\n    }\n\n    .ars-compare__filters label {\n      flex: 1;\n      padding: 10px 8px;\n      font-size: 13px;\n    }\n\n    .ars-compare table,\n    .ars-compare tbody {\n      display: block;\n      width: 100%;\n    }\n\n    .ars-compare thead,\n    .ars-compare colgroup {\n      display: none;\n    }\n\n    .ars-compare tbody tr {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      margin-bottom: 16px;\n      border: 1px solid #d9ddde;\n      background: #fff;\n    }\n\n    .ars-compare tbody th,\n    .ars-compare tbody td {\n      display: block;\n      min-width: 0;\n      padding: 14px 10px;\n      border: 0;\n    }\n\n    .ars-compare tbody th:nth-child(1) {\n      grid-column: 1;\n      grid-row: 1;\n      background: #242b2d;\n    }\n\n    .ars-compare tbody th:nth-child(3) {\n      grid-column: 2;\n      grid-row: 1;\n      background: #dd5409;\n    }\n\n    .ars-compare tbody th:nth-child(1)::before,\n    .ars-compare tbody th:nth-child(3)::before {\n      display: block;\n      margin-bottom: 10px;\n      color: #fff;\n      font-size: 10px;\n      font-weight: 700;\n      line-height: 1.5;\n    }\n\n    .ars-compare tbody th:nth-child(1)::before {\n      content: \"ANTES · 0101.06\";\n    }\n\n    .ars-compare tbody th:nth-child(3)::before {\n      content: \"AHORA · 0101.07 + 0123.00\";\n    }\n\n    .ars-compare tbody th .ars-compare__level {\n      color: #fff;\n      font-size: 26px;\n    }\n\n    .ars-compare tbody td:nth-child(2) {\n      grid-column: 1;\n      grid-row: 2;\n      border-right: 1px solid #d9ddde;\n    }\n\n    .ars-compare tbody td:nth-child(4) {\n      grid-column: 2;\n      grid-row: 2;\n    }\n\n    .ars-compare tbody td:nth-child(5) {\n      grid-column: 1 / -1;\n      grid-row: 3;\n      border-top: 1px solid #d9ddde;\n      background: #f9faf8;\n      font-size: 13px;\n    }\n\n    .ars-compare tbody td:nth-child(5)::before {\n      content: \"QUÉ CAMBIÓ\";\n      display: block;\n      margin-bottom: 6px;\n      color: #c44805;\n      font-size: 10px;\n      font-weight: 700;\n      line-height: 1;\n      letter-spacing: 0.8px;\n    }\n\n    .ars-compare .ars-compare__ammo {\n      gap: 7px;\n      align-items: flex-start;\n    }\n\n    .ars-compare .ars-compare__ammo-name,\n    .ars-compare .ars-compare__empty {\n      font-size: 12px;\n    }\n\n    .ars-compare .ars-compare__speed {\n      font-size: 11px;\n    }\n\n    .ars-compare .ars-compare__cartridge {\n      flex-basis: 13px;\n      width: 13px;\n      height: 32px;\n    }\n\n    .ars-compare .ars-compare__note {\n      font-size: 11px;\n      margin-top: 16px;\n    }\n\n    .ars-compare summary {\n      font-size: 13px;\n    }\n\n    .ars-compare .ars-compare__technical p {\n      font-size: 12px;\n    }\n  }\n</style>\n\n{% capture ars_compare_rows %}\nIIA|—|9 mm FMJ RN^373^round;.40 S&W FMJ^352^flat|none|IIA no se incluye en la nueva clasificación.|handgun~\nII|HG1|9 mm FMJ RN^398^round;.357 Magnum JSP^436^flat|9 mm FMJ RN^398^round;.357 Magnum JSP^436^flat|Se conservan las amenazas y velocidades nominales.|handgun~\nIIIA|HG2|.357 SIG FMJ FN^448^sig;.44 Magnum SJHP^436^flat|9 mm FMJ RN^448^round^new;.44 Magnum JHP^436^flat|El 9 mm sustituye al .357 SIG. El .44 Magnum mantiene 240 gr; cambia la especificación de SJHP a JHP.|handgun~\nIII|RF1|7.62 × 51 mm M80^847^rifle|7.62 × 51 mm M80^847^rifle;7.62 × 39 mm MSC^732^rifle^new;5.56 mm M193^990^rifle^new|Se amplía de una a tres amenazas de rifle.|rifle~\n—|RF2|none|7.62 × 51 mm M80^847^rifle;7.62 × 39 mm MSC^732^rifle;5.56 mm M193^990^rifle;5.56 mm M855^950^green^new|Nuevo nivel intermedio: todas las amenazas RF1 más M855.|rifle~\nIV|RF3|.30-06 M2 AP^878^ap|.30-06 M2 AP^878^ap|Se mantiene M2 AP como amenaza de ensayo.|rifle\n{% endcapture %}\n\n<section class=\"ars-compare\" id=\"comparativa-nij\"\n  aria-labelledby=\"ars-compare-title-{{ section.id }}\">\n  <div class=\"ars-compare__inner\">\n\n    <p class=\"ars-compare__eyebrow\">02 / Comparativa</p>\n\n    <div class=\"ars-compare__heading\">\n      <h2 id=\"ars-compare-title-{{ section.id }}\">\n        El antes y el ahora,<br>frente a frente.\n      </h2>\n      <p class=\"ars-compare__intro\">\n        Cada norma tiene su propia columna de munición.\n        Así puedes identificar lo que se conserva,\n        se sustituye o se incorpora.\n      </p>\n    </div>\n\n    <input class=\"ars-compare__radio ars-compare__all\"\n      type=\"radio\"\n      name=\"ars-filter-{{ section.id }}\"\n      id=\"ars-all-{{ section.id }}\"\n      aria-label=\"Mostrar todos los niveles\"\n      checked>\n\n    <input class=\"ars-compare__radio ars-compare__handgun\"\n      type=\"radio\"\n      name=\"ars-filter-{{ section.id }}\"\n      id=\"ars-handgun-{{ section.id }}\"\n      aria-label=\"Mostrar niveles de arma corta\">\n\n    <input class=\"ars-compare__radio ars-compare__rifle\"\n      type=\"radio\"\n      name=\"ars-filter-{{ section.id }}\"\n      id=\"ars-rifle-{{ section.id }}\"\n      aria-label=\"Mostrar niveles de rifle\">\n\n    <div class=\"ars-compare__toolbar\">\n      <div class=\"ars-compare__filters\">\n        <label class=\"ars-compare__filter-all\"\n          for=\"ars-all-{{ section.id }}\">Todos</label>\n        <label class=\"ars-compare__filter-handgun\"\n          for=\"ars-handgun-{{ section.id }}\">Arma corta</label>\n        <label class=\"ars-compare__filter-rifle\"\n          for=\"ars-rifle-{{ section.id }}\">Rifle</label>\n      </div>\n      <p class=\"ars-compare__units\">\n        Velocidad de referencia en m/s\n      </p>\n    </div>\n\n    <div class=\"ars-compare__table-wrap\">\n      <table aria-label=\"Comparativa NIJ 0101.06 y NIJ 0101.07 con NIJ 0123.00\">\n        <colgroup>\n          <col style=\"width:12%\">\n          <col style=\"width:26%\">\n          <col style=\"width:12%\">\n          <col style=\"width:28%\">\n          <col style=\"width:22%\">\n        </colgroup>\n\n        <thead>\n          <tr>\n            <th colspan=\"2\" scope=\"colgroup\"\n              class=\"ars-compare__before\">\n              ANTES · NIJ 0101.06\n            </th>\n            <th colspan=\"2\" scope=\"colgroup\"\n              class=\"ars-compare__now\">\n              AHORA · 0101.07 + 0123.00\n            </th>\n            <th rowspan=\"2\" scope=\"col\"\n              class=\"ars-compare__changes\">\n              Qué cambió\n            </th>\n          </tr>\n          <tr>\n            <th scope=\"col\" class=\"ars-compare__subhead\">Nivel</th>\n            <th scope=\"col\" class=\"ars-compare__subhead\">\n              Munición de prueba · velocidad\n            </th>\n            <th scope=\"col\" class=\"ars-compare__subhead\">Nivel</th>\n            <th scope=\"col\" class=\"ars-compare__subhead\">\n              Munición de prueba · velocidad\n            </th>\n          </tr>\n        </thead>\n\n        <tbody>\n          {% assign ars_rows = ars_compare_rows | strip | split: '~' %}\n          {% for ars_row in ars_rows %}\n            {% assign ars_fields = ars_row | strip | split: '|' %}\n\n            <tr data-category=\"{{ ars_fields[5] | strip }}\">\n              {% for ars_side in (0..1) %}\n                {% assign ars_ammo_index = ars_side | plus: 2 %}\n\n                <th scope=\"row\">\n                  <span class=\"ars-compare__level\">\n                    {{ ars_fields[ars_side] | strip }}\n                  </span>\n                  {% if ars_side == 1 and ars_fields[1] == 'RF2' %}\n                    <span class=\"ars-compare__new-badge\">NUEVO</span>\n                  {% endif %}\n                </th>\n\n                <td {% if ars_side == 0 %}\n                  class=\"ars-compare__old-ammo\"\n                {% endif %}>\n\n                  {% if ars_fields[ars_ammo_index] == 'none' %}\n                    <p class=\"ars-compare__empty\">\n                      {% if ars_side == 0 %}\n                        Sin antecedente directo.\n                      {% else %}\n                        Sin nivel sucesor en la nueva clasificación.\n                      {% endif %}\n                    </p>\n                  {% else %}\n                    <div class=\"ars-compare__ammo-list\">\n                      {% assign ars_ammo_list = ars_fields[ars_ammo_index] | split: ';' %}\n\n                      {% for ars_ammo in ars_ammo_list %}\n                        {% assign ars_round = ars_ammo | split: '^' %}\n\n                        <div class=\"ars-compare__ammo{% if ars_round[3] == 'new' %} ars-compare__ammo--new{% endif %}\">\n\n                          <svg class=\"ars-compare__cartridge\"\n                            viewBox=\"0 0 20 48\"\n                            aria-hidden=\"true\" focusable=\"false\">\n\n                            {% case ars_round[2] %}\n                              {% when 'round' %}\n                                <path d=\"M6 18V11Q6 5 10 2Q14 5 14 11V18Z\"\n                                  fill=\"#b67c4b\" stroke=\"#87613f\" stroke-width=\".7\"/>\n                                <path d=\"M6 15H14V44H6Z\"\n                                  fill=\"#d6b65c\" stroke=\"#a78b40\" stroke-width=\".8\"/>\n                                <path d=\"M8 17V41\" stroke=\"#f4df91\"/>\n                                <path d=\"M4 44H16V47H4Z\" fill=\"#b99a45\"/>\n\n                              {% when 'flat' %}\n                                <path d=\"M6 11H14L15 18H5Z\"\n                                  fill=\"#b67c4b\" stroke=\"#87613f\" stroke-width=\".7\"/>\n                                <path d=\"M5 18H15V44H5Z\"\n                                  fill=\"#d6b65c\" stroke=\"#a78b40\" stroke-width=\".8\"/>\n                                <path d=\"M8 20V41\" stroke=\"#f4df91\"/>\n                                <path d=\"M3 44H17V47H3Z\" fill=\"#b99a45\"/>\n\n                              {% when 'sig' %}\n                                <path d=\"M8 9H12V17H8Z\"\n                                  fill=\"#b67c4b\" stroke=\"#87613f\" stroke-width=\".7\"/>\n                                <path d=\"M7 17H13V23L15 27V44H5V27L7 23Z\"\n                                  fill=\"#d6b65c\" stroke=\"#a78b40\" stroke-width=\".8\"/>\n                                <path d=\"M8 28V41\" stroke=\"#f4df91\"/>\n                                <path d=\"M3 44H17V47H3Z\" fill=\"#b99a45\"/>\n\n                              {% else %}\n                                <path d=\"M7 19V12L10 1L13 12V19Z\"\n                                  fill=\"#b67c4b\" stroke=\"#87613f\" stroke-width=\".7\"/>\n                                {% if ars_round[2] == 'green' %}\n                                  <path d=\"M8.1 8L10 1L11.9 8Z\" fill=\"#546a3c\"/>\n                                {% elsif ars_round[2] == 'ap' %}\n                                  <path d=\"M8.1 8L10 1L11.9 8Z\" fill=\"#262b2c\"/>\n                                {% endif %}\n                                <path d=\"M7 17H13V23L16 27V44H4V27L7 23Z\"\n                                  fill=\"#d6b65c\" stroke=\"#a78b40\" stroke-width=\".8\"/>\n                                <path d=\"M8 27V41\" stroke=\"#f4df91\"/>\n                                <path d=\"M2 44H18V47H2Z\" fill=\"#b99a45\"/>\n                            {% endcase %}\n                          </svg>\n\n                          <div>\n                            <span class=\"ars-compare__ammo-name\">\n                              {{ ars_round[0] }}\n                            </span>\n                            <span class=\"ars-compare__speed\">\n                              {{ ars_round[1] }} m/s\n                            </span>\n                          </div>\n                        </div>\n                      {% endfor %}\n                    </div>\n                  {% endif %}\n                </td>\n              {% endfor %}\n\n              <td class=\"ars-compare__change-copy\">\n                {{ ars_fields[4] }}\n              </td>\n            </tr>\n          {% endfor %}\n        </tbody>\n      </table>\n    </div>\n\n    <p class=\"ars-compare__note\">\n      Las correspondencias de nomenclatura no implican equivalencia\n      automática de certificación. En 0101.06 se muestran las\n      velocidades de blindaje nuevo para IIA, II y IIIA; se omiten\n      las velocidades reducidas de muestras acondicionadas.\n      Los iconos son ilustrativos y no están a escala.\n    </p>\n\n    <details>\n      <summary>Leer las precisiones técnicas y abreviaturas</summary>\n\n      <div class=\"ars-compare__technical\">\n        <p>\n          <strong>FMJ:</strong> proyectil encamisado.\n          <strong>RN:</strong> punta redonda.\n          <strong>FN:</strong> punta plana.\n          <strong>JSP:</strong> punta blanda encamisada.\n          <strong>SJHP:</strong> punta hueca semiencamisada.\n          <strong>JHP:</strong> punta hueca encamisada.\n          <strong>MSC:</strong> núcleo de acero dulce.\n          <strong>AP:</strong> perforante.\n          <strong>gr:</strong> grains, unidad de masa.\n        </p>\n\n        <p>\n          El .44 Magnum mantiene una masa de 240 gr.\n          Para M80 en RF1/RF2, la adenda 1 de NIJ 0123.00\n          especifica 149 +0/−3 gr; para M193, 56 +0/−2 gr;\n          para M855, 61.8 ±1.5 gr.\n          Las velocidades son referencias de ensayo,\n          no velocidades máximas de protección.\n        </p>\n\n        <p>\n          El número y distribución de impactos dependen del ensayo\n          y de la configuración. Esta tabla no representa por sí\n          sola el protocolo completo de certificación ni una\n          garantía frente a cualquier munición del mismo calibre.\n        </p>\n\n        <p>\n          Fuentes oficiales:\n          <a href=\"https://www.ojp.gov/pdffiles1/nij/223054.pdf\"\n            target=\"_blank\" rel=\"noopener noreferrer\">NIJ 0101.06 ↗</a>\n          ·\n          <a href=\"https://nij.ojp.gov/topics/equipment-and-technology/specification-nij-ballistic-protection-levels-and-associated-test-threats-nij-standard-012300\"\n            target=\"_blank\" rel=\"noopener noreferrer\">NIJ 0123.00 y adendas ↗</a>\n        </p>\n      </div>\n    </details>\n\n  </div>\n</section>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    },
    "section_custom_liquid_JGjbRH": {
      "type": "section-custom-liquid",
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  #pruebas-evaluacion {\n    background: #141a1b;\n    color: #fff;\n    padding: 40px 24px;\n    font-family: var(--font-body-family, inherit);\n    font-style: var(--font-body-style, normal);\n    font-weight: var(--font-body-weight, 400);\n    line-height: 1.5;\n    scroll-margin-top: 100px;\n  }\n\n  #pruebas-evaluacion,\n  #pruebas-evaluacion * {\n    box-sizing: border-box;\n  }\n\n  #pruebas-evaluacion h2,\n  #pruebas-evaluacion h3,\n  #pruebas-evaluacion p,\n  #pruebas-evaluacion h2 *,\n  #pruebas-evaluacion h3 *,\n  #pruebas-evaluacion p * {\n    -webkit-hyphens: none !important;\n    hyphens: none !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n  }\n\n  #pruebas-evaluacion .ars-tests__word {\n    display: inline-block;\n    white-space: nowrap !important;\n  }\n\n  #pruebas-evaluacion .ars-tests__inner {\n    max-width: 1250px;\n    margin: 0 auto;\n  }\n\n  #pruebas-evaluacion .ars-tests__label {\n    margin: 0 0 20px;\n    color: #dd5409;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n  }\n\n  #pruebas-evaluacion .ars-tests__heading {\n    display: grid;\n    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);\n    align-items: end;\n    gap: 40px;\n    margin-bottom: 36px;\n  }\n\n  #pruebas-evaluacion .ars-tests__heading > * {\n    min-width: 0;\n  }\n\n  #pruebas-evaluacion h2,\n  #pruebas-evaluacion h3 {\n    font-family: var(--font-heading-family, inherit);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 700);\n    color: #fff;\n    line-height: 1;\n    text-transform: none;\n  }\n\n  #pruebas-evaluacion h2 {\n    margin: 0;\n    font-size: 64px;\n    letter-spacing: -1.5px;\n  }\n\n  #pruebas-evaluacion .ars-tests__intro {\n    max-width: 430px;\n    margin: 0;\n    color: #aeb7b8;\n    font-size: 17px;\n    line-height: 1.5;\n  }\n\n  #pruebas-evaluacion .ars-tests__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 0;\n  }\n\n  #pruebas-evaluacion .ars-tests__card {\n    min-width: 0;\n    padding: 0 20px;\n  }\n\n  #pruebas-evaluacion .ars-tests__card + .ars-tests__card {\n    border-left: 1px solid #394345;\n  }\n\n  #pruebas-evaluacion .ars-tests__visual {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    height: 220px;\n    margin-bottom: 24px;\n    background: linear-gradient(135deg, #252d2f, #1b2223);\n    border-radius: 3px;\n    overflow: hidden;\n  }\n\n  #pruebas-evaluacion .ars-tests__diagram {\n    display: block;\n    width: 100%;\n    max-width: 320px;\n    height: 100%;\n  }\n\n  #pruebas-evaluacion .ars-tests__outline {\n    fill: none;\n    stroke: #939fa1;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  #pruebas-evaluacion .ars-tests__fine {\n    fill: none;\n    stroke: #626e71;\n    stroke-width: 1;\n    stroke-linecap: round;\n  }\n\n  #pruebas-evaluacion .ars-tests__accent {\n    fill: none;\n    stroke: #dd5409;\n    stroke-width: 2.2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  #pruebas-evaluacion .ars-tests__dot {\n    fill: #a4afb0;\n    stroke: none;\n  }\n\n  #pruebas-evaluacion .ars-tests__svg-text {\n    fill: #dd5409;\n    stroke: none;\n    font-family: var(--font-body-family, inherit);\n    font-weight: 400;\n    font-size: 15px;\n  }\n\n  #pruebas-evaluacion .ars-tests__svg-angle {\n    font-size: 24px;\n  }\n\n  #pruebas-evaluacion .ars-tests__category {\n    margin: 0 0 14px;\n    color: #dd5409;\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 1.7px;\n    text-transform: uppercase;\n  }\n\n  #pruebas-evaluacion h3 {\n    margin: 0 0 16px;\n    font-size: 28px;\n    letter-spacing: -0.6px;\n  }\n\n  #pruebas-evaluacion .ars-tests__copy {\n    margin: 0;\n    color: #aeb7b8;\n    font-size: 15px;\n    line-height: 1.5;\n  }\n\n  #pruebas-evaluacion .ars-tests__note {\n    margin: 28px 0 0;\n    padding-top: 18px;\n    border-top: 1px solid #394345;\n    color: #96a2a4;\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    #pruebas-evaluacion .ars-tests__heading {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 20px;\n    }\n\n    #pruebas-evaluacion h2 {\n      font-size: 56px;\n    }\n\n    #pruebas-evaluacion .ars-tests__card {\n      padding: 0 12px;\n    }\n\n    #pruebas-evaluacion .ars-tests__visual {\n      height: 180px;\n    }\n\n    #pruebas-evaluacion h3 {\n      font-size: 24px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #pruebas-evaluacion {\n      padding: 28px 20px;\n    }\n\n    #pruebas-evaluacion .ars-tests__label {\n      margin-bottom: 16px;\n      font-size: 11px;\n      letter-spacing: 1px;\n    }\n\n    #pruebas-evaluacion .ars-tests__heading {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 16px;\n      margin-bottom: 24px;\n    }\n\n    #pruebas-evaluacion h2 {\n      font-size: 40px;\n      letter-spacing: -1px;\n    }\n\n    #pruebas-evaluacion .ars-tests__intro {\n      font-size: 15px;\n    }\n\n    #pruebas-evaluacion .ars-tests__grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 24px;\n    }\n\n    #pruebas-evaluacion .ars-tests__card {\n      padding: 0;\n    }\n\n    #pruebas-evaluacion .ars-tests__card + .ars-tests__card {\n      padding-top: 24px;\n      border-left: none;\n      border-top: 1px solid #394345;\n    }\n\n    #pruebas-evaluacion .ars-tests__visual {\n      height: 190px;\n      margin-bottom: 18px;\n    }\n\n    #pruebas-evaluacion .ars-tests__category {\n      margin-bottom: 12px;\n    }\n\n    #pruebas-evaluacion h3 {\n      font-size: 26px;\n      margin-bottom: 12px;\n    }\n\n    #pruebas-evaluacion .ars-tests__copy {\n      font-size: 15px;\n    }\n\n    #pruebas-evaluacion .ars-tests__note {\n      margin-top: 24px;\n      font-size: 10px;\n    }\n  }\n</style>\n\n<section\n  class=\"ars-tests\"\n  id=\"pruebas-evaluacion\"\n  aria-labelledby=\"ars-tests-title\"\n>\n  <div class=\"ars-tests__inner\">\n\n    <p class=\"ars-tests__label\">\n      03 / Pruebas y evaluación\n    </p>\n\n    <div class=\"ars-tests__heading\">\n      <h2 id=\"ars-tests-title\">\n        <span class=\"ars-tests__word\">También</span>\n        <span class=\"ars-tests__word\">cambia</span><br>\n        <span class=\"ars-tests__word\">la</span>\n        <span class=\"ars-tests__word\">forma</span>\n        <span class=\"ars-tests__word\">de</span>\n        <span class=\"ars-tests__word\">evaluar.</span>\n      </h2>\n\n      <p class=\"ars-tests__intro\">\n        La actualización explora zonas y geometrías relevantes\n        del blindaje e incorpora métodos de ensayo ASTM.\n      </p>\n    </div>\n\n    <div class=\"ars-tests__grid\">\n\n      <article class=\"ars-tests__card\">\n        <div class=\"ars-tests__visual\">\n          <svg\n            class=\"ars-tests__diagram\"\n            viewBox=\"0 0 360 220\"\n            preserveAspectRatio=\"xMidYMid meet\"\n            role=\"img\"\n            aria-label=\"Panel flexible con seis puntos y un séptimo impacto cerca del borde superior, con trayectoria punteada ascendente.\"\n          >\n            <path\n              class=\"ars-tests__outline\"\n              d=\"M131 28 Q180 61 229 28\n                 L251 73 L278 94 L266 197\n                 H94 L82 94 L109 73 Z\"\n            />\n\n            <circle class=\"ars-tests__dot\" cx=\"137\" cy=\"96\" r=\"4.5\"/>\n            <circle class=\"ars-tests__dot\" cx=\"217\" cy=\"102\" r=\"4.5\"/>\n            <circle class=\"ars-tests__dot\" cx=\"176\" cy=\"133\" r=\"4.5\"/>\n            <circle class=\"ars-tests__dot\" cx=\"127\" cy=\"165\" r=\"4.5\"/>\n            <circle class=\"ars-tests__dot\" cx=\"224\" cy=\"167\" r=\"4.5\"/>\n            <circle class=\"ars-tests__dot\" cx=\"190\" cy=\"181\" r=\"4.5\"/>\n\n            <circle class=\"ars-tests__accent\" cx=\"180\" cy=\"53\" r=\"10\"/>\n\n            <path\n              class=\"ars-tests__accent\"\n              d=\"M91 138 L180 53\"\n              stroke-dasharray=\"5 6\"\n            />\n\n            <path\n              class=\"ars-tests__accent\"\n              d=\"M169 56 L180 53 L176 65\"\n            />\n\n            <text\n              class=\"ars-tests__svg-text ars-tests__svg-angle\"\n              x=\"77\"\n              y=\"102\"\n            >45°</text>\n          </svg>\n        </div>\n\n        <p class=\"ars-tests__category\">Paneles flexibles</p>\n\n        <h3>Un séptimo impacto</h3>\n\n        <p class=\"ars-tests__copy\">\n          Se incorpora un disparo a 45° cerca del centro\n          del borde superior en la evaluación P-BFD,\n          en paneles planos y no planos.\n        </p>\n      </article>\n\n      <article class=\"ars-tests__card\">\n        <div class=\"ars-tests__visual\">\n          <svg\n            class=\"ars-tests__diagram\"\n            viewBox=\"0 0 360 220\"\n            preserveAspectRatio=\"xMidYMid meet\"\n            role=\"img\"\n            aria-label=\"Esquema conceptual de placa curva con la corona señalada en naranja.\"\n          >\n            <path\n              class=\"ars-tests__outline\"\n              d=\"M89 194\n                 Q97 83 180 34\n                 Q263 83 271 194 Z\"\n            />\n\n            <path\n              class=\"ars-tests__fine\"\n              d=\"M117 187 Q145 89 180 34\n                 M243 187 Q215 89 180 34\"\n            />\n\n            <circle\n              class=\"ars-tests__accent\"\n              cx=\"180\"\n              cy=\"34\"\n              r=\"10\"\n            />\n\n            <path\n              class=\"ars-tests__accent\"\n              d=\"M195 33 H264\"\n            />\n\n            <text\n              class=\"ars-tests__svg-text\"\n              x=\"235\"\n              y=\"20\"\n            >CORONA</text>\n          </svg>\n        </div>\n\n        <p class=\"ars-tests__category\">Placas multicurvas</p>\n\n        <h3>Evaluar la corona</h3>\n\n        <p class=\"ars-tests__copy\">\n          La distribución de impactos incluye la corona,\n          un punto alto de la superficie de impacto\n          definido por la geometría de la placa.\n        </p>\n      </article>\n\n      <article class=\"ars-tests__card\">\n        <div class=\"ars-tests__visual\">\n          <svg\n            class=\"ars-tests__diagram\"\n            viewBox=\"0 0 360 220\"\n            preserveAspectRatio=\"xMidYMid meet\"\n            role=\"img\"\n            aria-label=\"Figura femenina con panel de protección delineado en naranja.\"\n          >\n            <circle\n              class=\"ars-tests__outline\"\n              cx=\"180\"\n              cy=\"26\"\n              r=\"16\"\n            />\n\n            <path\n              class=\"ars-tests__outline\"\n              d=\"M168 47 V55 L143 65\n                 Q126 72 121 91\n                 L108 132 L122 138\n                 L137 105 L148 151\n                 L132 201 H228\n                 L212 151 L223 105\n                 L238 138 L252 132\n                 L239 91 Q234 72 217 65\n                 L192 55 V47\"\n            />\n\n            <path\n              class=\"ars-tests__accent\"\n              d=\"M154 78\n                 Q180 95 206 78\n                 L218 105 L205 151\n                 L215 178 H145\n                 L155 151 L142 105 Z\"\n            />\n\n            <path\n              class=\"ars-tests__outline\"\n              d=\"M153 110 Q166 99 178 113\n                 M183 113 Q195 99 207 110\n                 M155 140 Q180 150 205 140\"\n            />\n\n            <path\n              class=\"ars-tests__fine\"\n              d=\"M180 122 V141\"\n            />\n          </svg>\n        </div>\n\n        <p class=\"ars-tests__category\">Diseños femeninos</p>\n\n        <h3>La forma también cuenta</h3>\n\n        <p class=\"ars-tests__copy\">\n          Se mejora el soporte de los paneles no planos\n          sobre el respaldo de ensayo y la evaluación\n          de sus características de conformación.\n        </p>\n      </article>\n\n    </div>\n\n    <p class=\"ars-tests__note\">\n      Esquemas conceptuales para explicar los cambios;\n      no reproducen el montaje completo de un ensayo.\n      P-BFD: evaluación de perforación y deformación posterior.\n    </p>\n\n  </div>\n</section>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    },
    "section_custom_liquid_9XkjJi": {
      "type": "section-custom-liquid",
