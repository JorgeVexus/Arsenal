        "custom_liquid": "{% liquid\n  assign asesoria_form_id = 'ArsenalAsesoria-' | append: section.id\n  assign asesoria_return = request.path | append: '?view=nij-0101-07&contact_posted=true'\n\n  if theme.role != 'main'\n    assign asesoria_return = asesoria_return | append: '&preview_theme_id=' | append: theme.id\n  endif\n\n  assign asesoria_return = asesoria_return | append: '#' | append: asesoria_form_id\n%}\n\n<style>\n  #ars-asesoria-{{ section.id }} {\n    background: #DD5409;\n    box-shadow: 0 0 0 100vmax #DD5409;\n    clip-path: inset(0 -100vmax);\n    color: #ffffff;\n    padding: 40px 24px;\n    scroll-margin-top: 100px;\n\n    font-family: var(--font-body-family, inherit);\n    font-style: var(--font-body-style, normal);\n    font-weight: var(--font-body-weight, 400);\n  }\n\n  #ars-asesoria-{{ section.id }},\n  #ars-asesoria-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #ars-asesoria-{{ section.id }} h2,\n  #ars-asesoria-{{ section.id }} h2 *,\n  #ars-asesoria-{{ section.id }} p,\n  #ars-asesoria-{{ section.id }} label,\n  #ars-asesoria-{{ section.id }} a {\n    -webkit-hyphens: none !important;\n    hyphens: none !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__inner {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    align-items: start;\n    gap: 56px;\n    max-width: 1250px;\n    margin: 0 auto;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__content {\n    min-width: 0;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__label {\n    margin: 0 0 24px;\n    color: #ffffff;\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 1.7px;\n    text-transform: uppercase;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__title {\n    margin: 0 0 28px;\n    color: #ffffff;\n\n    font-family: var(--font-heading-family, inherit);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 700);\n\n    font-size: 64px;\n    line-height: 1;\n    letter-spacing: -1.5px;\n    text-transform: none;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__word {\n    display: inline-block;\n    white-space: nowrap !important;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__intro {\n    max-width: 470px;\n    margin: 0 0 24px;\n    color: #ffffff;\n    font-size: 17px;\n    line-height: 1.5;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__email {\n    display: inline-block;\n    max-width: 100%;\n    padding-bottom: 4px;\n    border-bottom: 1px solid currentColor;\n    color: #ffffff;\n    font-size: 15px;\n    line-height: 1.5;\n    text-decoration: none;\n    overflow-wrap: anywhere !important;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__note {\n    margin: 22px 0 0;\n    color: #ffffff;\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__box {\n    min-width: 0;\n    padding: 30px;\n    border-radius: 5px;\n    background: #ffffff;\n    color: #1d2426;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__form {\n    margin: 0;\n    scroll-margin-top: 100px;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__fields {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 20px 16px;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__field {\n    position: relative;\n    min-width: 0;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__field--full {\n    grid-column: 1 / -1;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__field-label {\n    display: block;\n    margin: 0 0 9px;\n    color: #1d2426;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.3;\n    letter-spacing: normal;\n    text-transform: none;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__input {\n    display: block;\n    width: 100%;\n    min-width: 0;\n    min-height: 48px;\n    padding: 12px;\n    margin: 0;\n\n    border: 1px solid #cbd2d0;\n    border-radius: 2px;\n    background: #f8faf8;\n    color: #1d2426;\n    box-shadow: none;\n\n    font-family: var(--font-body-family, inherit);\n    font-style: var(--font-body-style, normal);\n    font-weight: var(--font-body-weight, 400);\n    font-size: 16px;\n    line-height: 1.5;\n    letter-spacing: normal;\n  }\n\n  #ars-asesoria-{{ section.id }} select.ars-asesoria__input {\n    appearance: auto;\n  }\n\n  #ars-asesoria-{{ section.id }} textarea.ars-asesoria__input {\n    min-height: 120px;\n    resize: vertical;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__input::placeholder {\n    color: #737d7a;\n    opacity: 1;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__input:focus {\n    outline: 2px solid #DD5409;\n    outline-offset: 2px;\n    border-color: #DD5409;\n  }\n\n  /*\n    El tema genera su propio selector.\n    Conservamos el campo original para enviar su valor.\n  */\n  #ars-asesoria-{{ section.id }} select.ars-asesoria__input {\n    position: absolute !important;\n    width: 1px !important;\n    min-width: 0 !important;\n    height: 1px !important;\n    min-height: 0 !important;\n    padding: 0 !important;\n    opacity: 0 !important;\n    pointer-events: none;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__privacy {\n    margin: 20px 0 16px;\n    color: #626c70;\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__privacy a {\n    color: #1d2426;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__submit {\n    display: flex !important;\n    flex-flow: row nowrap !important;\n    align-items: center !important;\n    justify-content: space-between;\n    gap: 10px !important;\n\n    width: 100%;\n    max-width: 100%;\n    height: auto !important;\n    min-height: 54px;\n    padding: 16px 20px;\n    margin: 0;\n\n    border: 0;\n    border-radius: 3px;\n    background: #DD5409;\n    color: #ffffff;\n    box-shadow: none;\n\n    font-family: var(--font-body-family, inherit);\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1.3;\n    letter-spacing: normal;\n    text-align: left;\n    text-transform: none;\n    white-space: normal;\n    cursor: pointer;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__submit > span:first-child {\n    flex: 1;\n    min-width: 0;\n    white-space: normal;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__submit:hover {\n    background: #bd4506;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__submit::before,\n  #ars-asesoria-{{ section.id }} .ars-asesoria__submit::after {\n    content: none;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__arrow {\n    display: block;\n    flex: 0 0 20px !important;\n    width: 20px;\n    margin: 0 !important;\n    font-size: 25px;\n    line-height: 1;\n    text-align: right;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__status {\n    padding: 14px;\n    margin: 0 0 20px;\n    font-size: 14px;\n    line-height: 1.5;\n    border-radius: 3px;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__status--success {\n    background: #edf5ee;\n    color: #24512d;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__status--error {\n    background: #fff0ed;\n    color: #8d271b;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__status p {\n    margin: 0;\n    color: inherit;\n  }\n\n  #ars-asesoria-{{ section.id }} .ars-asesoria__status ul {\n    padding-left: 20px;\n    margin: 8px 0 0;\n  }\n\n  #ars-asesoria-{{ section.id }} a:focus-visible,\n  #ars-asesoria-{{ section.id }} button:focus-visible {\n    outline: 2px solid #1d2426;\n    outline-offset: 4px;\n  }\n\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    #ars-asesoria-{{ section.id }} .ars-asesoria__inner {\n      gap: 28px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__title {\n      font-size: 56px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__box {\n      padding: 24px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__fields {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #ars-asesoria-{{ section.id }} {\n      padding: 28px 20px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__inner {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 26px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__label {\n      margin-bottom: 18px;\n      font-size: 10px;\n      letter-spacing: 1.3px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__title {\n      margin-bottom: 20px;\n      font-size: 40px;\n      line-height: 1;\n      letter-spacing: -1px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__intro {\n      margin-bottom: 18px;\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__email {\n      font-size: 14px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__note {\n      margin-top: 18px;\n      font-size: 10px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__box {\n      padding: 22px 16px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__fields {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 18px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__privacy {\n      font-size: 10px;\n    }\n\n    #ars-asesoria-{{ section.id }} .ars-asesoria__submit {\n      padding: 14px !important;\n    }\n  }\n</style>\n\n<section\n  id=\"ars-asesoria-{{ section.id }}\"\n  aria-labelledby=\"ars-asesoria-title-{{ section.id }}\"\n>\n  <div class=\"ars-asesoria__inner\">\n\n    <div class=\"ars-asesoria__content\">\n      <p class=\"ars-asesoria__label\">\n        Asesoría para instituciones\n      </p>\n\n      <h2\n        class=\"ars-asesoria__title\"\n        id=\"ars-asesoria-title-{{ section.id }}\"\n      >\n        <span class=\"ars-asesoria__word\">Define</span>\n        <span class=\"ars-asesoria__word\">la</span>\n        <span class=\"ars-asesoria__word\">protección</span>\n        <span class=\"ars-asesoria__word\">que</span>\n        <span class=\"ars-asesoria__word\">necesita</span>\n        <span class=\"ars-asesoria__word\">tu</span>\n        <span class=\"ars-asesoria__word\">institución.</span>\n      </h2>\n\n      <p class=\"ars-asesoria__intro\">\n        Cuéntanos qué equipamiento buscas. Te ayudamos\n        a revisar niveles, configuraciones y documentación.\n      </p>\n\n      <a\n        class=\"ars-asesoria__email\"\n        href=\"mailto:cotizaciones@arsenalprotect.com\"\n      >\n        cotizaciones@arsenalprotect.com\n        <span aria-hidden=\"true\">↗</span>\n      </a>\n\n      <p class=\"ars-asesoria__note\">\n        Atención a instituciones públicas y privadas.\n      </p>\n    </div>\n\n    <div class=\"ars-asesoria__box\">\n\n      {% form 'contact',\n        id: asesoria_form_id,\n        class: 'ars-asesoria__form',\n        return_to: asesoria_return\n      %}\n\n        {% if form.posted_successfully? %}\n          <p\n            class=\"ars-asesoria__status ars-asesoria__status--success\"\n            role=\"status\"\n          >\n            Tu solicitud se ha enviado correctamente.\n            Gracias por contactar a Arsenal Protection Mexico.\n          </p>\n        {% endif %}\n\n        {% if form.errors %}\n          <div\n            class=\"ars-asesoria__status ars-asesoria__status--error\"\n            role=\"alert\"\n          >\n            <p>Revisa los siguientes datos:</p>\n            {{ form.errors | default_errors }}\n          </div>\n        {% endif %}\n\n        <input\n          type=\"hidden\"\n          name=\"contact[Origen]\"\n          value=\"Landing NIJ 0101.07 — Asesoría institucional\"\n        >\n\n        <div class=\"ars-asesoria__fields\">\n\n          <div class=\"ars-asesoria__field\">\n            <label\n              class=\"ars-asesoria__field-label\"\n              for=\"ars-nombre-{{ section.id }}\"\n            >\n              Nombre completo *\n            </label>\n\n            <input\n              class=\"ars-asesoria__input\"\n              type=\"text\"\n              id=\"ars-nombre-{{ section.id }}\"\n              name=\"contact[name]\"\n              autocomplete=\"name\"\n              value=\"{{ form.name | escape }}\"\n              required\n            >\n          </div>\n\n          <div class=\"ars-asesoria__field\">\n            <label\n              class=\"ars-asesoria__field-label\"\n              for=\"ars-empresa-{{ section.id }}\"\n            >\n              Empresa o dependencia *\n            </label>\n\n            <input\n              class=\"ars-asesoria__input\"\n              type=\"text\"\n              id=\"ars-empresa-{{ section.id }}\"\n              name=\"contact[Empresa o dependencia]\"\n              autocomplete=\"organization\"\n              value=\"{{ form['Empresa o dependencia'] | escape }}\"\n              required\n            >\n          </div>\n\n          <div class=\"ars-asesoria__field\">\n            <label\n              class=\"ars-asesoria__field-label\"\n              for=\"ars-correo-{{ section.id }}\"\n            >\n              Correo electrónico *\n            </label>\n\n            <input\n              class=\"ars-asesoria__input\"\n              type=\"email\"\n              id=\"ars-correo-{{ section.id }}\"\n              name=\"contact[email]\"\n              autocomplete=\"email\"\n              autocapitalize=\"off\"\n              spellcheck=\"false\"\n              value=\"{{ form.email | escape }}\"\n              {% if form.errors contains 'email' %}\n                aria-invalid=\"true\"\n              {% endif %}\n              required\n            >\n          </div>\n\n          <div class=\"ars-asesoria__field\">\n            <label\n              class=\"ars-asesoria__field-label\"\n              for=\"ars-telefono-{{ section.id }}\"\n            >\n              Teléfono *\n            </label>\n\n            <input\n              class=\"ars-asesoria__input\"\n              type=\"tel\"\n              id=\"ars-telefono-{{ section.id }}\"\n              name=\"contact[phone]\"\n              autocomplete=\"tel\"\n              value=\"{{ form.phone | escape }}\"\n              required\n            >\n          </div>\n\n          <div class=\"ars-asesoria__field ars-asesoria__field--full\">\n            <label\n              class=\"ars-asesoria__field-label\"\n              for=\"ars-producto-{{ section.id }}\"\n            >\n              Producto de interés *\n            </label>\n\n            <select\n              class=\"ars-asesoria__input\"\n              id=\"ars-producto-{{ section.id }}\"\n              name=\"contact[Producto de interés]\"\n              required\n            >\n              <option\n                value=\"\"\n                disabled\n                {% if form['Producto de interés'] == blank %}\n                  selected\n                {% endif %}\n              >\n                Selecciona una opción\n              </option>\n\n              {% assign opciones_producto = 'Panel balístico GR507|Panel balístico GR407|Panel balístico femenino|Chalecos y configuraciones|Otro equipamiento|Asesoría sobre NIJ 0101.07' | split: '|' %}\n\n              {% for opcion in opciones_producto %}\n                <option\n                  value=\"{{ opcion | escape }}\"\n                  {% if form['Producto de interés'] == opcion %}\n                    selected\n                  {% endif %}\n                >\n                  {{ opcion }}\n                </option>\n              {% endfor %}\n            </select>\n          </div>\n\n          <div class=\"ars-asesoria__field ars-asesoria__field--full\">\n            <label\n              class=\"ars-asesoria__field-label\"\n              for=\"ars-mensaje-{{ section.id }}\"\n            >\n              ¿Qué necesita tu institución? *\n            </label>\n\n            <textarea\n              class=\"ars-asesoria__input\"\n              id=\"ars-mensaje-{{ section.id }}\"\n              name=\"contact[body]\"\n              rows=\"4\"\n              placeholder=\"Cantidad estimada, configuración o documentación que necesitas\"\n              required\n            >{{ form.body | escape }}</textarea>\n          </div>\n\n        </div>\n\n        <p class=\"ars-asesoria__privacy\">\n          Los campos marcados con * son obligatorios.\n          Utilizaremos tus datos para atender tu solicitud.\n          {% if shop.privacy_policy.url != blank %}\n            <a href=\"{{ shop.privacy_policy.url }}\">\n              Consulta nuestro aviso de privacidad.\n            </a>\n          {% endif %}\n        </p>\n\n        <button\n          class=\"ars-asesoria__submit\"\n          type=\"submit\"\n        >\n          <span>Enviar solicitud de asesoría</span>\n          <span class=\"ars-asesoria__arrow\" aria-hidden=\"true\">↗</span>\n        </button>\n\n      {% endform %}\n\n    </div>\n  </div>\n</section>",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
