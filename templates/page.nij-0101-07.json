      "settings": {
        "custom_liquid": "<style>\n  #ars-faq-{{ section.id }} {\n    padding: 40px 24px;\n    background: #ffffff;\n    color: #1d2426;\n    font-family: var(--font-body-family, inherit);\n    font-style: var(--font-body-style, normal);\n    font-weight: var(--font-body-weight, 400);\n  }\n\n  #ars-faq-{{ section.id }},\n  #ars-faq-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #ars-faq-{{ section.id }} h2,\n  #ars-faq-{{ section.id }} p,\n  #ars-faq-{{ section.id }} a,\n  #ars-faq-{{ section.id }} summary,\n  #ars-faq-{{ section.id }} summary *,\n  #ars-faq-{{ section.id }} h2 * {\n    -webkit-hyphens: none !important;\n    hyphens: none !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__container {\n    max-width: 1250px;\n    margin: 0 auto;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__inner {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);\n    align-items: start;\n    gap: 64px;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__header {\n    min-width: 0;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__label {\n    margin: 0 0 24px;\n    color: #DD5409;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 1.7px;\n    text-transform: uppercase;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__title {\n    margin: 0;\n    color: #1d2426;\n    font-family: var(--font-heading-family, inherit);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 700);\n    font-size: 64px;\n    line-height: 1;\n    letter-spacing: -1.5px;\n    text-transform: none;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__word {\n    display: inline-block;\n    white-space: nowrap !important;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__list {\n    min-width: 0;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__item {\n    display: block;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    border-bottom: 1px solid #d9ddde;\n    border-radius: 0;\n    background: transparent;\n    box-shadow: none;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__question {\n    position: relative;\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 24px 0;\n    margin: 0;\n    color: #1d2426;\n    background: transparent;\n    font-family: var(--font-body-family, inherit);\n    font-size: 17px;\n    font-weight: 700;\n    line-height: 1.35;\n    letter-spacing: normal;\n    text-transform: none;\n    cursor: pointer;\n    list-style: none;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__question::-webkit-details-marker {\n    display: none;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__question::marker {\n    content: \"\";\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__question::before,\n  #ars-faq-{{ section.id }} .ars-faq__question::after {\n    content: none;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__question-text {\n    display: block;\n    min-width: 0;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__icon {\n    position: relative;\n    display: block;\n    flex: 0 0 18px;\n    width: 18px;\n    height: 18px;\n    margin-top: 2px;\n    color: #DD5409;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__icon::before,\n  #ars-faq-{{ section.id }} .ars-faq__icon::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    display: block;\n    background: currentColor;\n    transform: translate(-50%, -50%);\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__icon::before {\n    width: 14px;\n    height: 3px;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__icon::after {\n    width: 3px;\n    height: 14px;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__item[open] .ars-faq__icon {\n    transform: rotate(45deg);\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__answer {\n    padding: 0 30px 26px 0;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__answer p {\n    margin: 0;\n    color: #626c70;\n    font-size: 15px;\n    line-height: 1.5;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__question:focus-visible {\n    outline: 2px solid #DD5409;\n    outline-offset: 3px;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__sources {\n    margin-top: 48px;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__sources-label {\n    margin: 0 0 24px;\n    color: #626c70;\n    font-size: 10px;\n    font-weight: 700;\n    line-height: 1.5;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__sources-links {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: flex-start;\n    gap: 16px 28px;\n    padding: 0;\n    margin: 0 0 24px;\n    list-style: none;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__sources-links li {\n    padding: 0;\n    margin: 0;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__source-link {\n    display: inline-block;\n    padding-bottom: 4px;\n    border-bottom: 1px solid currentColor;\n    color: #1d2426;\n    font-size: 12px;\n    line-height: 1.5;\n    text-decoration: none;\n    white-space: nowrap;\n    transition: color 180ms ease;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__source-link:hover {\n    color: #DD5409;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__source-link:focus-visible {\n    outline: 2px solid #DD5409;\n    outline-offset: 5px;\n  }\n\n  #ars-faq-{{ section.id }} .ars-faq__sources-note {\n    margin: 0;\n    color: #626c70;\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    #ars-faq-{{ section.id }} .ars-faq__inner {\n      gap: 32px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__title {\n      font-size: 56px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__question {\n      font-size: 16px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #ars-faq-{{ section.id }} {\n      padding: 28px 20px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__inner {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 24px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__label {\n      margin-bottom: 18px;\n      font-size: 10px;\n      letter-spacing: 1.3px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__title {\n      font-size: 40px;\n      line-height: 1;\n      letter-spacing: -1px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__question {\n      gap: 14px;\n      padding: 20px 0;\n      font-size: 16px;\n      line-height: 1.35;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__answer {\n      padding: 0 0 22px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__answer p {\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__sources {\n      margin-top: 32px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__sources-label {\n      margin-bottom: 20px;\n      font-size: 9px;\n      letter-spacing: 1.3px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__sources-links {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 16px 12px;\n      margin-bottom: 20px;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__source-link {\n      max-width: 100%;\n      font-size: 11px;\n      white-space: normal;\n    }\n\n    #ars-faq-{{ section.id }} .ars-faq__sources-note {\n      font-size: 10px;\n      line-height: 1.5;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #ars-faq-{{ section.id }} .ars-faq__source-link {\n      transition: none;\n    }\n  }\n</style>\n\n<section\n  id=\"ars-faq-{{ section.id }}\"\n  aria-labelledby=\"ars-faq-title-{{ section.id }}\"\n>\n  <div class=\"ars-faq__container\">\n\n    <div class=\"ars-faq__inner\">\n\n      <div class=\"ars-faq__header\">\n        <p class=\"ars-faq__label\">\n          06 / Preguntas frecuentes\n        </p>\n\n        <h2\n          class=\"ars-faq__title\"\n          id=\"ars-faq-title-{{ section.id }}\"\n        >\n          <span class=\"ars-faq__word\">Respuestas</span><br>\n          <span class=\"ars-faq__word\">para</span>\n          <span class=\"ars-faq__word\">decidir</span><br>\n          <span class=\"ars-faq__word\">con</span>\n          <span class=\"ars-faq__word\">claridad.</span>\n        </h2>\n      </div>\n\n      <div class=\"ars-faq__list\">\n\n        <details class=\"ars-faq__item\" open>\n          <summary class=\"ars-faq__question\">\n            <span class=\"ars-faq__question-text\">\n              ¿Mi equipo NIJ 0101.06 queda obsoleto?\n            </span>\n            <span class=\"ars-faq__icon\" aria-hidden=\"true\"></span>\n          </summary>\n\n          <div class=\"ars-faq__answer\">\n            <p>\n              No automáticamente. NIJ prevé mantener la lista\n              0101.06 al menos hasta finales de 2029. Esa fecha\n              no determina la vida útil de cada equipo:\n              revisa su condición, las indicaciones del fabricante\n              y las políticas de tu institución.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ars-faq__item\">\n          <summary class=\"ars-faq__question\">\n            <span class=\"ars-faq__question-text\">\n              ¿HG2 es exactamente lo mismo que IIIA?\n            </span>\n            <span class=\"ars-faq__icon\" aria-hidden=\"true\"></span>\n          </summary>\n\n          <div class=\"ars-faq__answer\">\n            <p>\n              No es una equivalencia automática. HG2 es la nueva\n              designación asociada al anterior IIIA, pero cambian\n              amenazas y métodos de ensayo. Un modelo certificado\n              bajo 0101.06 no obtiene por ello certificación\n              bajo 0101.07.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ars-faq__item\">\n          <summary class=\"ars-faq__question\">\n            <span class=\"ars-faq__question-text\">\n              ¿Qué incorpora el nuevo nivel RF2?\n            </span>\n            <span class=\"ars-faq__icon\" aria-hidden=\"true\"></span>\n          </summary>\n\n          <div class=\"ars-faq__answer\">\n            <p>\n              RF2 incluye las tres amenazas de RF1:\n              7.62 × 51 mm M80, 7.62 × 39 mm MSC y\n              5.56 mm M193. Añade la munición 5.56 mm M855,\n              con velocidad de referencia de 950 m/s.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ars-faq__item\">\n          <summary class=\"ars-faq__question\">\n            <span class=\"ars-faq__question-text\">\n              ¿0101.07 también certifica cascos y escudos?\n            </span>\n            <span class=\"ars-faq__icon\" aria-hidden=\"true\"></span>\n          </summary>\n\n          <div class=\"ars-faq__answer\">\n            <p>\n              No. NIJ 0101.07 establece requisitos y métodos\n              de ensayo para blindaje corporal del torso.\n              Su certificación no se extiende a cascos ni escudos;\n              esos productos requieren normas y evaluaciones\n              aplicables a su categoría.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ars-faq__item\">\n          <summary class=\"ars-faq__question\">\n            <span class=\"ars-faq__question-text\">\n              ¿RF3 se prueba contra todas las amenazas anteriores?\n            </span>\n            <span class=\"ars-faq__icon\" aria-hidden=\"true\"></span>\n          </summary>\n\n          <div class=\"ars-faq__answer\">\n            <p>\n              No dentro de la clasificación RF3 por sí sola.\n              Su amenaza de ensayo es .30-06 M2 AP,\n              con velocidad de referencia de 878 m/s.\n              Para confirmar evaluaciones frente a otras\n              municiones, consulta la documentación\n              específica del modelo.\n            </p>\n          </div>\n        </details>\n\n      </div>\n    </div>\n\n    <footer\n      class=\"ars-faq__sources\"\n      aria-label=\"Fuentes y actualizaciones\"\n    >\n      <p class=\"ars-faq__sources-label\">\n        Fuentes y actualizaciones · Revisión: octubre de 2026\n      </p>\n\n      <ul class=\"ars-faq__sources-links\">\n\n        <li>\n          <a\n            class=\"ars-faq__source-link\"\n            href=\"https://www.ojp.gov/pdffiles1/nij/223054.pdf\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label=\"NIJ 0101.06, PDF en una pestaña nueva\"\n          >\n            NIJ 0101.06 <span aria-hidden=\"true\">↗</span>\n          </a>\n        </li>\n\n        <li>\n          <a\n            class=\"ars-faq__source-link\"\n            href=\"https://nij.ojp.gov/topics/equipment-and-technology/ballistic-resistance-body-armor-nij-standard-010107\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label=\"NIJ 0101.07 y adendas, en una pestaña nueva\"\n          >\n            NIJ 0101.07 y adendas <span aria-hidden=\"true\">↗</span>\n          </a>\n        </li>\n\n        <li>\n          <a\n            class=\"ars-faq__source-link\"\n            href=\"https://nij.ojp.gov/topics/equipment-and-technology/specification-nij-ballistic-protection-levels-and-associated-test-threats-nij-standard-012300\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label=\"NIJ 0123.00 y adendas, en una pestaña nueva\"\n          >\n            NIJ 0123.00 y adendas <span aria-hidden=\"true\">↗</span>\n          </a>\n        </li>\n\n        <li>\n          <a\n            class=\"ars-faq__source-link\"\n            href=\"https://cjttec.org/compliance-testing-program/ballistic-resistant-body-armor/\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label=\"Programa NIJ CTP, en una pestaña nueva\"\n          >\n            Programa NIJ CTP <span aria-hidden=\"true\">↗</span>\n          </a>\n        </li>\n\n      </ul>\n\n      <p class=\"ars-faq__sources-note\">\n        Resumen informativo. Para especificaciones de adquisición\n        y ensayos, consulta los documentos completos y sus adendas.\n      </p>\n    </footer>\n\n  </div>\n</section>",
