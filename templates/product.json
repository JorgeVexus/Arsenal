    "section_custom_liquid_kiH88U": {
      "type": "section-custom-liquid",
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign complementarios = product.metafields.custom.productos_complementarios.value %}\n\n{% if complementarios != blank %}\n<section class=\"arsenal-cross-sell\">\n  <h2>Completa tu equipamiento</h2>\n\n  <div class=\"arsenal-carousel\">\n    <button class=\"arsenal-arrow arsenal-prev\" type=\"button\"\n      aria-label=\"Productos anteriores\">&#10094;</button>\n\n    <div class=\"arsenal-track\">\n      {% for item in complementarios %}\n        <article class=\"arsenal-card\">\n          <a href=\"{{ item.url }}\" class=\"arsenal-image\">\n            {% if item.featured_image != blank %}\n              <img\n                src=\"{{ item.featured_image | image_url: width: 300 }}\"\n                alt=\"{{ item.title | escape }}\"\n                loading=\"lazy\"\n                width=\"300\"\n                height=\"300\"\n              >\n            {% endif %}\n          </a>\n\n          <h3>\n            <a href=\"{{ item.url }}\">{{ item.title | escape }}</a>\n          </h3>\n\n          <a href=\"{{ item.url }}\" class=\"arsenal-button\">\n            Ver producto y cotizar\n          </a>\n        </article>\n      {% endfor %}\n    </div>\n\n    <button class=\"arsenal-arrow arsenal-next\" type=\"button\"\n      aria-label=\"Productos siguientes\">&#10095;</button>\n  </div>\n</section>\n\n<style>\n  .arsenal-cross-sell {\n    max-width: 1200px;\n    width: 100%;\n    margin: 24px auto;\n    padding: 0 16px;\n    box-sizing: border-box;\n  }\n\n  .arsenal-cross-sell h2 {\n    font-size: 22px;\n    margin: 0 0 14px;\n    color: #171717;\n  }\n\n  .arsenal-carousel {\n    position: relative;\n    padding: 0 34px;\n  }\n\n  .arsenal-track {\n    display: flex;\n    gap: 12px;\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n    padding: 2px 1px 8px;\n  }\n\n  .arsenal-track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .arsenal-card {\n    flex: 0 0 calc((100% - 48px) / 5);\n    min-width: 0;\n    box-sizing: border-box;\n    padding: 8px;\n    border: 1px solid #e5e5e5;\n    border-radius: 8px;\n    background: #fff;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    scroll-snap-align: start;\n  }\n\n  .arsenal-image {\n    display: block;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n  }\n\n  .arsenal-image img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n\n  .arsenal-card h3 {\n    font-size: 12px;\n    line-height: 1.35;\n    margin: 8px 0;\n    flex-grow: 1;\n  }\n\n  .arsenal-card h3 a {\n    color: #171717;\n    text-decoration: none;\n  }\n\n  .arsenal-button {\n    display: block;\n    margin-top: 5px;\n    padding: 8px 4px;\n    background: #f15a0a;\n    color: #fff;\n    border-radius: 20px;\n    text-decoration: none;\n    font-size: 10px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  .arsenal-button:hover {\n    background: #d94d05;\n    color: #fff;\n  }\n\n  .arsenal-arrow {\n    position: absolute;\n    z-index: 2;\n    top: 40%;\n    transform: translateY(-50%);\n    width: 30px;\n    height: 30px;\n    border: 1px solid #ddd;\n    border-radius: 50%;\n    background: #fff;\n    color: #222;\n    cursor: pointer;\n    box-shadow: 0 2px 6px #00000015;\n  }\n\n  .arsenal-prev {\n    left: 0;\n  }\n\n  .arsenal-next {\n    right: 0;\n  }\n\n  @media (max-width: 749px) {\n    .arsenal-cross-sell {\n      padding: 0 10px;\n    }\n\n    .arsenal-cross-sell h2 {\n      font-size: 20px;\n    }\n\n    .arsenal-carousel {\n      padding: 0 27px;\n    }\n\n    .arsenal-track {\n      gap: 8px;\n    }\n\n    .arsenal-card {\n      flex-basis: calc((100% - 8px) / 2);\n      padding: 6px;\n    }\n\n    .arsenal-card h3 {\n      font-size: 12px;\n    }\n\n    .arsenal-button {\n      font-size: 10px;\n    }\n\n    .arsenal-arrow {\n      width: 25px;\n      height: 25px;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    const section = document.currentScript.previousElementSibling;\n    if (!section || !section.classList.contains('arsenal-cross-sell')) return;\n\n    const carousel = section.querySelector('.arsenal-carousel');\n    const track = carousel.querySelector('.arsenal-track');\n    const prev = carousel.querySelector('.arsenal-prev');\n    const next = carousel.querySelector('.arsenal-next');\n\n    prev.addEventListener('click', () => {\n      track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' });\n    });\n\n    next.addEventListener('click', () => {\n      track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' });\n    });\n\n    const updateArrows = () => {\n      prev.hidden = track.scrollLeft <= 2;\n      next.hidden = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;\n    };\n\n    track.addEventListener('scroll', updateArrows, { passive: true });\n    window.addEventListener('resize', updateArrows);\n    updateArrows();\n  })();\n</script>\n{% endif %}",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    }
  },
