    "section_custom_liquid_kiH88U": {
      "type": "section-custom-liquid",
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign complementarios = product.metafields.custom.productos_complementarios.value %}\n\n{% if complementarios != blank %}\n<section class=\"arsenal-cross-sell\">\n  <h2>Completa tu equipamiento</h2>\n\n  <div class=\"arsenal-carousel\">\n    <button class=\"arsenal-arrow arsenal-prev\" type=\"button\"\n      aria-label=\"Productos anteriores\" disabled>\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M15 18l-6-6 6-6\"/>\n      </svg>\n    </button>\n\n    <div class=\"arsenal-track\">\n      {% for item in complementarios %}\n        <article class=\"arsenal-card\">\n          <a href=\"{{ item.url }}\" class=\"arsenal-image\">\n            {% if item.featured_image != blank %}\n              <img\n                src=\"{{ item.featured_image | image_url: width: 500 }}\"\n                alt=\"{{ item.title | escape }}\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            {% endif %}\n          </a>\n\n          <h3>\n            <a href=\"{{ item.url }}\">{{ item.title | escape }}</a>\n          </h3>\n\n          <a href=\"{{ item.url }}\" class=\"arsenal-button\">\n            Ver producto y cotizar\n          </a>\n        </article>\n      {% endfor %}\n    </div>\n\n    <button class=\"arsenal-arrow arsenal-next\" type=\"button\"\n      aria-label=\"Productos siguientes\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M9 18l6-6-6-6\"/>\n      </svg>\n    </button>\n  </div>\n\n  <div class=\"arsenal-progress\" aria-hidden=\"true\">\n    <span></span>\n  </div>\n</section>\n\n<style>\n  .arsenal-cross-sell {\n    width: 100%;\n    max-width: 1500px;\n    margin: 26px auto;\n    padding: 0 28px;\n    box-sizing: border-box;\n    color: #171717;\n  }\n\n  .arsenal-cross-sell h2 {\n    margin: 0 0 18px;\n    font-size: 25px;\n    line-height: 1.3;\n    font-weight: 700;\n  }\n\n  .arsenal-cross-sell .arsenal-carousel {\n    position: relative;\n  }\n\n  .arsenal-cross-sell .arsenal-track {\n    display: flex;\n    gap: 14px;\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n    padding: 2px 1px 5px;\n  }\n\n  .arsenal-cross-sell .arsenal-track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .arsenal-cross-sell .arsenal-card {\n    flex: 0 0 calc((100% - 56px) / 5);\n    min-width: 0;\n    box-sizing: border-box;\n    padding: 9px;\n    border: 1px solid #e3e3e3;\n    border-radius: 12px;\n    background: #fff;\n    display: flex;\n    flex-direction: column;\n    text-align: center;\n    scroll-snap-align: start;\n  }\n\n  .arsenal-cross-sell .arsenal-image {\n    display: block;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n    border-radius: 9px;\n    background: #f7f7f7;\n  }\n\n  .arsenal-cross-sell .arsenal-image img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n\n  .arsenal-cross-sell .arsenal-card h3 {\n    margin: 10px 0 12px;\n    font-size: 13px;\n    line-height: 1.4;\n    font-weight: 600;\n    flex-grow: 1;\n  }\n\n  .arsenal-cross-sell .arsenal-card h3 a {\n    color: #171717;\n    text-decoration: none;\n  }\n\n  .arsenal-cross-sell .arsenal-button {\n    display: block;\n    margin-top: auto;\n    padding: 10px 6px;\n    border-radius: 24px;\n    background: #f45108;\n    color: #fff;\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1.3;\n    font-weight: 700;\n  }\n\n  .arsenal-cross-sell .arsenal-button:hover {\n    background: #d94304;\n    color: #fff;\n  }\n\n  /* Flechas: neutralizar los estilos globales del tema */\n  .arsenal-cross-sell button.arsenal-arrow,\n  .arsenal-cross-sell button.arsenal-arrow:not([disabled]) {\n    appearance: none !important;\n    -webkit-appearance: none !important;\n    position: absolute !important;\n    z-index: 5 !important;\n    top: 38% !important;\n    transform: translateY(-50%) !important;\n\n    width: 42px !important;\n    min-width: 42px !important;\n    max-width: 42px !important;\n    height: 42px !important;\n    min-height: 42px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n\n    border: 1px solid rgba(255,255,255,.8) !important;\n    border-radius: 50% !important;\n    background: rgba(55,55,55,.25) !important;\n    background-color: rgba(55,55,55,.25) !important;\n    background-image: none !important;\n    color: #fff !important;\n    box-shadow: 0 2px 10px rgba(0,0,0,.12) !important;\n\n    opacity: 1;\n    cursor: pointer;\n    backdrop-filter: blur(6px);\n    -webkit-backdrop-filter: blur(6px);\n    transition: background-color .2s ease, opacity .2s ease;\n  }\n\n  .arsenal-cross-sell button.arsenal-arrow:hover,\n  .arsenal-cross-sell button.arsenal-arrow:focus-visible {\n    background: rgba(45,45,45,.5) !important;\n    background-color: rgba(45,45,45,.5) !important;\n    background-image: none !important;\n    color: #fff !important;\n  }\n\n  .arsenal-cross-sell button.arsenal-arrow::before,\n  .arsenal-cross-sell button.arsenal-arrow::after {\n    content: none !important;\n    display: none !important;\n    background: none !important;\n    box-shadow: none !important;\n  }\n\n  .arsenal-cross-sell button.arsenal-arrow svg {\n    display: block !important;\n    width: 22px !important;\n    height: 22px !important;\n    min-width: 0 !important;\n    fill: none !important;\n    stroke: #fff !important;\n    stroke-width: 2.5;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .arsenal-cross-sell button.arsenal-prev {\n    left: -20px !important;\n    right: auto !important;\n  }\n\n  .arsenal-cross-sell button.arsenal-next {\n    right: -20px !important;\n    left: auto !important;\n  }\n\n  .arsenal-cross-sell button.arsenal-arrow:disabled {\n    opacity: 0 !important;\n    pointer-events: none !important;\n    cursor: default !important;\n  }\n\n  .arsenal-cross-sell .arsenal-progress {\n    height: 5px;\n    margin-top: 13px;\n    overflow: hidden;\n    border-radius: 10px;\n    background: #e5e5e5;\n  }\n\n  .arsenal-cross-sell .arsenal-progress span {\n    display: block;\n    width: 0;\n    height: 100%;\n    border-radius: inherit;\n    background: #999;\n    transition: width .15s ease;\n  }\n\n  @media screen and (max-width: 1000px) {\n    .arsenal-cross-sell {\n      padding: 0 22px;\n    }\n\n    .arsenal-cross-sell .arsenal-card {\n      flex-basis: calc((100% - 42px) / 4);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .arsenal-cross-sell {\n      margin: 22px auto;\n      padding: 0 14px;\n    }\n\n    .arsenal-cross-sell h2 {\n      font-size: 21px;\n      margin-bottom: 14px;\n    }\n\n    .arsenal-cross-sell .arsenal-track {\n      gap: 10px;\n    }\n\n    .arsenal-cross-sell .arsenal-card {\n      flex-basis: calc((100% - 10px) / 2);\n      padding: 7px;\n      border-radius: 10px;\n    }\n\n    .arsenal-cross-sell .arsenal-card h3 {\n      font-size: 12px;\n      margin: 9px 0 10px;\n    }\n\n    .arsenal-cross-sell .arsenal-button {\n      padding: 9px 5px;\n      font-size: 11px;\n    }\n\n    .arsenal-cross-sell button.arsenal-arrow,\n    .arsenal-cross-sell button.arsenal-arrow:not([disabled]) {\n      width: 32px !important;\n      min-width: 32px !important;\n      max-width: 32px !important;\n      height: 32px !important;\n      min-height: 32px !important;\n      top: 35% !important;\n    }\n\n    .arsenal-cross-sell button.arsenal-prev {\n      left: -9px !important;\n    }\n\n    .arsenal-cross-sell button.arsenal-next {\n      right: -9px !important;\n    }\n\n    .arsenal-cross-sell button.arsenal-arrow svg {\n      width: 18px !important;\n      height: 18px !important;\n    }\n\n    .arsenal-cross-sell .arsenal-progress {\n      height: 4px;\n      margin-top: 10px;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    const script = document.currentScript;\n    const section = script\n      ? script.closest('.shopify-section')?.querySelector('.arsenal-cross-sell')\n      : null;\n\n    if (!section || section.dataset.carouselReady === 'true') return;\n    section.dataset.carouselReady = 'true';\n\n    const track = section.querySelector('.arsenal-track');\n    const prev = section.querySelector('.arsenal-prev');\n    const next = section.querySelector('.arsenal-next');\n    const progress = section.querySelector('.arsenal-progress span');\n\n    if (!track || !prev || !next || !progress) return;\n\n    const update = () => {\n      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);\n\n      prev.disabled = track.scrollLeft <= 2;\n      next.disabled = track.scrollLeft >= maxScroll - 2;\n\n      progress.style.width = maxScroll > 0\n        ? `${Math.max(8, (track.scrollLeft / maxScroll) * 100)}%`\n        : '100%';\n    };\n\n    prev.addEventListener('click', () => {\n      track.scrollBy({\n        left: -track.clientWidth * 0.85,\n        behavior: 'smooth'\n      });\n    });\n\n    next.addEventListener('click', () => {\n      track.scrollBy({\n        left: track.clientWidth * 0.85,\n        behavior: 'smooth'\n      });\n    });\n\n    track.addEventListener('scroll', update, { passive: true });\n    window.addEventListener('resize', update);\n\n    update();\n    requestAnimationFrame(update);\n  })();\n</script>\n{% endif %}",
        "spacing_desktop": 50,
        "spacing_mobile": 30,
        "fix_zindex": 0
      }
    }
  },
