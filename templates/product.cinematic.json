        "template--19955408765249__098b17a8-14c3-4f6f-a711-23eb99e5eacf-text-2": {
          "type": "text",
          "settings": {
            "icon": "none",
            "image_height": 55,
            "image_border_radius": false,
            "title": "In Stereo",
            "text": "<p>In terms of sound, the BeoSound A9 is identical to its predecessor, the BeoPlay A9, but is built on a completely new technological platform, which makes it possible to wirelessly connect 2 speakers into a stereo pair.</p>",
            "show_link": false,
            "link_text": "Button",
            "link_url": "",
            "button_style": "primary plain"
          }
        },
