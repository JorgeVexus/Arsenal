    "b49a6cc1-6fdd-4026-8722-96088a785d19": {
      "type": "section-faq",
      "blocks": {
        "template--21407923765569__b49a6cc1-6fdd-4026-8722-96088a785d19-text-1": {
          "type": "text",
          "settings": {
            "collapse": true,
            "title": "Sound",
            "icon": "none",
            "header_image_width": 50,
            "faq_answer": "<p>Recommended Room Size<br/>15-100 m²<br/>150-1000 ft²<br/><br/>Speaker Configuration<br/>2 x ¾\" tweeter<br/>2 x 3\" mid-range <br/>2 x 1 ½\" full-range <br/>1 x 8\" woofer <br/><br/>Amplifier<br/>2 x 150 watt class D for treble<br/>2 x 200 watt class D for midrange<br/>2 x 200 watt class D for fullrange<br/>1 x 400 watt class D for bass<br/><br/>Frequency Range<br/>33- 23.000 Hz<br/><br/>Maximum Sound Pressure Level @1m<br/>100 dB SPL<br/><br/>Bass Capability<br/>95 dB SPL<br/><br/>Stereo Pairing<br/>Pair two Beosound A9 5th Gen to enjoy a stereo listening experience.<br/><br/>Advanced Sound Features<br/>Active Room Compensation<br/>Thermal Protection<br/>Adaptive Bass Linearization<br/><br/>Customizable Sound EQ<br/>Presets available and fully customisable through the Bang & Olufsen App</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "template--21407923765569__b49a6cc1-6fdd-4026-8722-96088a785d19-text-2": {
          "type": "text",
          "settings": {
            "collapse": true,
            "title": "Design",
            "icon": "none",
            "header_image_width": 50,
            "faq_answer": "<h4><strong>Designer</strong></h4><p>Øivind Alexander Slaatto</p><h4>Materials</h4><p>Aluminium<br/>Fabric / Wool<br/>Wood<br/>Polymer</p><h4>Dimensions (Width x Height x Depth)</h4><p>70.1 W x 90.8 H x 41.5 D cm</p><h4>Weight</h4><p>14.7 kg</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "template--21407923765569__b49a6cc1-6fdd-4026-8722-96088a785d19-text-3": {
          "type": "text",
          "settings": {
            "collapse": true,
            "title": "Power",
            "icon": "none",
            "header_image_width": 50,
            "faq_answer": "<h4>Power consumption</h4><p>Typical: 23 W<br/>Standby: 3.3 W</p><h4>Power Supply</h4><p>Power supply built-in<br/>Power Cable</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "a63f3d17-994b-440b-9450-b36f7c4d52dd": {
          "type": "text",
          "settings": {
            "collapse": true,
            "title": "Connectivity",
            "icon": "none",
            "header_image_width": 50,
            "faq_answer": "<h4>Bluetooth Version</h4><p>Bluetooth 5.3</p><h4>Bluetooth Codecs</h4><p>AAC<br/>SBC</p><h4>Wi-Fi</h4><p>Dual-Band Wi-Fi (2.4 & 5 GHz)<br/>IEEE 802.11 b/g/a/n/ac/ax </p><h4>Streaming services</h4><p>Apple AirPlay 2<br/>Spotify Connect <br/>Chromecast built-in <br/>TIDAL Connect<br/>B&O Radio<br/>Deezer<br/>QPlay 2.0</p><h4>Beolink Multiroom</h4><p>Yes</p><h4>Physical Connections</h4><p>1 x Ethernet<br/>1 x Line-in via USB-C<br/>1 x Power</p><h4>Remote controls</h4><p>Bang & Olufsen App<br/>Beoremote One BT<br/>Beoremote Halo</p><h4>On-Device Controls</h4><p>Yes</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        }
      },
