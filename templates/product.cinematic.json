          "type": "text",
          "settings": {
            "icon": "none",
            "image_height": 55,
            "image_border_radius": false,
            "title": "The new one",
            "text": "<p>The BeoSound A9 is a completely new version of the well-known BeoPlay A9 mk4.</p>",
            "show_link": false,
            "link_text": "Button",
            "link_url": "",
            "button_style": "primary plain"
