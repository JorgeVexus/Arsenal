{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .arsenal-timeline {
    background: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .arsenal-timeline-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .arsenal-timeline-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .arsenal-timeline-header h2 {
    margin: 0 0 15px 0;
    font-size: clamp(28px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .arsenal-timeline-header .rte {
    color: rgba(0,0,0,0.7);
    max-width: 700px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.5;
  }

  /* Timeline Line (Desktop) */
  .arsenal-timeline-track {
    position: relative;
  }

  @media screen and (min-width: 990px) {
    .timeline-mobile-nav,
    .timeline-mobile-indicator {
      display: none !important;
    }

    .timeline-header-mobile {
      display: contents !important;
    }

    .arsenal-timeline-track::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, 
        {{ section.settings.line_color }} 0%, 
        {{ section.settings.line_color | color_modify: 'alpha', 0.3 }} 100%);
      transform: translateX(-50%);
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 1fr 120px 1fr;
      gap: 30px;
      align-items: center;
      position: relative;
      margin-bottom: 80px;
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .timeline-item.animate-in {
      opacity: 1;
      transform: translateY(0);
    }

    .timeline-item:last-child {
      margin-bottom: 0;
    }

    .timeline-item:nth-child(even) .timeline-content,
    .timeline-item:nth-child(even) .timeline-link {
      order: 3;
      text-align: left;
      width: 100%;
    }

    .timeline-item:nth-child(even) .timeline-icon {
      order: 2;
    }

    .timeline-item:nth-child(even) .timeline-year {
      order: 1;
      text-align: right;
    }

    .timeline-item:nth-child(odd) .timeline-content,
    .timeline-item:nth-child(odd) .timeline-link {
      order: 1;
      text-align: right;
      width: 100%;
    }

    .timeline-item:nth-child(odd) .timeline-icon {
      order: 2;
    }

    .timeline-item:nth-child(odd) .timeline-year {
      order: 3;
      text-align: left;
    }
  }

  /* Desktop Icon, Year & Content */
  .timeline-icon {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: #fff;
    border: 3.5px solid {{ section.settings.line_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    z-index: 2;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    margin: 0 auto;
  }

  .timeline-item:hover .timeline-icon {
    transform: scale(1.08);
    box-shadow: 0 14px 35px rgba(0,0,0,0.15);
  }

  .timeline-icon img {
    width: 65%;
    height: 65%;
    object-fit: contain;
    border-radius: 50%;
  }

  .timeline-icon svg {
    width: 50%;
    height: 50%;
  }

  .timeline-year {
    font-size: 22px;
    font-weight: 700;
    color: {{ section.settings.line_color }};
    padding: 10px 22px;
    background: {{ section.settings.year_background }};
    border-radius: 50px;
    display: inline-block;
    border: 2px solid {{ section.settings.line_color }};
    letter-spacing: -0.01em;
  }

  .timeline-content {
    padding: 28px;
    background: {{ section.settings.card_background }};
    border-radius: 20px;
    box-shadow: 0 6px 24px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-item:hover .timeline-content {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }

  .timeline-content h3 {
    margin: 0 0 10px 0;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
  }

  .timeline-content p {
    margin: 0;
    color: rgba(0,0,0,0.7);
    font-size: 15px;
    line-height: 1.6;
  }

  .timeline-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .timeline-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.line_color }};
    text-decoration: none;
    transition: gap 0.25s ease;
  }

  .timeline-link:hover .timeline-read-more {
    gap: 10px;
  }

  .timeline-read-more svg {
    width: 16px;
    height: 16px;
  }

  /* Apple-Style Mobile Horizontal Carousel & Glassmorphism Nav */
  @media screen and (max-width: 989px) {
    .timeline-mobile-nav {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 8px;
      margin-bottom: 24px;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      background: rgba(255, 255, 255, 0.75);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 40px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }

    .timeline-mobile-nav::-webkit-scrollbar {
      display: none;
    }

    .timeline-mobile-nav-item {
      flex: 0 0 auto;
      padding: 8px 18px;
      font-size: 14px;
      font-weight: 600;
      color: rgba(0,0,0,0.6);
      background: transparent;
      border-radius: 20px;
      border: none;
      cursor: pointer;
      scroll-snap-align: center;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .timeline-mobile-nav-item:active {
      transform: scale(0.94);
    }

    .timeline-mobile-nav-item.active {
      background: {{ section.settings.line_color }};
      color: #ffffff;
      box-shadow: 0 4px 14px {{ section.settings.line_color | color_modify: 'alpha', 0.4 }};
    }

    .arsenal-timeline-track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      padding: 10px 10px 24px;
      margin: 0 -10px;
      scrollbar-width: none;
    }

    .arsenal-timeline-track::-webkit-scrollbar {
      display: none;
    }

    .timeline-item {
      flex: 0 0 calc(85vw - 20px);
      max-width: 340px;
      min-width: 270px;
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      opacity: 1;
      transform: none;
      margin-bottom: 0;
      background: #ffffff;
      border-radius: 24px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.07);
      border: 1px solid rgba(0,0,0,0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-sizing: border-box;
    }

    .timeline-item:active {
      transform: scale(0.97);
    }

    .timeline-header-mobile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .timeline-icon {
      width: 52px;
      height: 52px;
      border-width: 3px;
      margin: 0;
      flex-shrink: 0;
    }

    .timeline-year {
      font-size: 16px;
      padding: 6px 14px;
      margin: 0;
      border-width: 1.5px;
    }

    .timeline-content {
      padding: 0;
      background: transparent;
      border: none;
      box-shadow: none;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .timeline-content h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .timeline-content p {
      font-size: 14px;
      line-height: 1.5;
    }

    .timeline-mobile-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 14px;
    }

    .timeline-mobile-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(0,0,0,0.15);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .timeline-mobile-dot.active {
      width: 22px;
      border-radius: 10px;
      background: {{ section.settings.line_color }};
    }
  }
{%- endstyle -%}

<section class="arsenal-timeline section-{{ section.id }}-padding">
  <div class="arsenal-timeline-container">
    
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="arsenal-timeline-header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="timeline-mobile-nav" id="timelineNav-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button type="button" class="timeline-mobile-nav-item{% if forloop.first %} active{% endif %}" data-target-index="{{ forloop.index }}">
            {{ block.settings.year }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="arsenal-timeline-track">
      {%- for block in section.blocks -%}
        <div class="timeline-item" {{ block.shopify_attributes }} data-index="{{ forloop.index }}" id="timelineItem-{{ section.id }}-{{ forloop.index }}">
          
          <div class="timeline-header-mobile">
            <div class="timeline-icon">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.year }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="{{ section.settings.line_color }}" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="8"/>
                </svg>
              {%- endif -%}
            </div>

            <div class="timeline-year">
              {{ block.settings.year }}
            </div>
          </div>

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="timeline-link">
              <div class="timeline-content">
                <div>
                  {%- if block.settings.title != blank -%}
                    <h3>{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p>{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.link_text != blank -%}
                  <span class="timeline-read-more">
                    {{ block.settings.link_text }}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                  </span>
                {%- endif -%}
              </div>
            </a>
          {%- else -%}
            <div class="timeline-content">
              <div>
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p>{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="timeline-mobile-indicator" id="timelineDots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <span class="timeline-mobile-dot{% if forloop.first %} active{% endif %}" data-dot-index="{{ forloop.index }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function() {
  'use strict';
  
  const sectionId = '{{ section.id }}';
  const track = document.querySelector('.section-{{ section.id }}-padding .arsenal-timeline-track');
  const navItems = document.querySelectorAll('#timelineNav-' + sectionId + ' .timeline-mobile-nav-item');
  const dots = document.querySelectorAll('#timelineDots-' + sectionId + ' .timeline-mobile-dot');
  const items = document.querySelectorAll('.section-{{ section.id }}-padding .timeline-item');

  if (!track || !items.length) return;

  navItems.forEach(function(navBtn) {
    navBtn.addEventListener('click', function() {
      const targetIndex = this.getAttribute('data-target-index');
      const targetCard = document.getElementById('timelineItem-' + sectionId + '-' + targetIndex);
      if (targetCard) {
        targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });
  });

  const isMobile = window.innerWidth < 990;
  
  const observerOptions = {
    root: isMobile ? track : null,
    threshold: isMobile ? 0.6 : 0.2,
    rootMargin: isMobile ? '0px' : '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
        
        const itemIndex = entry.target.getAttribute('data-index');
        
        navItems.forEach(function(btn) {
          if (btn.getAttribute('data-target-index') === itemIndex) {
            btn.classList.add('active');
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            btn.classList.remove('active');
          }
        });

        dots.forEach(function(dot) {
          if (dot.getAttribute('data-dot-index') === itemIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    });
  }, observerOptions);

  items.forEach(function(item) {
    observer.observe(item);
  });
})();
</script>

