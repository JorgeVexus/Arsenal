{%- paginate collection.products by section.settings.products_per_page -%}

<style>
  .ll-cat-card__body {
    padding: 12px 10px !important;
    gap: 8px !important;
  }
  .ll-cat-card__title {
    font-size: 13.5px !important;
    line-height: 1.25 !important;
    min-height: 34px !important;
    margin-bottom: 2px !important;
  }
  .ll-cat-card__package-info {
    font-size: 11px !important;
    margin-bottom: 4px !important;
  }
  .ll-cat-card__price-row {
    display: flex !important;
    flex-direction: row !important;
    align-items: baseline !important;
    justify-content: space-between !important;
    gap: 2px !important;
    width: 100% !important;
    white-space: nowrap !important;
    overflow: hidden !important;
  }
  .ll-cat-card__unit-price-wrap {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: baseline !important;
    gap: 2px !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }
  .ll-cat-card__unit-price {
    font-family: var(--ll-font-heading, 'Montserrat', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 15px !important;
    color: var(--ll-purple, #9424a4) !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    display: inline-block !important;
  }
  .ll-cat-card__unit-price * {
    white-space: nowrap !important;
    display: inline !important;
    font-size: 15px !important;
  }
  .ll-cat-card__unit-compare {
    font-size: 10.5px !important;
    white-space: nowrap !important;
    text-decoration: line-through !important;
    color: var(--ll-text-muted, #777) !important;
    margin-left: 1px !important;
  }
  .ll-cat-card__unit-label {
    font-size: 10.5px !important;
    color: var(--ll-text-muted, #777) !important;
    white-space: nowrap !important;
  }
  .ll-cat-card__box-total {
    font-size: 10.5px !important;
    color: var(--ll-text-muted, #777) !important;
    text-align: right !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }
  .ll-cat-card__box-total * {
    white-space: nowrap !important;
    display: inline !important;
  }
</style>

<section class="ll-products-grid" aria-label="Productos de la categoría">
  {%- if collection.products.size > 0 -%}
    {%- for product in collection.products -%}
      <article class="ll-cat-card">
        <!-- Badges -->
        <div class="ll-product-card__badges">
          {%- if product.available == false -%}
            <span class="ll-badge ll-badge--red">AGOTADO</span>
          {%- elsif product.compare_at_price > product.price -%}
            <span class="ll-badge ll-badge--red">DESCUENTO</span>
          {%- elsif product.tags contains 'nuevo' or product.tags contains 'Nuevo' -%}
            <span class="ll-badge ll-badge--green">NUEVO</span>
          {%- else -%}
            <span class="ll-badge ll-badge--green">EN STOCK</span>
          {%- endif -%}
        </div>

        <!-- Media -->
        <div class="ll-cat-card__media">
          {%- if product.featured_media != blank -%}
            <img
              src="{{ product.featured_media | image_url: width: 400 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
              width="300"
              height="211"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        <!-- Body -->
        <div class="ll-cat-card__body">
          <div>
            <h3 class="ll-cat-card__title">
              <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                {{ product.title }}
              </a>
            </h3>

            <p class="ll-cat-card__package-info">
              {%- if product.metafields.custom.empaque != blank -%}
                {{ product.metafields.custom.empaque }}
              {%- else -%}
                Caja mayorista
              {%- endif -%}
            </p>
          </div>

          <div>
            <div class="ll-cat-card__price-row" style="display: flex; align-items: baseline; justify-content: space-between; gap: 2px; width: 100%; white-space: nowrap;">
              <div class="ll-cat-card__unit-price-wrap" style="display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; flex-shrink: 0;">
                <span class="ll-cat-card__unit-price{% if product.compare_at_price > product.price %} ll-cat-card__unit-price--discount{% endif %}" style="font-size: 15px !important; white-space: nowrap !important; display: inline-block !important;">
                  {{ product.price | money }}
                </span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="ll-cat-card__unit-compare" style="font-size: 10.5px !important; white-space: nowrap !important;">
                    {{ product.compare_at_price | money }}
                  </span>
                {%- endif -%}
                <span class="ll-cat-card__unit-label" style="font-size: 10.5px !important; white-space: nowrap !important;">/pza</span>
              </div>

              <div class="ll-cat-card__box-total" style="font-size: 10.5px !important; white-space: nowrap !important; text-align: right !important; flex-shrink: 0;">
                <span style="white-space: nowrap !important;">Caja: {{ product.price | times: 12 | money_without_trailing_zeros }}</span>
              </div>
            </div>

            <!-- Add button -->
            {%- if product.available -%}
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="ll-cat-card__btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
                  <span>Agregar</span>
                </button>
              </form>
            {%- else -%}
              <button type="button" class="ll-cat-card__btn" disabled style="opacity: 0.6; cursor: not-allowed;">
                <span>Agotado</span>
              </button>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  {%- else -%}
    <!-- DEMO SAMPLE PRODUCTS MATCHING FIGMA SPEC -->
    <!-- Product 1 -->
    <article class="ll-cat-card">
      <div class="ll-product-card__badges">
        <span class="ll-badge ll-badge--green">EN STOCK</span>
      </div>
      <div class="ll-cat-card__media">
        <img src="{{ 'prod-limpieza-1.png' | asset_url }}" alt="Set 3 Cepillos Limpieza Baño Colores Pastel" loading="lazy" width="300" height="211">
      </div>
      <div class="ll-cat-card__body">
        <div>
          <h3 class="ll-cat-card__title">Set 3 Cepillos Limpieza Baño Colores Pastel</h3>
          <p class="ll-cat-card__package-info">Caja con 24 pzas</p>
        </div>
        <div>
          <div class="ll-cat-card__price-row" style="display: flex; align-items: baseline; justify-content: space-between; gap: 2px; width: 100%; white-space: nowrap;">
            <div class="ll-cat-card__unit-price-wrap" style="display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; flex-shrink: 0;">
              <span class="ll-cat-card__unit-price" style="font-size: 15px !important; white-space: nowrap !important;">$45.00</span>
              <span class="ll-cat-card__unit-label" style="font-size: 10.5px !important; white-space: nowrap !important;">/pza</span>
            </div>
            <div class="ll-cat-card__box-total" style="font-size: 10.5px !important; white-space: nowrap !important; text-align: right !important; flex-shrink: 0;">
              <span style="white-space: nowrap !important;">Caja: $1,080</span>
            </div>
          </div>
          <a href="/products/set-cepillos-limpieza" class="ll-cat-card__btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
            <span>Agregar</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Product 2 -->
    <article class="ll-cat-card">
      <div class="ll-product-card__badges">
        <span class="ll-badge ll-badge--red">DESCUENTO</span>
      </div>
      <div class="ll-cat-card__media">
        <img src="{{ 'prod-limpieza-2.png' | asset_url }}" alt="Cepillo Premium Acero Inoxidable Base Rosa" loading="lazy" width="300" height="211">
      </div>
      <div class="ll-cat-card__body">
        <div>
          <h3 class="ll-cat-card__title">Cepillo Premium Acero Inoxidable Base Rosa</h3>
          <p class="ll-cat-card__package-info">Caja con 12 pzas</p>
        </div>
        <div>
          <div class="ll-cat-card__price-row" style="display: flex; align-items: baseline; justify-content: space-between; gap: 2px; width: 100%; white-space: nowrap;">
            <div class="ll-cat-card__unit-price-wrap" style="display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; flex-shrink: 0;">
              <span class="ll-cat-card__unit-price ll-cat-card__unit-price--discount" style="font-size: 15px !important; white-space: nowrap !important;">$85.00</span>
              <span class="ll-cat-card__unit-compare" style="font-size: 10.5px !important; white-space: nowrap !important;">$95.00</span>
            </div>
            <div class="ll-cat-card__box-total" style="font-size: 10.5px !important; white-space: nowrap !important; text-align: right !important; flex-shrink: 0;">
              <span style="white-space: nowrap !important;">Caja: $1,020</span>
            </div>
          </div>
          <a href="/products/cepillo-premium-rosa" class="ll-cat-card__btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
            <span>Agregar</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Product 3 -->
    <article class="ll-cat-card">
      <div class="ll-cat-card__media">
        <img src="{{ 'prod-limpieza-3.png' | asset_url }}" alt="Paquetes Paños Microfibra Industrial" loading="lazy" width="300" height="211">
      </div>
      <div class="ll-cat-card__body">
        <div>
          <h3 class="ll-cat-card__title">Paquetes Paños Microfibra Industrial…</h3>
          <p class="ll-cat-card__package-info">Fardo con 50 paq</p>
        </div>
        <div>
          <div class="ll-cat-card__price-row" style="display: flex; align-items: baseline; justify-content: space-between; gap: 2px; width: 100%; white-space: nowrap;">
            <div class="ll-cat-card__unit-price-wrap" style="display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; flex-shrink: 0;">
              <span class="ll-cat-card__unit-price" style="font-size: 15px !important; white-space: nowrap !important;">$22.50</span>
              <span class="ll-cat-card__unit-label" style="font-size: 10.5px !important; white-space: nowrap !important;">/paq</span>
            </div>
            <div class="ll-cat-card__box-total" style="font-size: 10.5px !important; white-space: nowrap !important; text-align: right !important; flex-shrink: 0;">
              <span style="white-space: nowrap !important;">Fardo: $1,125</span>
            </div>
          </div>
          <a href="/products/panos-microfibra" class="ll-cat-card__btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
            <span>Agregar</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Product 4 -->
    <article class="ll-cat-card">
      <div class="ll-cat-card__media">
        <img src="{{ 'prod-limpieza-4.png' | asset_url }}" alt="Atomizador Industrial Translúcido 1 Litro" loading="lazy" width="300" height="211">
      </div>
      <div class="ll-cat-card__body">
        <div>
          <h3 class="ll-cat-card__title">Atomizador Industrial Translúcido 1 Litro</h3>
          <p class="ll-cat-card__package-info">Caja con 36 pzas</p>
        </div>
        <div>
          <div class="ll-cat-card__price-row" style="display: flex; align-items: baseline; justify-content: space-between; gap: 2px; width: 100%; white-space: nowrap;">
            <div class="ll-cat-card__unit-price-wrap" style="display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; flex-shrink: 0;">
              <span class="ll-cat-card__unit-price" style="font-size: 15px !important; white-space: nowrap !important;">$18.00</span>
              <span class="ll-cat-card__unit-label" style="font-size: 10.5px !important; white-space: nowrap !important;">/pza</span>
            </div>
            <div class="ll-cat-card__box-total" style="font-size: 10.5px !important; white-space: nowrap !important; text-align: right !important; flex-shrink: 0;">
              <span style="white-space: nowrap !important;">Caja: $648</span>
            </div>
          </div>
          <a href="/products/atomizador-industrial" class="ll-cat-card__btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
            <span>Agregar</span>
          </a>
        </div>
      </div>
    </article>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Grilla de Colección",
  "class": "section-llamarada-collection-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "Productos por página"
    }
  ],
  "presets": [
    {
      "name": "Grilla de Colección"
    }
  ]
}
{% endschema %}
