{% comment %}
  Modern Featured Products Grid & Slider
  A highly customizable grid or slider of products with manual stars, badges, and hiddable prices.
  @author: Jorge Cerna - Vexus
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .fpg-container-{{ section.id }} {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  /* Header Branding */
  .fpg-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .fpg-header-left {
    display: flex;
    flex-direction: column;
  }

  /* Kicker / Tagline */
  .fpg-kicker-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.kicker_color | default: '#e8701a' }};
    font-size: clamp({{ section.settings.kicker_font_size_mobile | default: 11 }}px, 1.2vw, {{ section.settings.kicker_font_size_desktop | default: 13 }}px);
    font-weight: {{ section.settings.kicker_font_weight | default: '700' }};
    text-transform: {{ section.settings.kicker_text_transform | default: 'uppercase' }};
    letter-spacing: {{ section.settings.kicker_letter_spacing | default: 2 }}px;
    margin-bottom: {{ section.settings.kicker_margin_bottom | default: 8 }}px;
    line-height: 1.2;
    box-sizing: border-box;
    width: fit-content;
  }

  .fpg-kicker--badge-{{ section.id }} {
    background-color: {{ section.settings.kicker_bg | default: 'rgba(232, 112, 26, 0.12)' }};
    border: 1px solid {{ section.settings.kicker_border_color | default: 'rgba(232, 112, 26, 0.3)' }};
    padding: 6px 16px;
    border-radius: 50px;
  }

  .fpg-kicker--text-{{ section.id }} {
    background: transparent;
    border: none;
    padding: 0;
  }

  .fpg-kicker-{{ section.id }} .kicker-pulse {
    display: inline-block;
    width: 7px;
    height: 7px;
    background-color: {{ section.settings.kicker_color | default: '#e8701a' }};
    border-radius: 50%;
    box-shadow: 0 0 8px {{ section.settings.kicker_color | default: '#e8701a' }};
    animation: fpgPulseDot-{{ section.id }} 1.6s infinite ease-in-out;
  }

  @keyframes fpgPulseDot-{{ section.id }} {
    0% { transform: scale(0.9); opacity: 0.7; }
    50% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 12px {{ section.settings.kicker_color | default: '#e8701a' }}; }
    100% { transform: scale(0.9); opacity: 0.7; }
  }

  .fpg-title {
    font-size: clamp(24px, 4vw, {{ section.settings.title_font_size | default: 36 }}px);
    font-weight: 900;
    color: {{ section.settings.title_color | default: '#000000' }};
    margin: 0;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .fpg-cta {
    display: inline-block;
    padding: 12px 24px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    border: 2px solid #000;
  }

  .fpg-cta:hover {
    background: #fff;
    color: #000;
  }

  /* Slider / Grid Wrapper */
  .fpg-slider-wrapper {
    position: relative;
    width: 100%;
  }

  .fpg-grid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding-bottom: 5px;
    scroll-behavior: smooth;
  }

  .fpg-grid::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  /* Product Card Widths */
  .fpg-card {
    position: relative;
    background: #fff;
    display: flex;
    flex-direction: column;
    height: auto;
    transition: transform 0.3s ease;
    flex: 0 0 calc(60% - 10px); /* Slightly larger on mobile for partial view */
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .fpg-card {
      flex: 0 0 calc((100% / {{ section.settings.columns_desktop }}) - (20px * ({{ section.settings.columns_desktop }} - 1) / {{ section.settings.columns_desktop }}));
    }
    
    /* If NOT slider (static grid fallback if items <= columns) */
    {% if section.blocks.size <= section.settings.columns_desktop %}
       .fpg-grid {
         display: grid;
         grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
         overflow: visible;
       }
       .fpg-card {
         flex: none;
       }
       .fpg-arrows {
         display: none !important;
       }
       .fpg-dots-wrapper {
         display: none !important;
       }
    {% endif %}
  }

  .fpg-card:hover {
    transform: translateY(-5px);
  }

  .fpg-media-wrapper {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #f3f3f3;
    width: 100%;
  }

  .fpg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  /* Badge */
  .fpg-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #000;
    color: #fff;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    z-index: 2;
  }

  .fpg-info {
    padding: 15px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fpg-product-title {
    font-size: 16px;
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    line-height: 1.2;
  }

  .fpg-product-title:hover {
    opacity: 0.7;
  }

  .fpg-price {
    font-size: 15px;
    font-weight: 400;
    color: #333;
  }

  /* Manual Stars */
  .fpg-stars {
    display: flex;
    gap: 2px;
    margin-top: auto;
  }

  .fpg-star-icon {
    width: 14px;
    height: 14px;
    color: #000;
  }

  .fpg-star-icon.filled {
    fill: #000;
  }
  
  .fpg-star-icon.empty {
    fill: none;
    stroke: #000;
    stroke-width: 1.5px;
  }

  /* WhatsApp Link / Button in Product Card */
  .fpg-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.25s ease;
    width: fit-content;
    box-sizing: border-box;
    cursor: pointer;
  }

  .fpg-whatsapp-btn svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: currentColor;
    transition: transform 0.25s ease;
  }

  .fpg-whatsapp-btn:hover svg {
    transform: scale(1.18);
  }

  /* Style: Link */
  .fpg-whatsapp-btn--link {
    color: {{ section.settings.whatsapp_button_color | default: '#e8701a' }};
    padding: 2px 0;
    border-bottom: 1px solid transparent;
  }

  .fpg-whatsapp-btn--link:hover {
    color: {{ section.settings.whatsapp_button_hover_color | default: '#cf5c0c' }};
    border-bottom-color: currentColor;
  }

  /* Style: Button Solid */
  .fpg-whatsapp-btn--button_solid {
    background-color: {{ section.settings.whatsapp_button_color | default: '#e8701a' }};
    color: {{ section.settings.whatsapp_button_text_color | default: '#ffffff' }};
    padding: 8px 14px;
    border-radius: {{ section.settings.whatsapp_button_radius | default: 4 }}px;
    border: 1px solid transparent;
    width: 100%;
    justify-content: center;
  }

  .fpg-whatsapp-btn--button_solid:hover {
    background-color: {{ section.settings.whatsapp_button_hover_color | default: '#cf5c0c' }};
    color: {{ section.settings.whatsapp_button_text_color | default: '#ffffff' }};
    transform: translateY(-2px);
  }

  /* Style: Button Outline */
  .fpg-whatsapp-btn--button_outline {
    background-color: transparent;
    color: {{ section.settings.whatsapp_button_color | default: '#e8701a' }};
    border: 1.5px solid {{ section.settings.whatsapp_button_color | default: '#e8701a' }};
    padding: 7px 14px;
    border-radius: {{ section.settings.whatsapp_button_radius | default: 4 }}px;
    width: 100%;
    justify-content: center;
  }

  .fpg-whatsapp-btn--button_outline:hover {
    background-color: {{ section.settings.whatsapp_button_color | default: '#e8701a' }};
    color: {{ section.settings.whatsapp_button_text_color | default: '#ffffff' }};
    transform: translateY(-2px);
  }

  /* Slider Minimalist Arrows - Simple Icon Only */
  .fpg-arrows-{{ section.id }} {
    display: flex !important;
    gap: {{ section.settings.arrows_gap }}px !important;
    align-items: center !important;
  }

  @media screen and (max-width: 749px) {
    .fpg-arrows-{{ section.id }} {
      display: none !important;
    }
  }

  .fpg-arrow-{{ section.id }} {
    width: {{ section.settings.arrow_size }}px !important;
    height: {{ section.settings.arrow_size }}px !important;
    background: {{ section.settings.arrow_bg_color }} !important;
    background-color: {{ section.settings.arrow_bg_color }} !important;
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_border_color }} !important;
    border-radius: {{ section.settings.arrow_radius }}% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    padding: 0 !important;
    color: {{ section.settings.arrow_icon_color }} !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    box-shadow: none !important;
    outline: none !important;
    font-size: 0 !important;
    line-height: 0 !important;
    min-width: auto !important;
    min-height: auto !important;
    text-indent: -9999px !important;
    overflow: hidden !important;
  }

  .fpg-arrow-{{ section.id }}:hover,
  .fpg-arrow-{{ section.id }}:focus,
  .fpg-arrow-{{ section.id }}:active {
    background: {{ section.settings.arrow_bg_hover }} !important;
    background-color: {{ section.settings.arrow_bg_hover }} !important;
    border-color: {{ section.settings.arrow_border_hover }} !important;
    color: {{ section.settings.arrow_icon_hover }} !important;
    transform: scale(1.05) !important;
    box-shadow: none !important;
    outline: none !important;
  }

  .fpg-arrow-{{ section.id }} svg {
    width: {{ section.settings.arrow_icon_size }}px !important;
    height: {{ section.settings.arrow_icon_size }}px !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: {{ section.settings.arrow_stroke_width }}px !important;
    display: block !important;
    flex-shrink: 0 !important;
  }

  /* Pagination Dots - Minimalist */
  .fpg-dots-wrapper-{{ section.id }} {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    gap: {{ section.settings.dots_gap }}px !important;
    margin-top: {{ section.settings.dots_margin_top }}px !important;
    line-height: 0 !important;
  }

  .fpg-dot-{{ section.id }} {
    width: {{ section.settings.dot_size }}px !important;
    height: {{ section.settings.dot_size }}px !important;
    min-width: {{ section.settings.dot_size }}px !important;
    min-height: {{ section.settings.dot_size }}px !important;
    max-width: {{ section.settings.dot_size }}px !important;
    max-height: {{ section.settings.dot_size }}px !important;
    border-radius: 50% !important;
    background: {{ section.settings.dot_inactive_color }} !important;
    background-color: {{ section.settings.dot_inactive_color }} !important;
    cursor: pointer !important;
    border: none !important;
    transition: all 0.25s ease !important;
    padding: 0 !important;
    margin: 0 !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    box-shadow: none !important;
    outline: none !important;
    font-size: 0 !important;
    line-height: 0 !important;
    text-indent: -9999px !important;
    overflow: hidden !important;
  }

  .fpg-dot-{{ section.id }}:hover {
    background: {{ section.settings.dot_hover_color }} !important;
    background-color: {{ section.settings.dot_hover_color }} !important;
    box-shadow: none !important;
    outline: none !important;
  }

  .fpg-dot-{{ section.id }}.is-active {
    background: {{ section.settings.dot_active_color }} !important;
    background-color: {{ section.settings.dot_active_color }} !important;
    box-shadow: none !important;
    outline: none !important;
  }

{%- endstyle -%}

<section class="section-{{ section.id }}-padding shopify-section">
  <div class="fpg-container-{{ section.id }}">
    
    <div class="fpg-header">
      <div class="fpg-header-left">
        {%- if section.settings.kicker != blank -%}
          <div class="fpg-kicker-{{ section.id }} fpg-kicker--{{ section.settings.kicker_style | default: 'text' }}-{{ section.id }}">
            {%- if section.settings.kicker_show_dot -%}
              <span class="kicker-pulse" aria-hidden="true"></span>
            {%- endif -%}
            <span>{{ section.settings.kicker }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="fpg-title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>

      <div style="display: flex; align-items: center; gap: 16px;">
        {%- if section.blocks.size > section.settings.columns_desktop -%}
          <div class="fpg-arrows-{{ section.id }}">
            <button class="fpg-arrow-{{ section.id }} prev-{{ section.id }}" aria-label="Previous">
              <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="fpg-arrow-{{ section.id }} next-{{ section.id }}" aria-label="Next">
              <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="fpg-cta">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="fpg-slider-wrapper">
      <div class="fpg-grid" id="grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div class="fpg-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="fpg-media-wrapper">
              {%- if block.settings.badge_text != blank -%}
                <span class="fpg-badge">{{ block.settings.badge_text }}</span>
              {%- endif -%}

              {%- assign card_image = block.settings.image_override | default: product.featured_image -%}
              
              {%- if card_image != blank -%}
                <img src="{{ card_image | image_url: width: 800 }}" 
                     loading="lazy" 
                     class="fpg-img" 
                     alt="{{ card_image.alt | default: product.title | escape }}"
                     width="{{ card_image.width }}"
                     height="{{ card_image.height }}">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'fpg-img placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="fpg-info">
              <a href="{{ product.url | default: '#' }}" class="fpg-product-title">
                {{ product.title | default: "Example Product Title" }}
              </a>

              {%- unless section.settings.hide_prices -%}
                <div class="fpg-price">
                  {%- if product != blank -%}
                    {{ product.price | money }}
                  {%- else -%}
                    {{ 19900 | money }}
                  {%- endif -%}
                </div>
              {%- endunless -%}

              {%- if section.settings.show_whatsapp_button -%}
                {%- liquid
                  assign clean_wa_number = section.settings.whatsapp_number | default: settings.whatsapp | default: '524776873939' | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
                  assign base_wa_msg = section.settings.whatsapp_message | default: 'Hola, me interesa solicitar más información sobre el producto:'
                  assign card_prod_title = product.title | default: 'Producto Arsenal'
                  assign wa_full_msg = base_wa_msg | append: ' ' | append: card_prod_title
                  if product.url != blank
                    assign wa_full_msg = wa_full_msg | append: ' (' | append: shop.url | append: product.url | append: ')'
                  endif
                  assign wa_encoded_msg = wa_full_msg | url_encode
                -%}
                <a href="https://wa.me/{{ clean_wa_number }}?text={{ wa_encoded_msg }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="fpg-whatsapp-btn fpg-whatsapp-btn--{{ section.settings.whatsapp_button_style | default: 'link' }}"
                   aria-label="{{ section.settings.whatsapp_button_text | default: 'Solicitar más información' }} - {{ card_prod_title | escape }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  <span>{{ section.settings.whatsapp_button_text | default: 'Solicitar más información' }}</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.blocks.size > section.settings.columns_desktop -%}
      <div class="fpg-dots-wrapper-{{ section.id }}" id="dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button class="fpg-dot-{{ section.id }} {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const grid = document.getElementById('grid-{{ section.id }}');
  const prevBtn = document.querySelector('.prev-{{ section.id }}');
  const nextBtn = document.querySelector('.next-{{ section.id }}');
  const dots = document.querySelectorAll('#dots-{{ section.id }} .fpg-dot-{{ section.id }}');
  const cards = grid.querySelectorAll('.fpg-card');

  if (grid) {
    const scrollAmount = () => cards[0].offsetWidth + 20; // card width + gap

    // Arrow clicks
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        grid.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        grid.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }

    // Dot clicks
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const index = dot.getAttribute('data-index');
        const targetCard = cards[index];
        if (targetCard) {
          grid.scrollTo({
            left: targetCard.offsetLeft - grid.offsetLeft,
            behavior: 'smooth'
          });
        }
      });
    });

    // Update dots on scroll
    grid.addEventListener('scroll', () => {
      let activeIndex = 0;
      let minDistance = Infinity;

      cards.forEach((card, index) => {
        const distance = Math.abs(card.getBoundingClientRect().left - grid.getBoundingClientRect().left);
        if (distance < minDistance) {
          minDistance = distance;
          activeIndex = index;
        }
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "Featured Products Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Kicker / Tagline Superior"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Texto del Kicker / Tagline",
      "default": "DESTACADOS"
    },
    {
      "type": "select",
      "id": "kicker_style",
      "label": "Estilo del Kicker",
      "options": [
        { "value": "text", "label": "Texto simple (Sin fondo)" },
        { "value": "badge", "label": "Insignia / Badge con fondo" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "kicker_show_dot",
      "label": "Mostrar punto luminoso / indicador",
      "default": false
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "Color del Kicker",
      "default": "#e8701a"
    },
    {
      "type": "color",
      "id": "kicker_bg",
      "label": "Color de Fondo (Modo Insignia)",
      "default": "rgba(232, 112, 26, 0.12)"
    },
    {
      "type": "color",
      "id": "kicker_border_color",
      "label": "Color de Borde (Modo Insignia)",
      "default": "rgba(232, 112, 26, 0.3)"
    },
    {
      "type": "range",
      "id": "kicker_font_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del Kicker Desktop",
      "default": 13
    },
    {
      "type": "range",
      "id": "kicker_font_size_mobile",
