{%- style -%}
  /* Base Section Styles */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  /* Collections Section */
  .collections-section-{{ section.id }} {
    position: relative;
    background: {{ section.settings.background_color }};
    overflow: hidden;
  }
  /* Decorative Elements */
  .collections-section-{{ section.id }} .cl-decoration {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.25;
    pointer-events: none;
  }
  .collections-section-{{ section.id }} .cl-decoration-1 {
    width: 600px;
    height: 600px;
    background: {{ section.settings.accent_color }};
    top: -200px;
    right: -200px;
  }
  .collections-section-{{ section.id }} .cl-decoration-2 {
    width: 500px;
    height: 500px;
    background: {{ section.settings.secondary_accent }};
    bottom: -200px;
    left: -150px;
  }
  /* Container */
  .collections-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }
  /* Header */
  .cl-header-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 60px;
  }
  @media screen and (min-width: 990px) {
    .cl-header-{{ section.id }}.layout-split {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  .cl-header-{{ section.id }}.layout-center {
    text-align: center;
    align-items: center;
  }
  .cl-header-content-{{ section.id }} {
    max-width: {{ section.settings.description_max_width | default: 600 }}px;
  }
  /* Kicker / Tagline */
  .cl-kicker-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.kicker_color | default: section.settings.accent_color }};
    font-size: clamp({{ section.settings.kicker_font_size_mobile | default: 11 }}px, 1.2vw, {{ section.settings.kicker_font_size_desktop | default: 13 }}px);
    font-weight: {{ section.settings.kicker_font_weight | default: '700' }};
    text-transform: {{ section.settings.kicker_text_transform | default: 'uppercase' }};
    letter-spacing: {{ section.settings.kicker_letter_spacing | default: 2 }}px;
    margin-bottom: {{ section.settings.kicker_margin_bottom | default: 10 }}px;
    line-height: 1.2;
    box-sizing: border-box;
    width: fit-content;
  }
  .cl-header-{{ section.id }}.layout-center .cl-kicker-{{ section.id }} {
    margin-left: auto;
    margin-right: auto;
  }
  .cl-kicker--badge-{{ section.id }} {
    background-color: {{ section.settings.kicker_bg | default: 'rgba(232, 112, 26, 0.12)' }};
    border: 1px solid {{ section.settings.kicker_border_color | default: 'rgba(232, 112, 26, 0.3)' }};
    padding: 6px 16px;
    border-radius: 50px;
  }
  .cl-kicker--text-{{ section.id }} {
    background: transparent;
    border: none;
    padding: 0;
  }
  .cl-kicker-{{ section.id }} .kicker-pulse {
    display: inline-block;
    width: 7px;
    height: 7px;
    background-color: {{ section.settings.kicker_color | default: section.settings.accent_color }};
    border-radius: 50%;
    box-shadow: 0 0 8px {{ section.settings.kicker_color | default: section.settings.accent_color }};
    animation: clPulseDot-{{ section.id }} 1.6s infinite ease-in-out;
  }
  @keyframes clPulseDot-{{ section.id }} {
    0% { transform: scale(0.9); opacity: 0.7; }
    50% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 12px {{ section.settings.kicker_color | default: section.settings.accent_color }}; }
    100% { transform: scale(0.9); opacity: 0.7; }
  }
  .cl-header-{{ section.id }} .cl-badge {
    display: inline-block;
    padding: 8px 20px;
    background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
    color: {{ section.settings.accent_color }};
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .cl-header-{{ section.id }} h2 {
    font-size: clamp(24px, 4vw, {{ section.settings.heading_size | default: 36 }}px);
    font-weight: {{ section.settings.heading_font_weight | default: '800' }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_margin_bottom | default: 12 }}px 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .cl-header-{{ section.id }} .cl-description-{{ section.id }},
  .cl-header-{{ section.id }} .cl-subtitle {
    font-size: clamp({{ section.settings.description_font_size_mobile | default: 14 }}px, 1.4vw, {{ section.settings.description_font_size | default: 16 }}px);
    color: {{ section.settings.description_color | default: section.settings.text_color }};
    line-height: {{ section.settings.description_line_height | default: 1.6 }};
    margin: 0;
    max-width: {{ section.settings.description_max_width | default: 600 }}px;
  }
  .cl-header-{{ section.id }} .cl-description-{{ section.id }} p,
  .cl-header-{{ section.id }} .cl-subtitle p {
    margin: 0 0 8px 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }
  .cl-header-{{ section.id }} .cl-description-{{ section.id }} p:last-child,
  .cl-header-{{ section.id }} .cl-subtitle p:last-child {
    margin-bottom: 0;
  }
  .cl-header-{{ section.id }}.layout-center .cl-description-{{ section.id }},
  .cl-header-{{ section.id }}.layout-center .cl-subtitle {
    margin-left: auto;
    margin-right: auto;
  }
  /* View All Button */
  .cl-view-all-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};
    text-decoration: none;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    white-space: nowrap;
  }
  .cl-view-all-{{ section.id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px {{ section.settings.button_background | color_modify: 'alpha', 0.3 }};
  }
  .cl-view-all-{{ section.id }} svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }
  .cl-view-all-{{ section.id }}:hover svg {
    transform: translateX(4px);
  }
  /* ============================================
     GRID LAYOUTS
     ============================================ */
  /* Standard Grid */
  .cl-grid-{{ section.id }}.layout-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }
  @media screen and (min-width: 750px) {
    .cl-grid-{{ section.id }}.layout-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media screen and (min-width: 990px) {
    .cl-grid-{{ section.id }}.layout-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }
  /* Masonry Layout */
  .cl-grid-{{ section.id }}.layout-masonry {
    columns: 2;
    column-gap: {{ section.settings.grid_gap }}px;
  }
  @media screen and (min-width: 750px) {
    .cl-grid-{{ section.id }}.layout-masonry {
      columns: 3;
    }
  }
  @media screen and (min-width: 990px) {
    .cl-grid-{{ section.id }}.layout-masonry {
      columns: {{ section.settings.columns }};
    }
  }
  .cl-grid-{{ section.id }}.layout-masonry .cl-card-{{ section.id }} {
    break-inside: avoid;
    margin-bottom: {{ section.settings.grid_gap }}px;
  }
  /* Editorial Layout */
  .cl-grid-{{ section.id }}.layout-editorial {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap }}px;
  }
  @media screen and (min-width: 750px) {
    .cl-grid-{{ section.id }}.layout-editorial {
      grid-template-columns: repeat(2, 1fr);
    }
    .cl-grid-{{ section.id }}.layout-editorial .cl-card-{{ section.id }}:nth-child(3n+1) {
      grid-column: span 2;
    }
    .cl-grid-{{ section.id }}.layout-editorial .cl-card-{{ section.id }}:nth-child(3n+1) .cl-card-image-{{ section.id }} {
      aspect-ratio: 21/9;
    }
  }
  @media screen and (min-width: 990px) {
    .cl-grid-{{ section.id }}.layout-editorial {
      grid-template-columns: repeat(3, 1fr);
    }
    .cl-grid-{{ section.id }}.layout-editorial .cl-card-{{ section.id }}:nth-child(5n+1) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .cl-grid-{{ section.id }}.layout-editorial .cl-card-{{ section.id }}:nth-child(5n+1) .cl-card-image-{{ section.id }} {
      aspect-ratio: 1/1;
      height: 100%;
    }
    .cl-grid-{{ section.id }}.layout-editorial .cl-card-{{ section.id }}:nth-child(5n+2),
    .cl-grid-{{ section.id }}.layout-editorial .cl-card-{{ section.id }}:nth-child(5n+3) {
      grid-column: span 1;
    }
  }
  /* Bento Layout */
  .cl-grid-{{ section.id }}.layout-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap }}px;
  }
  @media screen and (min-width: 750px) {
    .cl-grid-{{ section.id }}.layout-bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 200px;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }}:nth-child(6n+1) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }}:nth-child(6n+2),
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }}:nth-child(6n+3) {
      grid-column: span 1;
      grid-row: span 1;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }}:nth-child(6n+4) {
      grid-column: span 2;
      grid-row: span 1;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }}:nth-child(6n+5),
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }}:nth-child(6n+6) {
      grid-column: span 1;
      grid-row: span 1;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-image-{{ section.id }} {
      height: 100%;
      aspect-ratio: auto;
    }
  }
  /* ============================================
     COLLECTION CARDS
     ============================================ */
  .cl-card-{{ section.id }} {
    position: relative;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    text-decoration: none;
    display: block;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  /* Card Styles */
  .cl-card-{{ section.id }}.style-overlay {
    background: {{ section.settings.card_background }};
  }
  .cl-card-{{ section.id }}.style-minimal {
    background: transparent;
  }
  .cl-card-{{ section.id }}.style-bordered {
    background: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.border_color }};
  }
  .cl-card-{{ section.id }}.style-elevated {
    background: {{ section.settings.card_background }};
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  /* Card Hover */
  .cl-card-{{ section.id }}:hover {
    transform: translateY(-8px);
  }
  .cl-card-{{ section.id }}.style-elevated:hover {
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }
  .cl-card-{{ section.id }}.style-bordered:hover {
    border-color: {{ section.settings.accent_color }};
  }
  /* Card Image */
  .cl-card-image-{{ section.id }} {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
  }
  .cl-card-image-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .cl-card-{{ section.id }}:hover .cl-card-image-{{ section.id }} img {
    transform: scale(1.1);
  }
  /* Image Overlay Gradient */
  .cl-card-image-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      {{ section.settings.overlay_color }} 0%,
      {{ section.settings.overlay_color | color_modify: 'alpha', 0.3 }} 40%,
      transparent 100%
    );
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity 0.4s ease;
  }
  .cl-card-{{ section.id }}:hover .cl-card-image-{{ section.id }}::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 | plus: 0.2 }};
  }
  /* Card Content - Overlay Style */
  .cl-card-content-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    z-index: 2;
    transform: translateY(10px);
    transition: transform 0.4s ease;
  }
  .cl-card-{{ section.id }}:hover .cl-card-content-{{ section.id }} {
    transform: translateY(0);
  }
  /* Card Content - Below Image Style */
  .cl-card-{{ section.id }}.style-minimal .cl-card-content-{{ section.id }},
  .cl-card-{{ section.id }}.style-bordered .cl-card-content-{{ section.id }},
  .cl-card-{{ section.id }}.style-elevated .cl-card-content-{{ section.id }} {
    position: relative;
    padding: 20px 0 0 0;
    transform: none;
  }
  .cl-card-{{ section.id }}.style-bordered .cl-card-content-{{ section.id }},
  .cl-card-{{ section.id }}.style-elevated .cl-card-content-{{ section.id }} {
    padding: 20px;
  }
  /* Collection Title */
  .cl-card-title-{{ section.id }} {
    font-size: clamp(18px, 2.5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.2;
    transition: color 0.3s ease;
  }
  .cl-card-{{ section.id }}.style-overlay .cl-card-title-{{ section.id }} {
    color: #ffffff;
  }
  .cl-card-{{ section.id }}.style-minimal .cl-card-title-{{ section.id }},
  .cl-card-{{ section.id }}.style-bordered .cl-card-title-{{ section.id }},
  .cl-card-{{ section.id }}.style-elevated .cl-card-title-{{ section.id }} {
    color: {{ section.settings.heading_color }};
  }
  .cl-card-{{ section.id }}:hover .cl-card-title-{{ section.id }} {
    color: {{ section.settings.accent_color }};
  }
  .cl-card-{{ section.id }}.style-overlay:hover .cl-card-title-{{ section.id }} {
    color: #ffffff;
  }
  /* Product Count */
  .cl-card-count-{{ section.id }} {
    font-size: 13px;
    opacity: 0.7;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cl-card-{{ section.id }}.style-overlay .cl-card-count-{{ section.id }} {
    color: #ffffff;
  }
  .cl-card-{{ section.id }}.style-minimal .cl-card-count-{{ section.id }},
  .cl-card-{{ section.id }}.style-bordered .cl-card-count-{{ section.id }},
  .cl-card-{{ section.id }}.style-elevated .cl-card-count-{{ section.id }} {
    color: {{ section.settings.text_color }};
  }
  /* View Arrow */
  .cl-card-arrow-{{ section.id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: {{ section.settings.accent_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translate(10px, -10px) scale(0.8);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 3;
  }
  .cl-card-{{ section.id }}:hover .cl-card-arrow-{{ section.id }} {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  .cl-card-arrow-{{ section.id }} svg {
    width: 18px;
    height: 18px;
    color: #ffffff;
    stroke: #ffffff;
  }
  /* Accent Line */
  .cl-card-accent-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, {{ section.settings.accent_color }}, {{ section.settings.secondary_accent }});
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .cl-card-{{ section.id }}:hover .cl-card-accent-{{ section.id }} {
    transform: scaleX(1);
  }
  /* Placeholder */
  .cl-placeholder-{{ section.id }} {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: linear-gradient(135deg, #e5e7eb 0%, #f3f4f6 50%, #e5e7eb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cl-placeholder-{{ section.id }} svg {
    width: 48px;
    height: 48px;
    opacity: 0.3;
  }
  /* Masonry Height Variations */
  .cl-grid-{{ section.id }}.layout-masonry .cl-card-{{ section.id }}:nth-child(3n+1) .cl-card-image-{{ section.id }} {
    aspect-ratio: 3/4;
  }
  .cl-grid-{{ section.id }}.layout-masonry .cl-card-{{ section.id }}:nth-child(3n+2) .cl-card-image-{{ section.id }} {
    aspect-ratio: 1/1;
  }
  .cl-grid-{{ section.id }}.layout-masonry .cl-card-{{ section.id }}:nth-child(3n+3) .cl-card-image-{{ section.id }} {
    aspect-ratio: 4/5;
  }
  /* Animation */
  .cl-card-{{ section.id }} {
    opacity: 0;
    transform: translateY(30px);
    animation: clFadeIn 0.6s ease forwards;
  }
  .cl-card-{{ section.id }}:nth-child(1) { animation-delay: 0.05s; }
  .cl-card-{{ section.id }}:nth-child(2) { animation-delay: 0.1s; }
  .cl-card-{{ section.id }}:nth-child(3) { animation-delay: 0.15s; }
  .cl-card-{{ section.id }}:nth-child(4) { animation-delay: 0.2s; }
  .cl-card-{{ section.id }}:nth-child(5) { animation-delay: 0.25s; }
  .cl-card-{{ section.id }}:nth-child(6) { animation-delay: 0.3s; }
  .cl-card-{{ section.id }}:nth-child(7) { animation-delay: 0.35s; }
  .cl-card-{{ section.id }}:nth-child(8) { animation-delay: 0.4s; }
  @keyframes clFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Responsive */
  @media screen and (max-width: 749px) {
    .cl-header-{{ section.id }} {
      margin-bottom: 40px;
    }
    .cl-card-content-{{ section.id }} {
      padding: 20px;
    }
    .cl-decoration {
      display: none;
    }
    .cl-grid-{{ section.id }}.layout-bento {
      grid-template-columns: 1fr;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-{{ section.id }} {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .cl-grid-{{ section.id }}.layout-bento .cl-card-image-{{ section.id }} {
      aspect-ratio: 16/9;
    }
  }
{%- endstyle -%}
<section class="collections-section-{{ section.id }} section-{{ section.id }}-padding">
  
  {%- if section.settings.show_decorations -%}
    <div class="cl-decoration cl-decoration-1"></div>
    <div class="cl-decoration cl-decoration-2"></div>
  {%- endif -%}
  <div class="collections-container-{{ section.id }}">
    
    {%- if section.settings.show_header -%}
      <div class="cl-header-{{ section.id }} layout-{{ section.settings.header_layout }}">
        <div class="cl-header-content-{{ section.id }}">
          {%- if section.settings.kicker != blank or section.settings.badge_text != blank -%}
            {%- assign kicker_text = section.settings.kicker | default: section.settings.badge_text -%}
            <div class="cl-kicker-{{ section.id }} cl-kicker--{{ section.settings.kicker_style | default: 'text' }}-{{ section.id }}">
              {%- if section.settings.kicker_show_dot -%}
                <span class="kicker-pulse" aria-hidden="true"></span>
              {%- endif -%}
              <span>{{ kicker_text }}</span>
            </div>
          {%- endif -%}
          
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading }}</h2>
          {%- endif -%}
          
          {%- if section.settings.description != blank or section.settings.subtitle != blank -%}
            <div class="cl-description-{{ section.id }} cl-subtitle">
              {%- if section.settings.description != blank -%}
                {{ section.settings.description }}
              {%- else -%}
                <p>{{ section.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="cl-view-all-{{ section.id }}">
            {{ section.settings.view_all_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="cl-grid-{{ section.id }} layout-{{ section.settings.layout }}">
      
      {%- assign collections_to_show = section.settings.collections_list -%}
      {%- if collections_to_show == blank or collections_to_show.size == 0 -%}
        {%- assign collections_to_show = collections -%}
      {%- endif -%}
      {%- assign collection_limit = section.settings.collections_limit -%}
      {%- assign collection_count = 0 -%}
      {%- for collection in collections_to_show -%}
        {%- if collection_count < collection_limit -%}
          {%- assign collection_count = collection_count | plus: 1 -%}
          
          <a href="{{ collection.url }}" class="cl-card-{{ section.id }} style-{{ section.settings.card_style }}">
            
            <div class="cl-card-image-{{ section.id }}">
              {%- if collection.image != blank or collection.featured_image != blank -%}
                {%- assign collection_image = collection.image | default: collection.featured_image -%}
                <img 
                  src="{{ collection_image | image_url: width: 800 }}"
                  srcset="
                    {{ collection_image | image_url: width: 400 }} 400w,
                    {{ collection_image | image_url: width: 600 }} 600w,
                    {{ collection_image | image_url: width: 800 }} 800w,
                    {{ collection_image | image_url: width: 1000 }} 1000w
                  "
                  sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ collection.title | escape }}"
                  width="{{ collection_image.width }}"
                  height="{{ collection_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="cl-placeholder-{{ section.id }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>
            {%- if section.settings.show_arrow -%}
              <div class="cl-card-arrow-{{ section.id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              </div>
            {%- endif -%}
            <div class="cl-card-content-{{ section.id }}">
              <h3 class="cl-card-title-{{ section.id }}">{{ collection.title }}</h3>
              
              {%- comment -%}
              {%- if section.settings.show_product_count -%}
                <span class="cl-card-count-{{ section.id }}">
                  {{ collection.products_count }} 
                  {%- if collection.products_count == 1 -%}
                    {{ section.settings.product_singular }}
                  {%- else -%}
                    {{ section.settings.product_plural }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- endcomment -%}
            </div>
            {%- if section.settings.show_accent_line -%}
              <div class="cl-card-accent-{{ section.id }}"></div>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
