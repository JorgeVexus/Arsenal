{%- style -%}
  /* Control de Ancho y Variables de Sección */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.shopify-section {
    width: 100%;
    margin-left: 0 !important;
    margin-right: 0 !important;
    margin-top: {{ section.settings.margin_top | default: 0 }}px !important;
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px !important;
    display: block !important;
    position: relative;
    z-index: 2;
    background-color: {{ section.settings.background_color }};

    /* Variables Responsivas para Celular (Mobile First) */
    --marquee-speed: {{ section.settings.speed_mobile | default: section.settings.speed | default: 35 }}s;
    --marquee-gap: {{ section.settings.gap_mobile | default: 36 }}px;
    --marquee-logo-height: {{ section.settings.logo_height_mobile | default: 44 }}px;
    --marquee-fade-width: 10%;
  }

  /* Variables Responsivas para Escritorio (Desktop) */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }}.shopify-section {
      --marquee-speed: {{ section.settings.speed | default: 35 }}s;
      --marquee-gap: {{ section.settings.gap | default: 56 }}px;
      --marquee-logo-height: {{ section.settings.logo_height | default: 58 }}px;
      --marquee-fade-width: 7%;
    }
  }

  {% if section.settings.full_width %}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }}.shopify-section {
      width: 100vw !important;
      max-width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      box-sizing: border-box !important;
    }
  {% endif %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .arsenal-marquee-container-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .arsenal-marquee-header-{{ section.id }} {
    text-align: center;
    max-width: 900px;
    margin: 0 auto {{ section.settings.header_margin }}px auto;
    padding: 0 20px;
  }

  .arsenal-marquee-header-{{ section.id }} h2,
  .arsenal-marquee-header-{{ section.id }} h3 {
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .arsenal-marquee-header-{{ section.id }} .rich-text__text {
    word-break: break-word;
  }

  /* Contenedor del Marquee con Máscara Apple Style */
  .arsenal-marquee-wrapper-{{ section.id }} {
    overflow: hidden;
    position: relative;
    width: 100%;
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    align-items: center;
    {% if section.settings.fade_edges %}
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black var(--marquee-fade-width), black calc(100% - var(--marquee-fade-width)), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, black var(--marquee-fade-width), black calc(100% - var(--marquee-fade-width)), transparent 100%);
    {% endif %}
  }

  /* Pista que contiene los grupos */
  .arsenal-marquee-track-{{ section.id }} {
    display: flex;
    width: max-content;
    gap: var(--marquee-gap);
    align-items: center;
    will-change: transform;
  }

  /* Cada grupo se anima en paralelo de forma independiente (-100% - gap) */
  .arsenal-marquee-group-{{ section.id }} {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--marquee-gap);
    will-change: transform;
    animation: arsenal-marquee-slide-{{ section.settings.direction }}-{{ section.id }} var(--marquee-speed) linear infinite;
  }

  /* Pausa en hover y al tocar/presionar (Apple touch feel) */
  {% if section.settings.pause_on_hover %}
    @media (hover: hover) {
      .arsenal-marquee-wrapper-{{ section.id }}:hover .arsenal-marquee-group-{{ section.id }} {
        animation-play-state: paused;
      }
    }
    .arsenal-marquee-wrapper-{{ section.id }}:active .arsenal-marquee-group-{{ section.id }},
    .arsenal-marquee-wrapper-{{ section.id }}[data-paused="true"] .arsenal-marquee-group-{{ section.id }} {
      animation-play-state: paused;
    }
  {% endif %}

  .arsenal-marquee-item-{{ section.id }} {
    flex: 0 0 auto;
    width: auto;
    height: var(--marquee-logo-height);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
  }

  .arsenal-marquee-link-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .arsenal-marquee-item-{{ section.id }} img, 
  .arsenal-marquee-item-{{ section.id }} svg {
    height: calc(var(--marquee-logo-height) * var(--item-scale, 1));
    max-height: calc(var(--marquee-logo-height) * 1.35);
    max-width: none;
    width: auto;
    object-fit: contain;
    filter: {{ section.settings.logo_filter }};
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease, opacity 0.3s ease;
    display: block;
    pointer-events: auto;
    {% if section.settings.background_color == blank or section.settings.background_color == 'rgba(0,0,0,0)' or section.settings.background_color == '#ffffff' or section.settings.background_color == '#fff' %}
      mix-blend-mode: multiply;
    {% endif %}
  }

  {% if section.settings.hover_effect %}
    @media (hover: hover) {
      .arsenal-marquee-item-{{ section.id }}:hover img,
      .arsenal-marquee-item-{{ section.id }}:hover svg {
        transform: scale(1.08);
        filter: none;
      }
    }
  {% endif %}

  /* Keyframe continuo matemáticamente exacto: Dirección Izquierda */
  @keyframes arsenal-marquee-slide-left-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(calc(-100% - var(--marquee-gap)), 0, 0);
    }
  }

  /* Keyframe continuo matemáticamente exacto: Dirección Derecha */
  @keyframes arsenal-marquee-slide-right-{{ section.id }} {
    0% {
      transform: translate3d(calc(-100% - var(--marquee-gap)), 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Modo accesibilidad: Respetar preferencia de reducción de movimiento */
  @media (prefers-reduced-motion: reduce) {
    .arsenal-marquee-group-{{ section.id }} {
      animation: none !important;
    }
    .arsenal-marquee-wrapper-{{ section.id }} {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .arsenal-marquee-wrapper-{{ section.id }}::-webkit-scrollbar {
      display: none;
    }
  }
{%- endstyle -%}

<div class="arsenal-marquee-container-{{ section.id }} section-{{ section.id }}-padding" id="ArsenalMarquee-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="arsenal-marquee-header-{{ section.id }}">
      <div class="rich-text__text rte">
        {{ section.settings.heading }}
      </div>
    </div>
  {%- endif -%}

  {%- assign repeat_count = 4 -%}
  {%- if section.blocks.size < 5 -%}
    {%- assign repeat_count = 6 -%}
  {%- endif -%}

  <div class="arsenal-marquee-wrapper-{{ section.id }}" data-marquee-wrapper>
    <div class="arsenal-marquee-track-{{ section.id }}">
      {%- for i in (1..repeat_count) -%}
        <div class="arsenal-marquee-group-{{ section.id }}" {% if i > 1 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign item_scale = block.settings.scale | default: 100 | divided_by: 100.0 -%}
            <div 
              class="arsenal-marquee-item-{{ section.id }}" 
              {{ block.shopify_attributes }}
              style="--item-scale: {{ item_scale }};"
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="arsenal-marquee-link-{{ section.id }}" target="_blank" rel="noopener">
              {%- endif -%}

              {%- if block.settings.asset_image != blank -%}
                <img 
                  src="{{ block.settings.asset_image | asset_url }}" 
                  alt="{{ block.settings.asset_image | split: '.' | first | escape }}"
                  class="arsenal-marquee-logo"
                  loading="eager"
                  width="auto"
                  height="auto"
                >
              {%- elsif block.settings.image != blank -%}
                {%- assign logo_alt = block.settings.image.alt | default: 'Logo' | escape -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: 
                  loading: 'eager',
                  widths: '150, 300, 400',
                  alt: logo_alt,
                  class: 'arsenal-marquee-logo'
                }}
              {%- else -%}
                <div style="width: 100px; height: 50px; background: rgba(0,0,0,0.06); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #888; font-size: 11px; font-weight: 600; letter-spacing: 0.05em;">LOGO</div>
              {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var wrapper = document.querySelector('#ArsenalMarquee-{{ section.id }} [data-marquee-wrapper]');
    if (!wrapper) return;
    function pause() { wrapper.setAttribute('data-paused', 'true'); }
    function resume() { wrapper.removeAttribute('data-paused'); }
    wrapper.addEventListener('pointerdown', pause, { passive: true });
    wrapper.addEventListener('pointerup', resume, { passive: true });
    wrapper.addEventListener('pointercancel', resume, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Arsenal Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho Completo (Full Width 100vw)",
      "default": true
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Título",
      "default": "<p>Nuestras Marcas Asociadas</p>"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior del título",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de Fondo",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Dirección del movimiento",
      "options": [
        {
          "value": "left",
          "label": "Hacia la Izquierda"
        },
        {
          "value": "right",
          "label": "Hacia la Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "Desvanecimiento elegante en bordes (Apple style)",
      "default": true
    },
    {
      "type": "header",
      "content": "Velocidad y Tiempos de Animación"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Velocidad en Escritorio (Segundos por ciclo)",
      "info": "Mayor tiempo = movimiento más suave y pausado.",
      "default": 35
    },
    {
      "type": "range",
      "id": "speed_mobile",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Velocidad en Celular / Móvil (Segundos por ciclo)",
      "info": "Permite ajustar la velocidad en pantallas táctiles de forma independiente.",
      "default": 35
    },
    {
      "type": "header",
      "content": "Tamaño de Logos y Espaciado"
    },
    {
      "type": "range",
      "id": "slot_width",
      "min": 100,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Ancho uniforme de cada logo en Escritorio",
      "info": "Garantiza una distribución rítmica y espaciado idéntico de centro a centro.",
      "default": 175
    },
    {
      "type": "range",
      "id": "slot_width_mobile",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Ancho uniforme de cada logo en Celular",
      "info": "Distribuye el espacio de forma uniforme en pantallas táctiles.",
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Altura máx. de logos en Escritorio",
      "default": 75
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Altura máx. de logos en Celular",
      "default": 55
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Espacio entre logos en Escritorio",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Espacio entre logos en Celular",
      "info": "Recomendado 20-35px para un ritmo visual balanceado.",
      "default": 28
    },
    {
      "type": "header",
      "content": "Filtros y Efectos Visuales"
    },
    {
      "type": "select",
      "id": "logo_filter",
      "label": "Filtro de Color de Logos",
      "options": [
        {
          "value": "none",
          "label": "Ninguno (Color Original)"
        },
        {
          "value": "grayscale(100%)",
          "label": "Escala de Grises"
        },
        {
          "value": "brightness(0) invert(1)",
          "label": "Blanco Puro (Invert)"
        },
        {
          "value": "brightness(0)",
          "label": "Negro Puro"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar al interactuar (Hover en PC / Tocar en Celular)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Efecto zoom interactivo en logo",
      "default": true
    },
    {
      "type": "header",
      "content": "Espaciado Interno (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Inferior",
      "default": 40
    },
    {
      "type": "header",
      "content": "Márgenes Exteriores"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen Superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen Inferior",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del Logo"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Archivo PNG recortado en Assets (Opcional)",
          "info": "Ejemplo: cert-anab.png. Elimina márgenes blancos automáticos y asegura máxima nitidez."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (Opcional)"
        },
        {
          "type": "range",
          "id": "scale",
          "min": 50,
          "max": 160,
          "step": 5,
          "unit": "%",
          "label": "Escala visual del logo",
          "default": 100,
          "info": "Ajusta el tamaño óptico si este logo se ve más pequeño o más grande que los demás."
        },
        {
          "type": "range",
          "id": "custom_slot_width",
          "min": 0,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "Ancho de slot personalizado (Opcional)",
          "default": 0,
          "info": "Déjalo en 0 para usar el ancho uniforme automático de la sección."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arsenal Marquee",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
