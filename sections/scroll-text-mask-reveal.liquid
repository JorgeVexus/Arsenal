{% comment %}
  Scroll Text Mask Reveal
  SVG con logo recortado que hace zoom out al scroll para revelar video/imagen.
  Efecto tipo KippoApp pero invertido (reveal al hacer scroll down).
  @author: Jorge Cerna - Vexus
{% endcomment %}

{%- style -%}
  /* ═════════════════════════════════════════════════
     SCROLL MASK REVEAL — {{ section.id }}
     ═════════════════════════════════════════════════ */

  :root {
    --smr-easing: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* === SECTION CONTAINER === */
  .smr-section-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 120vh; /* Espacio de scroll para la animación */
    background: {{ section.settings.background_color | default: '#0a0a0a' }};
  }

  /* === STICKY CONTAINER === */
  .smr-sticky-{{ section.id }} {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* === END SPACER (evita el espacio negro al final) === */
  .smr-spacer-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    pointer-events: none;
  }

  /* Full width option */
  {% if section.settings.full_width %}
  #shopify-section-{{ section.id }}.shopify-section {
    width: 100vw !important;
    position: relative !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
  }
  {% endif %}

  /* === BACKGROUND LAYER (Video/Image) === */
  .smr-bg-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    transform: scale(var(--smr-bg-scale, 1.2));
    transition: transform 0.1s linear;
  }

  .smr-bg-{{ section.id }} img,
  .smr-bg-{{ section.id }} video,
  .smr-bg-{{ section.id }} .smr-bg-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Desktop/Mobile image visibility */
  .smr-bg-desktop-{{ section.id }},
  .smr-bg-mobile-{{ section.id }} {
    width: 100%;
    height: 100%;
  }

  .smr-bg-mobile-{{ section.id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .smr-bg-desktop-{{ section.id }} {
      display: none;
    }
    .smr-bg-mobile-{{ section.id }} {
      display: block;
    }
  }

  .smr-bg-{{ section.id }} .smr-bg-placeholder {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  }

  /* === DARK OVERLAY (para mejorar legibilidad) === */
  .smr-bg-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: var(--smr-overlay-opacity, 0.3);
    transition: opacity 0.1s linear;
    pointer-events: none;
  }

  /* === SVG MASK LAYER === */
  .smr-mask-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transform: scale(var(--smr-mask-scale, 1));
    transform-origin: center center;
    will-change: transform;
  }

  .smr-mask-{{ section.id }} svg {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
  }

  .smr-svg-text-{{ section.id }} {
    font-size: {{ section.settings.svg_font_size | default: 20 }}px;
  }

  @media screen and (max-width: 749px) {
    .smr-svg-text-{{ section.id }} {
      font-size: {{ section.settings.svg_font_size_mobile | default: 30 }}px;
    }
  }

  /* El rectángulo blanco con el texto recortado */
  .smr-mask-{{ section.id }} .mask-rect {
    fill: {{ section.settings.mask_background | default: '#ffffff' }};
  }

  /* === SCROLL HINT === */
  .smr-scroll-hint-{{ section.id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: var(--smr-hint-opacity, 1);
    transition: opacity 0.5s var(--smr-easing);
    pointer-events: none;
  }

  .smr-scroll-hint-{{ section.id }} span {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: {{ section.settings.scroll_hint_color }};
    font-weight: 600;
  }

  .smr-scroll-hint-{{ section.id }} .smr-scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, {{ section.settings.scroll_hint_color }}, transparent);
    animation: smr-bounce-{{ section.id }} 2s ease-in-out infinite;
  }

  @keyframes smr-bounce-{{ section.id }} {
    0%, 100% { opacity: 1; transform: scaleY(1); }
    50% { opacity: 0.4; transform: scaleY(0.6); }
  }

  /* === GRAIN TEXTURE === */
  {% if section.settings.show_grain %}
  .smr-grain-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: {{ section.settings.grain_opacity }};
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }
  {% endif %}

  /* === REDUCED MOTION === */
  @media (prefers-reduced-motion: reduce) {
    .smr-mask-{{ section.id }},
    .smr-bg-{{ section.id }},
    .smr-scroll-hint-{{ section.id }} {
      transition: none !important;
    }
    
    .smr-mask-{{ section.id }} {
      transform: scale(15) !important;
      opacity: 0 !important;
    }
    
    .smr-scroll-hint-{{ section.id }} {
      display: none !important;
    }
  }
{%- endstyle -%}

{%- comment -%} ══════ HTML ══════ {%- endcomment -%}
<div 
  class="smr-section-{{ section.id }}" 
  id="smr-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-start-scale="{{ section.settings.start_scale | default: 1 }}"
  data-end-scale="{{ section.settings.end_scale | default: 15 }}"
  data-bg-start-scale="{{ section.settings.bg_start_scale | default: 1 }}"
  data-bg-end-scale="{{ section.settings.bg_end_scale | default: 1.3 }}"
>
  <div class="smr-sticky-{{ section.id }}">
    
    {%- comment -%} Spacer para marcar el final del scroll {%- endcomment -%}
    <div class="smr-spacer-{{ section.id }}" id="smr-spacer-{{ section.id }}"></div>
    
    {%- comment -%} Layer 1: Background Video/Image {%- endcomment -%}
    <div class="smr-bg-{{ section.id }}" id="smr-bg-{{ section.id }}">
      {%- if section.settings.video_url != blank -%}
        <video 
          id="smr-video-{{ section.id }}"
          autoplay 
          muted 
          loop 
          playsinline
          poster="{{ section.settings.image | image_url: width: 2000 }}"
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image != blank -%}
        {%- comment -%} Desktop Image {%- endcomment -%}
        <div class="smr-bg-desktop-{{ section.id }}">
          {{ section.settings.image | image_url: width: 3000 | image_tag:
            loading: 'eager',
            widths: '750, 1100, 1500, 2000, 3000',
            sizes: '100vw',
            alt: section.settings.image.alt | default: section.settings.heading
          }}
        </div>
        {%- comment -%} Mobile Image {%- endcomment -%}
        {%- if section.settings.mobile_image != blank -%}
          <div class="smr-bg-mobile-{{ section.id }}">
            {{ section.settings.mobile_image | image_url: width: 1500 | image_tag:
              loading: 'eager',
              widths: '750, 1100, 1500',
              sizes: '100vw',
              alt: section.settings.mobile_image.alt | default: section.settings.heading
            }}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="smr-bg-placeholder"></div>
      {%- endif -%}
    </div>

    {%- comment -%} Layer 2: Dark Overlay {%- endcomment -%}
    <div class="smr-bg-overlay-{{ section.id }}" id="smr-overlay-{{ section.id }}"></div>

    {%- comment -%} Layer 3: SVG Mask with Logo Cutout {%- endcomment -%}
    <div class="smr-mask-{{ section.id }}" id="smr-mask-{{ section.id }}">
      <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
        <defs>
          <mask id="logo-mask-{{ section.id }}">
            {%- comment -%} Todo blanco = visible, negro = transparente {%- endcomment -%}
            <rect width="100" height="100" fill="white"/>
            <text 
              x="50" 
              y="55" 
              text-anchor="middle" 
              font-family="{{ section.settings.font_family | default: 'Impact, Arial Black, sans-serif' }}"
              font-weight="{{ section.settings.font_weight | default: 900 }}"
              class="smr-svg-text-{{ section.id }}"
              letter-spacing="{{ section.settings.letter_spacing | default: 0.05 }}em"
              fill="black"
            >{{ section.settings.heading | default: 'ARSENAL' }}</text>
          </mask>
        </defs>
        {%- comment -%} Rectángulo blanco con máscara del logo {%- endcomment -%}
        <rect 
          class="mask-rect"
          width="100" 
          height="100" 
          mask="url(#logo-mask-{{ section.id }})"
        />
      </svg>
    </div>

    {%- comment -%} Grain Texture {%- endcomment -%}
    {%- if section.settings.show_grain -%}
      <div class="smr-grain-{{ section.id }}"></div>
    {%- endif -%}

    {%- comment -%} Scroll Hint {%- endcomment -%}
    {%- if section.settings.show_scroll_hint -%}
      <div class="smr-scroll-hint-{{ section.id }}" id="smr-hint-{{ section.id }}">
        <span>{{ section.settings.scroll_hint_text }}</span>
        <div class="smr-scroll-line"></div>
      </div>
    {%- endif -%}

  </div>
</div>

{%- comment -%} ══════ JAVASCRIPT ══════ {%- endcomment -%}
<script>
(function() {
  'use strict';

  const SECTION_ID = '{{ section.id }}';
  const container = document.getElementById('smr-' + SECTION_ID);
  
  if (!container) return;

  // Configuration
  const config = {
    startScale: parseFloat(container.dataset.startScale) || 1,
    endScale: parseFloat(container.dataset.endScale) || 15,
    bgStartScale: parseFloat(container.dataset.bgStartScale) || 1,
    bgEndScale: parseFloat(container.dataset.bgEndScale) || 1.3,
    animStart: 0.05,     // 5% - animation starts
    animEnd: 0.65       // 65% - mask fully zoomed in
  };

  // Elements
  const mask = document.getElementById('smr-mask-' + SECTION_ID);
  const overlay = document.getElementById('smr-overlay-' + SECTION_ID);
  const hint = document.getElementById('smr-hint-' + SECTION_ID);
  const video = document.getElementById('smr-video-' + SECTION_ID);

  // State
  let rafId = null;
  let isActive = false;

  // Easing function (ease-out-cubic)
  function easeOutCubic(t) {
    return 1 - Math.pow(1 - t, 3);
  }

  // Easing function (ease-in-out-cubic) for smoother feel
  function easeInOutCubic(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  // Apply animation based on progress (0-1)
  function applyAnimation(progress) {
    const p = Math.max(0, Math.min(1, progress));
    
    // Calculate mask scale - starts normal (1), zooms IN to endScale
    let maskScale;
    if (p <= config.animEnd) {
      const animProgress = Math.max(0, (p - config.animStart) / (config.animEnd - config.animStart));
      const eased = easeOutCubic(Math.min(1, animProgress));
      maskScale = config.startScale + (config.endScale - config.startScale) * eased;
    } else {
      maskScale = config.endScale;
    }
    
    // Calculate background scale - subtle zoom in (parallax effect)
    const bgProgress = Math.min(1, p / config.animEnd);
    const bgEased = easeOutCubic(bgProgress);
    const bgScale = config.bgStartScale + (config.bgEndScale - config.bgStartScale) * bgEased;
    
    // Calculate overlay opacity - increases as mask zooms in (para legibilidad)
    const overlayOpacity = Math.min(0.5, p * 0.7);
    
    // Calculate hint opacity - desaparece más rápido
    const hintOpacity = Math.max(0, 1 - p * 4);

    // Apply transforms using CSS custom properties
    container.style.setProperty('--smr-mask-scale', maskScale);
    container.style.setProperty('--smr-bg-scale', bgScale);
    container.style.setProperty('--smr-overlay-opacity', overlayOpacity);
    container.style.setProperty('--smr-hint-opacity', hintOpacity);

    // Control video playback based on visibility
    if (video) {
      if (p > 0.05 && p < 0.95) {
        if (video.paused) video.play();
      } else {
        if (!video.paused) video.pause();
      }
    }
  }

  // Handle scroll
  function handleScroll() {
    if (rafId) return;
    
    rafId = requestAnimationFrame(() => {
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const sectionHeight = container.offsetHeight;
      
      // Check if section is visible
      const isVisible = rect.top < viewportHeight && rect.bottom > 0;
      
      if (!isVisible) {
        rafId = null;
        return;
      }

      // Calculate progress based on scroll position within the section
      // 0 = top of section at top of viewport
      // 1 = scrolled through entire section
      const scrolled = -rect.top;
      const scrollable = sectionHeight - viewportHeight;
      const progress = Math.max(0, Math.min(1, scrolled / scrollable));
      
      applyAnimation(progress);
      
      rafId = null;
    });
  }

  // Intersection Observer to start/stop tracking
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        isActive = true;
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll(); // Initial call
      } else {
        isActive = false;
        window.removeEventListener('scroll', handleScroll);
      }
    });
  }, {
    root: null,
    rootMargin: '10% 0px 10% 0px',
    threshold: 0
  });

  observer.observe(container);

  // Initial state
  applyAnimation(0);

  // Cleanup
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.detail.sectionId === SECTION_ID) {
      observer.disconnect();
      window.removeEventListener('scroll', handleScroll);
      if (rafId) cancelAnimationFrame(rafId);
    }
  });

  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail.sectionId === SECTION_ID) {
      applyAnimation(0);
      observer.observe(container);
    }
  });
})();
</script>

{% schema %}
{
  "name": "scroll mask",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "━━ Layout ━━"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo (edge-to-edge)",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#0a0a0a"
    },
    {
      "type": "header",
      "content": "━━ Contenido del Logo (Máscara) ━━"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Texto del logo",
      "default": "ARSENAL",
      "info": "Texto que se usará como máscara. Corto y en mayúsculas funciona mejor."
    },
    {
      "type": "range",
      "id": "svg_font_size",
      "label": "Tamaño del texto en SVG (Desktop)",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20,
      "info": "Ajusta según la longitud del texto"
    },
    {
      "type": "range",
      "id": "svg_font_size_mobile",
      "label": "Tamaño del texto en SVG (Mobile)",
      "min": 10,
      "max": 50,
      "step": 2,
      "default": 30,
      "info": "Tamaño del texto para móvil. Mayor número = texto más grande."
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Peso de fuente",
      "min": 700,
      "max": 900,
      "step": 100,
      "default": 900
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Fuente (CSS)",
      "default": "Impact, Arial Black, sans-serif",
      "info": "Debe ser una fuente del sistema o cargada en el tema"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Espaciado entre letras (em)",
      "min": -0.1,
      "max": 0.5,
      "step": 0.1,
      "default": 0.1
    },
    {
      "type": "header",
      "content": "━━ Fondo (Video/Imagen) ━━"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen de fondo (Mobile)",
      "info": "Opcional - Imagen vertical para móvil. Si está vacío usa la imagen desktop."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL del video (MP4)",
      "info": "Si se proporciona, se usa en lugar de la imagen. Sube el video a Files."
    },
    {
      "type": "range",
      "id": "bg_start_scale",
      "label": "Escala inicial del fondo",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "info": "Zoom inicial de la imagen/video. 1 = normal, 1.5 = 50% más grande"
    },
    {
      "type": "range",
      "id": "bg_end_scale",
      "label": "Escala final del fondo",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.3,
      "info": "Zoom final de la imagen/video. Efecto parallax durante el scroll"
    },
    {
      "type": "header",
      "content": "━━ Extras ━━"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Mostrar indicador de scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_hint_text",
      "label": "Texto del indicador",
      "default": "Scroll"
    },
    {
      "type": "color",
      "id": "scroll_hint_color",
      "label": "Color del indicador",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Efecto grain sobre la imagen",
      "default": false
    },
    {
      "type": "range",
      "id": "grain_opacity",
      "label": "Opacidad del grain",
      "min": 0.1,
      "max": 0.5,
      "step": 0.1,
      "default": 0.2
    }
  ],
  "presets": [
    {
      "name": "scroll mask",
      "category": "Arsenal"
    }
  ]
}
{% endschema %}
