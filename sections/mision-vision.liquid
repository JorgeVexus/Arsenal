{%- style -%}
  /* Base Section Styles */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  /* Mission Vision Section */
  .mission-vision-section-{{ section.id }} {
    position: relative;
    background: {{ section.settings.background_color }};
    overflow: hidden;
  }
  /* Background Image Overlay */
  .mission-vision-section-{{ section.id }}.has-background-image {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .mission-vision-section-{{ section.id }} .mv-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }
  /* Decorative Elements */
  .mission-vision-section-{{ section.id }} .mv-decoration {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    pointer-events: none;
  }
  .mission-vision-section-{{ section.id }} .mv-decoration-1 {
    width: 400px;
    height: 400px;
    background: {{ section.settings.accent_color }};
    top: -150px;
    right: -100px;
  }
  .mission-vision-section-{{ section.id }} .mv-decoration-2 {
    width: 300px;
    height: 300px;
    background: {{ section.settings.secondary_accent }};
    bottom: -100px;
    left: -50px;
  }
  /* Container */
  .mission-vision-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }
  /* Section Header */
  .mv-header-{{ section.id }} {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 60px;
  }
  .mv-header-{{ section.id }} .mv-badge {
    display: inline-block;
    padding: 8px 20px;
    background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
    color: {{ section.settings.accent_color }};
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
  }
  .mv-header-{{ section.id }} h2 {
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 15px 0;
    line-height: 1.2;
  }
  .mv-header-{{ section.id }} .mv-subtitle {
    font-size: clamp(16px, 2vw, 18px);
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .mv-header-{{ section.id }}.left .mv-subtitle {
    margin: 0;
  }
  /* Grid Layout */
  .mv-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  @media screen and (min-width: 990px) {
    .mv-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.cards_gap }}px;
    }
  }
  /* Cards */
  .mv-card-{{ section.id }} {
    position: relative;
    padding: {{ section.settings.card_padding }}px;
    border-radius: {{ section.settings.card_border_radius }}px;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow: hidden;
  }
  /* Card Styles */
  .mv-card-{{ section.id }}.style-glassmorphism {
    background: {{ section.settings.card_background | color_modify: 'alpha', 0.7 }};
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid {{ section.settings.card_border_color | color_modify: 'alpha', 0.2 }};
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }
  .mv-card-{{ section.id }}.style-solid {
    background: {{ section.settings.card_background }};
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    border: 1px solid {{ section.settings.card_border_color | color_modify: 'alpha', 0.1 }};
  }
  .mv-card-{{ section.id }}.style-gradient {
    background: linear-gradient(135deg, {{ section.settings.card_background }} 0%, {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }} 100%);
    border: 1px solid {{ section.settings.card_border_color | color_modify: 'alpha', 0.15 }};
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  .mv-card-{{ section.id }}.style-outlined {
    background: transparent;
    border: 2px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};
  }
  /* Card Hover Effects */
  .mv-card-{{ section.id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }
  .mv-card-{{ section.id }}.style-glassmorphism:hover {
    border-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
  }
  /* Card Accent Line */
  .mv-card-{{ section.id }} .mv-card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, {{ section.settings.accent_color }}, {{ section.settings.secondary_accent }});
    border-radius: {{ section.settings.card_border_radius }}px {{ section.settings.card_border_radius }}px 0 0;
  }
  /* Icon Container */
  .mv-icon-wrapper-{{ section.id }} {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    border-radius: {{ section.settings.icon_border_radius }}px;
    transition: all 0.3s ease;
  }
  .mv-icon-wrapper-{{ section.id }}.icon-style-filled {
    background: linear-gradient(135deg, {{ section.settings.accent_color }}, {{ section.settings.secondary_accent }});
    box-shadow: 0 8px 25px {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};
  }
  .mv-icon-wrapper-{{ section.id }}.icon-style-outlined {
    background: transparent;
    border: 2px solid {{ section.settings.accent_color }};
  }
  .mv-icon-wrapper-{{ section.id }}.icon-style-soft {
    background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  }
  .mv-icon-wrapper-{{ section.id }} svg {
    width: {{ section.settings.icon_size | times: 0.5 }}px;
    height: {{ section.settings.icon_size | times: 0.5 }}px;
  }
  .mv-icon-wrapper-{{ section.id }}.icon-style-filled svg {
    color: #ffffff;
    stroke: #ffffff;
  }
  .mv-icon-wrapper-{{ section.id }}.icon-style-outlined svg,
  .mv-icon-wrapper-{{ section.id }}.icon-style-soft svg {
    color: {{ section.settings.accent_color }};
    stroke: {{ section.settings.accent_color }};
  }
  .mv-card-{{ section.id }}:hover .mv-icon-wrapper-{{ section.id }} {
    transform: scale(1.1) rotate(5deg);
  }
  /* Card Content */
  .mv-card-title-{{ section.id }} {
    font-size: clamp(20px, 3vw, {{ section.settings.title_font_size }}px);
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 15px 0;
    line-height: 1.3;
  }
  .mv-card-text-{{ section.id }} {
    font-size: {{ section.settings.text_font_size }}px;
    color: {{ section.settings.card_text_color }};
    line-height: 1.7;
    margin: 0;
    opacity: 0.9;
  }
  /* Divider Line */
  .mv-card-divider-{{ section.id }} {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, {{ section.settings.accent_color }}, {{ section.settings.secondary_accent }});
    border-radius: 2px;
    margin: 20px 0;
  }
  /* Animation on Scroll */
  .mv-card-{{ section.id }} {
    opacity: 0;
    transform: translateY(30px);
    animation: mvFadeInUp 0.6s ease forwards;
  }
  .mv-card-{{ section.id }}:nth-child(1) { animation-delay: 0.1s; }
  .mv-card-{{ section.id }}:nth-child(2) { animation-delay: 0.3s; }
  @keyframes mvFadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Responsive Adjustments */
  @media screen and (max-width: 749px) {
    .mv-header-{{ section.id }} {
      margin-bottom: 40px;
    }
    .mv-card-{{ section.id }} {
      padding: 30px;
    }
    .mv-decoration-1, .mv-decoration-2 {
      display: none;
    }
  }
{%- endstyle -%}
<section 
  class="mission-vision-section-{{ section.id }} section-{{ section.id }}-padding {% if section.settings.background_image != blank %}has-background-image{% endif %}"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"
  {% endif %}
>
  {%- if section.settings.show_overlay -%}
    <div class="mv-overlay"></div>
  {%- endif -%}
  {%- if section.settings.show_decorations -%}
    <div class="mv-decoration mv-decoration-1"></div>
    <div class="mv-decoration mv-decoration-2"></div>
  {%- endif -%}
  <div class="mission-vision-container-{{ section.id }}">
    
    {%- if section.settings.show_header -%}
      <div class="mv-header-{{ section.id }} {{ section.settings.header_alignment }}">
        {%- if section.settings.badge_text != blank -%}
          <span class="mv-badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
        
        {%- if section.settings.section_heading != blank -%}
          <h2>{{ section.settings.section_heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.section_subtitle != blank -%}
          <p class="mv-subtitle">{{ section.settings.section_subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="mv-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="mv-card-{{ section.id }} style-{{ section.settings.card_style }}" {{ block.shopify_attributes }}>
          
          {%- if section.settings.show_accent_line -%}
            <div class="mv-card-accent"></div>
          {%- endif -%}
          <div class="mv-icon-wrapper-{{ section.id }} icon-style-{{ section.settings.icon_style }}">
            {%- if block.settings.icon == 'mission' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            {%- elsif block.settings.icon == 'vision' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            {%- elsif block.settings.icon == 'values' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            {%- elsif block.settings.icon == 'heart' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            {%- elsif block.settings.icon == 'rocket' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
              </svg>
            {%- elsif block.settings.icon == 'lightbulb' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18h6"/>
                <path d="M10 22h4"/>
                <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>
              </svg>
            {%- elsif block.settings.icon == 'compass' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
            {%- elsif block.settings.icon == 'flag' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                <line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
            {%- endif -%}
          </div>
          <h3 class="mv-card-title-{{ section.id }}">{{ block.settings.title }}</h3>
          
          {%- if section.settings.show_divider -%}
            <div class="mv-card-divider-{{ section.id }}"></div>
          {%- endif -%}
          
          <p class="mv-card-text-{{ section.id }}">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
