{% comment %}
Shop the Look Interactive - Profile Solutions
Section with interactive hotspots revealing tactical profile solution cards (Tagline, Title, Description, CTA).
Designed with Apple Design principles and fluid micro-animations.
@author: Jorge Cerna / Vexus & Antigravity
{% endcomment %}

{%- liquid
  assign accent_color = section.settings.accent_color | default: '#ea5c10'
-%}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

#shopify-section-{{ section.id }} {
  position: relative;
  overflow: hidden;
  background-color: {{ section.settings.bg_color | default: '#09090b' }};
}

.stl-section-{{ section.id }} {
  --stl-accent: {{ accent_color }};
  --stl-card-bg: rgba(12, 12, 14, 0.92);
  --stl-card-border: {{ accent_color }};
  --stl-text-main: #ffffff;
  --stl-text-muted: #a1a1aa;
  --stl-radius: 16px;
  --stl-ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --stl-duration: 320ms;
  position: relative;
  width: 100%;
  margin: 0 auto;
}

.stl-header-{{ section.id }} {
  margin-bottom: 28px;
  text-align: center;
  padding: 0 20px;
}

.stl-header-{{ section.id }} .stl-tagline {
  display: inline-block;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--stl-accent);
  margin-bottom: 8px;
}

.stl-header-{{ section.id }} .stl-title {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 900;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0;
  text-transform: uppercase;
  line-height: 1.15;
}

/* Image & Scene Stage */
.stl-stage-{{ section.id }} {
  position: relative;
  width: 100%;
  line-height: 0;
  user-select: none;
  overflow: hidden;
  border-radius: 0;
}

.stl-main-img-{{ section.id }} {
  width: 100%;
  height: auto;
  min-height: 480px;
  object-fit: cover;
  display: block;
  transition: filter 0.4s ease;
}

@media screen and (max-width: 749px) {
  .stl-main-img-{{ section.id }} {
    min-height: 520px;
    object-position: center 20%;
  }
}

/* Hotspots Container */
.stl-hotspots-container-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

/* Hotspot Trigger Button (Touch-optimized 44x44 target) */
.stl-hotspot-btn-{{ section.id }} {
  position: absolute;
  top: var(--top);
  left: var(--left);
  width: 44px;
  height: 44px;
  margin-top: -22px;
  margin-left: -22px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  pointer-events: auto;
  z-index: 12;
  outline: none;
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.25s var(--stl-ease-spring);
}

.stl-hotspot-btn-{{ section.id }}:focus-visible {
  outline: 2px solid var(--stl-accent);
  outline-offset: 4px;
  border-radius: 50%;
}

.stl-hotspot-btn-{{ section.id }}:active {
  transform: scale(0.92);
}

/* Hotspot Visual Marker */
.stl-hotspot-marker {
  position: relative;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--stl-accent);
  border: 2.5px solid #ffffff;
  box-shadow: 0 0 12px rgba(0, 0, 0, 0.5), 0 0 16px var(--stl-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s var(--stl-ease-spring);
}

/* Marker Inner Dot */
.stl-hotspot-dot {
  width: 6px;
  height: 6px;
  background: #ffffff;
  border-radius: 50%;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.25s var(--stl-ease-spring);
}

/* Marker Pulsing Rings */
.stl-hotspot-marker::before {
  content: '';
  position: absolute;
  top: -6px;
  left: -6px;
  right: -6px;
  bottom: -6px;
  border-radius: 50%;
  border: 1.5px solid var(--stl-accent);
  opacity: 0.75;
  animation: stlPulse 2.4s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  pointer-events: none;
}

.stl-hotspot-marker::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  background: var(--stl-accent);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: stlAura 2.4s cubic-bezier(0.25, 1, 0.5, 1) infinite 0.6s;
  opacity: 0;
  z-index: -1;
  pointer-events: none;
}

@keyframes stlPulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  60% { transform: scale(2.0); opacity: 0; }
  100% { transform: scale(2.0); opacity: 0; }
}

@keyframes stlAura {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
  70% { transform: translate(-50%, -50%) scale(2.8); opacity: 0; }
  100% { transform: translate(-50%, -50%) scale(2.8); opacity: 0; }
}

/* Active Hotspot State (Dual Ring / Solid Center as in Reference Image) */
.stl-hotspot-btn-{{ section.id }}.is-active .stl-hotspot-marker {
  width: 34px;
  height: 34px;
  background: var(--stl-accent);
  border: 3.5px solid #ffffff;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.8), 0 0 25px var(--stl-accent);
}

.stl-hotspot-btn-{{ section.id }}.is-active .stl-hotspot-dot {
  width: 10px;
  height: 10px;
  opacity: 1;
  transform: scale(1);
  background: #ffffff;
}

.stl-hotspot-btn-{{ section.id }}.is-active .stl-hotspot-marker::before {
  animation: none;
  opacity: 0;
}

.stl-hotspot-btn-{{ section.id }}.is-active .stl-hotspot-marker::after {
  animation: stlActiveRing 1.8s ease-out infinite;
}

@keyframes stlActiveRing {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
  100% { transform: translate(-50%, -50%) scale(2.2); opacity: 0; }
}

/* Profile Information Card (Apple Materials & Obsidian Glass) */
.stl-card-container-{{ section.id }} {
  position: absolute;
  z-index: 20;
  pointer-events: auto;
  display: grid;
  grid-template-areas: "card";
  align-items: end;
  justify-items: end;
}

/* Docked Positions Desktop */
.stl-card-pos-bottom-right {
  bottom: 36px;
  right: 36px;
  justify-items: end;
}

.stl-card-pos-bottom-left {
  bottom: 36px;
  left: 36px;
  justify-items: start;
}

.stl-card-pos-top-right {
  top: 36px;
  right: 36px;
  justify-items: end;
  align-items: start;
}

.stl-card-pos-top-left {
  top: 36px;
  left: 36px;
  justify-items: start;
  align-items: start;
}

/* Floating Card Mode */
.stl-card-pos-floating {
  position: absolute;
  transition: top 0.35s var(--stl-ease-spring), left 0.35s var(--stl-ease-spring);
}

.stl-profile-card-{{ section.id }} {
  grid-area: card;
  width: 100%;
  max-width: 380px;
  min-width: 290px;
  background: var(--stl-card-bg);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1.5px solid var(--stl-card-border);
  border-radius: var(--stl-radius);
  padding: 24px 28px;
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  color: var(--stl-text-main);
  text-align: left;
  line-height: normal;
  transform-origin: bottom right;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(12px) scale(0.96);
  transition: opacity var(--stl-duration) var(--stl-ease-spring),
              transform var(--stl-duration) var(--stl-ease-spring),
              visibility var(--stl-duration);
}

.stl-profile-card-{{ section.id }}.is-active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}

/* Card Content Typography */
.stl-card-tagline {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--stl-accent);
  margin-bottom: 8px;
  display: block;
}

.stl-card-title {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0 0 12px 0;
  line-height: 1.2;
}

.stl-card-desc {
  font-size: 14px;
  font-weight: 400;
  line-height: 1.55;
  color: var(--stl-text-muted);
  margin: 0 0 20px 0;
}

/* CTA Button Link */
.stl-card-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--stl-accent);
  text-decoration: none;
  cursor: pointer;
  transition: gap 0.25s var(--stl-ease-spring), color 0.2s ease;
  padding: 4px 0;
}

.stl-card-cta .stl-cta-arrow {
  display: inline-block;
  font-size: 15px;
  line-height: 1;
  transition: transform 0.25s var(--stl-ease-spring);
}

.stl-card-cta:hover {
  color: #ffffff;
}

.stl-card-cta:hover .stl-cta-arrow {
  transform: translateX(5px);
}

.stl-card-cta:active {
  transform: scale(0.97);
}

/* Card Navigation Dots (Inside Card for quick browsing) */
.stl-card-nav-{{ section.id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.stl-nav-dots {
  display: flex;
  gap: 6px;
}

.stl-nav-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.25s ease;
}

.stl-nav-dot.is-active {
  background: var(--stl-accent);
  width: 18px;
  border-radius: 4px;
}

.stl-nav-controls {
  display: flex;
  gap: 6px;
}

.stl-nav-btn {
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: #ffffff;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.stl-nav-btn:hover {
  background: rgba(255, 255, 255, 0.2);
}

.stl-nav-btn:active {
  transform: scale(0.9);
}

/* Mobile Layout Adaptations */
@media screen and (max-width: 749px) {
  .stl-card-container-{{ section.id }} {
    position: relative;
    bottom: auto;
    right: auto;
    left: auto;
    top: auto;
    width: 100%;
    padding: 16px 20px 24px;
    background: {{ section.settings.bg_color | default: '#09090b' }};
  }

  .stl-profile-card-{{ section.id }} {
    max-width: 100%;
    min-width: 100%;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    display: none;
  }

  .stl-profile-card-{{ section.id }}.is-active {
    display: block;
    animation: stlMobileFadeIn 0.3s var(--stl-ease-spring) forwards;
  }

  @keyframes stlMobileFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .stl-card-title {
    font-size: 20px;
  }

  .stl-card-desc {
    font-size: 13.5px;
  }
}

/* Accessibility: Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .stl-hotspot-marker::before,
  .stl-hotspot-marker::after {
    animation: none !important;
  }

  .stl-profile-card-{{ section.id }} {
    transition: opacity 0.2s ease !important;
    transform: none !important;
  }

  .stl-card-cta:hover .stl-cta-arrow {
    transform: none !important;
  }
}
{%- endstyle -%}

<section class="section-{{ section.id }}-padding shopify-section stl-section-{{ section.id }}" id="stl-section-{{ section.id }}" style="margin:0 !important; max-width:100% !important;">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="stl-header-{{ section.id }}">
      {%- if section.settings.subtitle != blank -%}
        <span class="stl-tagline">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="stl-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="stl-stage-{{ section.id }}" id="stl-stage-{{ section.id }}">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2500 }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        class="stl-main-img-{{ section.id }}"
        alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg stl-main-img-placeholder' }}
    {%- endif -%}

    <!-- Hotspots -->
    <div class="stl-hotspots-container-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="stl-hotspot-btn-{{ section.id }} {% if forloop.first %}is-active{% endif %}"
          style="--top: {{ block.settings.pos_y }}%; --left: {{ block.settings.pos_x }}%;"
          data-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          data-x="{{ block.settings.pos_x }}"
          data-y="{{ block.settings.pos_y }}"
          aria-label="{{ block.settings.title | default: 'Ver perfil' }}"
          aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="stl-hotspot-marker">
            <span class="stl-hotspot-dot"></span>
          </span>
        </button>
      {%- endfor -%}
    </div>

    <!-- Desktop Cards Container -->
    <div class="stl-card-container-{{ section.id }} stl-card-pos-{{ section.settings.card_position | default: 'bottom-right' }}" id="stl-card-container-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="stl-profile-card-{{ section.id }} {% if forloop.first %}is-active{% endif %}"
          id="stl-card-{{ section.id }}-{{ forloop.index0 }}"
          data-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
        >
          {%- if block.settings.tagline != blank -%}
            <span class="stl-card-tagline">{{ block.settings.tagline }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="stl-card-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="stl-card-desc">{{ block.settings.description }}</p>
          {%- endif -%}

          {%- if block.settings.cta_text != blank -%}
            <a
              href="{{ block.settings.cta_link | default: '#contacto' }}"
              class="stl-card-cta"
            >
              <span>{{ block.settings.cta_text }}</span>
              <span class="stl-cta-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}

          {%- if section.blocks.size > 1 -%}
            <div class="stl-card-nav-{{ section.id }}">
              <div class="stl-nav-dots">
                {%- for b in section.blocks -%}
                  <button
                    type="button"
                    class="stl-nav-dot {% if forloop.first %}is-active{% endif %}"
                    data-go-to="{{ forloop.index0 }}"
                    aria-label="Ir a elemento {{ forloop.index }}"
                  ></button>
                {%- endfor -%}
              </div>
              <div class="stl-nav-controls">
                <button type="button" class="stl-nav-btn stl-nav-prev" aria-label="Anterior">&lsaquo;</button>
                <button type="button" class="stl-nav-btn stl-nav-next" aria-label="Siguiente">&rsaquo;</button>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const sectionEl = document.getElementById('stl-section-' + sectionId);
  if (!sectionEl) return;

  const hotspots = sectionEl.querySelectorAll('.stl-hotspot-btn-' + sectionId);
  const cards = sectionEl.querySelectorAll('.stl-profile-card-' + sectionId);
  const cardContainer = document.getElementById('stl-card-container-' + sectionId);
  const isFloating = '{{ section.settings.card_position }}' === 'floating';
  let activeIndex = 0;
  const totalItems = hotspots.length;

  function updateActive(index) {
    if (index < 0) index = totalItems - 1;
    if (index >= totalItems) index = 0;
    activeIndex = index;

    // Update hotspots
    hotspots.forEach((btn, idx) => {
      const isActive = idx === activeIndex;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
    });

    // Update cards
    cards.forEach((card, idx) => {
      const isActive = idx === activeIndex;
      card.classList.toggle('is-active', isActive);
    });

    // Update dots inside cards
    sectionEl.querySelectorAll('.stl-nav-dot').forEach(dot => {
      const dotIdx = parseInt(dot.getAttribute('data-go-to'), 10);
      dot.classList.toggle('is-active', dotIdx === activeIndex);
    });

    // Handle floating card position if enabled
    if (isFloating && window.innerWidth >= 750 && cardContainer) {
      const activeBtn = hotspots[activeIndex];
      if (activeBtn) {
        const x = parseFloat(activeBtn.getAttribute('data-x'));
        const y = parseFloat(activeBtn.getAttribute('data-y'));
        
        let leftOffset = x > 60 ? (x - 30) : (x + 4);
        let topOffset = y > 60 ? (y - 25) : (y + 4);
        
        leftOffset = Math.max(5, Math.min(65, leftOffset));
        topOffset = Math.max(5, Math.min(65, topOffset));

        cardContainer.style.left = leftOffset + '%';
        cardContainer.style.top = topOffset + '%';
      }
    }
  }

  // Hotspot Click & Pointerdown handlers (Apple responsive feel)
  hotspots.forEach((btn, idx) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateActive(idx);
    });
  });

  // Card Nav Dots & Controls
  sectionEl.addEventListener('click', (e) => {
    const dot = e.target.closest('.stl-nav-dot');
    if (dot) {
      const targetIdx = parseInt(dot.getAttribute('data-go-to'), 10);
      updateActive(targetIdx);
      return;
    }

    const prevBtn = e.target.closest('.stl-nav-prev');
    if (prevBtn) {
      updateActive(activeIndex - 1);
      return;
    }

    const nextBtn = e.target.closest('.stl-nav-next');
    if (nextBtn) {
      updateActive(activeIndex + 1);
      return;
    }
  });

  // Keyboard navigation
  sectionEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      updateActive(activeIndex + 1);
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      updateActive(activeIndex - 1);
    }
  });

  // Auto-play feature if enabled
  {% if section.settings.auto_play %}
    let autoPlayInterval = null;
    const speed = {{ section.settings.auto_play_speed | default: 5 | times: 1000 }};

    function startAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(() => {
        updateActive(activeIndex + 1);
      }, speed);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
    }

    startAutoPlay();
    sectionEl.addEventListener('mouseenter', stopAutoPlay);
    sectionEl.addEventListener('mouseleave', startAutoPlay);
    sectionEl.addEventListener('touchstart', stopAutoPlay, { passive: true });
  {% endif %}

  // Initialize
  updateActive(0);
})();
</script>

{% schema %}
{
  "name": "Shop the Look Interactive",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle / Tagline",
      "default": "SOLUCIONES INTEGRALES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "EQUIPAMIENTO TÁCTICO POR PERFIL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Hotspots & Card Border)",
      "default": "#ea5c10"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card Position (Desktop)",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "floating", "label": "Floating Near Active Hotspot" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "header",
      "content": "Auto Play"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto rotate hotspots",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_play_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation Speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
