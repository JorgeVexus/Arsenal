    <!-- Hotspots -->
    <div class="stl-hotspots-container-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign top_mobile = block.settings.pos_y_mobile -%}
        {%- if top_mobile == blank or top_mobile == 0 -%}
          {%- assign top_mobile = block.settings.pos_y -%}
        {%- endif -%}

        {%- assign left_mobile = block.settings.pos_x_mobile -%}
        {%- if left_mobile == blank or left_mobile == 0 -%}
