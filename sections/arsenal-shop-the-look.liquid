        data-block-id="{{ block.id }}"
        style="position: relative !important; overflow: hidden !important; isolation: isolate !important; background: #0e0e12 !important; background-color: #0e0e12 !important; border: 1.5px solid {{ accent_color }} !important; border-radius: 16px !important; color: #ffffff !important; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8) !important;"
      >
