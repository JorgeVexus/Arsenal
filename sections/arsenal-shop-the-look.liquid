{% comment %}
Shop the Look Interactive - Profile Solutions
Section with interactive hotspots revealing tactical profile solution cards (Tagline, Title, Description, CTA).
Designed with Apple Design principles and fluid micro-animations.
@author: Jorge Cerna / Vexus & Antigravity
{% endcomment %}

{%- liquid
  assign accent_color = section.settings.accent_color | default: '#ea5c10'
-%}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

#shopify-section-{{ section.id }} {
  position: relative;
  overflow: hidden;
  background-color: {{ section.settings.bg_color | default: '#09090b' }};
}

.stl-section-{{ section.id }} {
  --stl-accent: {{ accent_color }};
  --stl-card-bg: rgba(11, 11, 14, 0.94);
  --stl-card-border: {{ accent_color }};
  --stl-text-main: #ffffff;
  --stl-text-muted: #a1a1aa;
  --stl-radius: 16px;
  --stl-ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --stl-duration: 300ms;
  position: relative;
  width: 100%;
  margin: 0 auto;
}

.stl-header-{{ section.id }} {
  margin-bottom: 28px;
  text-align: center;
  padding: 0 20px;
}

.stl-header-{{ section.id }} .stl-tagline {
  display: inline-block;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--stl-accent);
  margin-bottom: 8px;
}

.stl-header-{{ section.id }} .stl-title {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 900;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0;
  text-transform: uppercase;
  line-height: 1.15;
}

/* Image & Scene Stage */
.stl-stage-{{ section.id }} {
  position: relative;
  width: 100%;
  line-height: 0;
  user-select: none;
  overflow: hidden;
  border-radius: 0;
}

.stl-main-img-{{ section.id }} {
  width: 100%;
  height: auto;
  min-height: 480px;
  object-fit: cover;
  display: block;
  transition: filter 0.4s ease;
}

@media screen and (max-width: 749px) {
  .stl-main-img-{{ section.id }} {
    min-height: 500px;
    object-position: center 20%;
  }
}

/* Hotspots Container */
.stl-hotspots-container-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

/* Hotspot Trigger Item (div-based, completely isolated from global button styles) */
#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }} {
  all: unset !important;
  box-sizing: border-box !important;
  position: absolute !important;
  top: var(--top) !important;
  left: var(--left) !important;
  width: 44px !important;
  height: 44px !important;
  margin-top: -22px !important;
  margin-left: -22px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: transparent !important;
  background-color: transparent !important;
  border: none !important;
  border-radius: 50% !important;
  padding: 0 !important;
  margin-right: 0 !important;
  margin-bottom: 0 !important;
  min-width: 0 !important;
  min-height: 0 !important;
  max-width: 44px !important;
  max-height: 44px !important;
  box-shadow: none !important;
  cursor: pointer !important;
  pointer-events: auto !important;
  z-index: 12 !important;
  outline: none !important;
  -webkit-tap-highlight-color: transparent !important;
  transition: transform 0.25s var(--stl-ease-spring) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}:focus-visible {
  outline: 2px solid var(--stl-accent) !important;
  outline-offset: 4px !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}:hover {
  transform: scale(1.15) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}:active {
  transform: scale(0.92) !important;
}

/* Hotspot Visual Marker */
#shopify-section-{{ section.id }} .stl-hotspot-marker {
  box-sizing: border-box !important;
  position: relative !important;
  width: 20px !important;
  height: 20px !important;
  border-radius: 50% !important;
  background: var(--stl-accent) !important;
  border: 2px solid #ffffff !important;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.6), 0 0 12px var(--stl-accent) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.3s var(--stl-ease-spring) !important;
}

/* Marker Inner Dot */
#shopify-section-{{ section.id }} .stl-hotspot-dot {
  box-sizing: border-box !important;
  width: 8px !important;
  height: 8px !important;
  background: #ffffff !important;
  border-radius: 50% !important;
  opacity: 0 !important;
  transform: scale(0.5) !important;
  transition: all 0.25s var(--stl-ease-spring) !important;
}

/* Marker Pulsing Ring (Inactive state) */
#shopify-section-{{ section.id }} .stl-hotspot-marker::before {
  content: '' !important;
  position: absolute !important;
  top: -5px !important;
  left: -5px !important;
  right: -5px !important;
  bottom: -5px !important;
  border-radius: 50% !important;
  border: 1.5px solid var(--stl-accent) !important;
  opacity: 0.75 !important;
  animation: stlPulse 2.4s cubic-bezier(0.25, 1, 0.5, 1) infinite !important;
  pointer-events: none !important;
}

@keyframes stlPulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  60% { transform: scale(2.0); opacity: 0; }
  100% { transform: scale(2.0); opacity: 0; }
}

/* Active Hotspot State (Prominent Dual Ring & Solid White Center) */
#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-marker {
  width: 32px !important;
  height: 32px !important;
  background: var(--stl-accent) !important;
  border: 3px solid #ffffff !important;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.8), 0 0 25px var(--stl-accent) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-dot {
  opacity: 1 !important;
  transform: scale(1) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-marker::before {
  display: none !important;
}

/* Profile Information Card (Obsidian Dark Glass with Orange Border) */
#shopify-section-{{ section.id }} .stl-card-container-{{ section.id }} {
  position: absolute !important;
  z-index: 20 !important;
  pointer-events: auto !important;
  display: grid !important;
  grid-template-areas: "card" !important;
  align-items: end !important;
  justify-items: end !important;
}

/* Docked Positions Desktop */
#shopify-section-{{ section.id }} .stl-card-pos-bottom-right {
  bottom: 36px !important;
  right: 36px !important;
  justify-items: end !important;
}

#shopify-section-{{ section.id }} .stl-card-pos-bottom-left {
  bottom: 36px !important;
  left: 36px !important;
  justify-items: start !important;
}

#shopify-section-{{ section.id }} .stl-card-pos-top-right {
  top: 36px !important;
  right: 36px !important;
  justify-items: end !important;
  align-items: start !important;
}

#shopify-section-{{ section.id }} .stl-card-pos-top-left {
  top: 36px !important;
  left: 36px !important;
  justify-items: start !important;
  align-items: start !important;
}

/* Floating Card Mode */
#shopify-section-{{ section.id }} .stl-card-pos-floating {
  position: absolute !important;
  transition: top 0.35s var(--stl-ease-spring), left 0.35s var(--stl-ease-spring) !important;
}

#shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }} {
  grid-area: card !important;
  width: 100% !important;
  max-width: 380px !important;
  min-width: 290px !important;
  background: rgba(10, 10, 12, 0.94) !important;
  background-color: #0b0b0e !important;
  backdrop-filter: blur(24px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
  border: 1.5px solid var(--stl-card-border) !important;
  border-radius: var(--stl-radius) !important;
  padding: 26px 30px !important;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.05) inset !important;
  color: var(--stl-text-main) !important;
  text-align: left !important;
  line-height: normal !important;
  transform-origin: bottom right !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  transform: translateY(12px) scale(0.96) !important;
  transition: opacity var(--stl-duration) var(--stl-ease-spring),
              transform var(--stl-duration) var(--stl-ease-spring),
              visibility var(--stl-duration) !important;
}

#shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }}.is-active {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  transform: translateY(0) scale(1) !important;
}

/* Card Content Typography */
#shopify-section-{{ section.id }} .stl-card-tagline {
  font-size: 11px !important;
  font-weight: 800 !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase !important;
  color: var(--stl-accent) !important;
  margin-bottom: 8px !important;
  display: block !important;
  line-height: 1.3 !important;
}

#shopify-section-{{ section.id }} .stl-card-title {
  font-size: 24px !important;
  font-weight: 800 !important;
  letter-spacing: -0.02em !important;
  color: #ffffff !important;
  margin: 0 0 12px 0 !important;
  line-height: 1.2 !important;
}

#shopify-section-{{ section.id }} .stl-card-desc {
  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 1.55 !important;
  color: var(--stl-text-muted) !important;
  margin: 0 0 20px 0 !important;
}

/* CTA Button Link */
#shopify-section-{{ section.id }} .stl-card-cta {
  all: unset !important;
  box-sizing: border-box !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  font-size: 12.5px !important;
  font-weight: 800 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  color: var(--stl-accent) !important;
  text-decoration: none !important;
  cursor: pointer !important;
  padding: 4px 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  transition: gap 0.25s var(--stl-ease-spring), color 0.2s ease !important;
}

#shopify-section-{{ section.id }} .stl-card-cta .stl-cta-arrow {
  display: inline-block !important;
  font-size: 15px !important;
  line-height: 1 !important;
  color: inherit !important;
  transition: transform 0.25s var(--stl-ease-spring) !important;
}

#shopify-section-{{ section.id }} .stl-card-cta:hover {
  color: #ffffff !important;
}

#shopify-section-{{ section.id }} .stl-card-cta:hover .stl-cta-arrow {
  transform: translateX(5px) !important;
}

#shopify-section-{{ section.id }} .stl-card-cta:active {
  transform: scale(0.97) !important;
}

/* Mobile Layout Adaptations */
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .stl-card-container-{{ section.id }} {
    position: relative !important;
    bottom: auto !important;
    right: auto !important;
    left: auto !important;
    top: auto !important;
    width: 100% !important;
    padding: 16px 20px 24px !important;
    background: {{ section.settings.bg_color | default: '#09090b' }} !important;
    display: block !important;
  }

  #shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }} {
    max-width: 100% !important;
    min-width: 100% !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    display: none !important;
  }

  #shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }}.is-active {
    display: block !important;
    animation: stlMobileFadeIn 0.3s var(--stl-ease-spring) forwards !important;
  }

  @keyframes stlMobileFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #shopify-section-{{ section.id }} .stl-card-title {
    font-size: 20px !important;
  }

  #shopify-section-{{ section.id }} .stl-card-desc {
    font-size: 13.5px !important;
  }
}

/* Accessibility: Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .stl-hotspot-marker::before {
    animation: none !important;
  }

  #shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }} {
    transition: opacity 0.2s ease !important;
    transform: none !important;
  }

  #shopify-section-{{ section.id }} .stl-card-cta:hover .stl-cta-arrow {
    transform: none !important;
  }
}
{%- endstyle -%}

<section class="section-{{ section.id }}-padding shopify-section stl-section-{{ section.id }}" id="stl-section-{{ section.id }}" style="margin:0 !important; max-width:100% !important;">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="stl-header-{{ section.id }}">
      {%- if section.settings.subtitle != blank -%}
        <span class="stl-tagline">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="stl-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="stl-stage-{{ section.id }}" id="stl-stage-{{ section.id }}">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2500 }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        class="stl-main-img-{{ section.id }}"
        alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg stl-main-img-placeholder' }}
    {%- endif -%}

    <!-- Hotspots -->
    <div class="stl-hotspots-container-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          role="button"
          tabindex="0"
          class="stl-hotspot-item-{{ section.id }} {% if forloop.first %}is-active{% endif %}"
          style="--top: {{ block.settings.pos_y }}%; --left: {{ block.settings.pos_x }}%;"
          data-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          data-x="{{ block.settings.pos_x }}"
          data-y="{{ block.settings.pos_y }}"
          aria-label="{{ block.settings.title | default: 'Ver perfil' }}"
          aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="stl-hotspot-marker">
            <span class="stl-hotspot-dot"></span>
          </span>
        </div>
      {%- endfor -%}
    </div>

    <!-- Desktop Cards Container -->
    <div class="stl-card-container-{{ section.id }} stl-card-pos-{{ section.settings.card_position | default: 'bottom-right' }}" id="stl-card-container-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="stl-profile-card-{{ section.id }} {% if forloop.first %}is-active{% endif %}"
          id="stl-card-{{ section.id }}-{{ forloop.index0 }}"
          data-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
        >
          {%- if block.settings.tagline != blank -%}
            <span class="stl-card-tagline">{{ block.settings.tagline }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="stl-card-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="stl-card-desc">{{ block.settings.description }}</p>
          {%- endif -%}

          {%- if block.settings.cta_text != blank -%}
            <a
              href="{{ block.settings.cta_link | default: '#contacto' }}"
              class="stl-card-cta"
            >
              <span>{{ block.settings.cta_text }}</span>
              <span class="stl-cta-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const sectionEl = document.getElementById('stl-section-' + sectionId);
  if (!sectionEl) return;

  const hotspots = sectionEl.querySelectorAll('.stl-hotspot-item-' + sectionId);
  const cards = sectionEl.querySelectorAll('.stl-profile-card-' + sectionId);
  const cardContainer = document.getElementById('stl-card-container-' + sectionId);
  const isFloating = '{{ section.settings.card_position }}' === 'floating';
  let activeIndex = 0;
  const totalItems = hotspots.length;

  function updateActive(index) {
    if (index < 0) index = totalItems - 1;
    if (index >= totalItems) index = 0;
    activeIndex = index;

    // Update hotspots
    hotspots.forEach((btn, idx) => {
      const isActive = idx === activeIndex;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
    });

    // Update cards
    cards.forEach((card, idx) => {
      const isActive = idx === activeIndex;
      card.classList.toggle('is-active', isActive);
    });

    // Handle floating card position if enabled
    if (isFloating && window.innerWidth >= 750 && cardContainer) {
      const activeBtn = hotspots[activeIndex];
      if (activeBtn) {
        const x = parseFloat(activeBtn.getAttribute('data-x'));
        const y = parseFloat(activeBtn.getAttribute('data-y'));
        
        let leftOffset = x > 60 ? (x - 30) : (x + 4);
        let topOffset = y > 60 ? (y - 25) : (y + 4);
        
        leftOffset = Math.max(5, Math.min(65, leftOffset));
        topOffset = Math.max(5, Math.min(65, topOffset));

        cardContainer.style.left = leftOffset + '%';
        cardContainer.style.top = topOffset + '%';
      }
    }
  }

  // Hotspot Click & Keydown handlers
  hotspots.forEach((btn, idx) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateActive(idx);
    });

    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        updateActive(idx);
      }
    });
  });

  // Global Arrow navigation when focused in section
  sectionEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      updateActive(activeIndex + 1);
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      updateActive(activeIndex - 1);
    }
  });

  // Auto-play feature if enabled
  {% if section.settings.auto_play %}
    let autoPlayInterval = null;
    const speed = {{ section.settings.auto_play_speed | default: 5 | times: 1000 }};

    function startAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(() => {
        updateActive(activeIndex + 1);
      }, speed);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
    }

    startAutoPlay();
    sectionEl.addEventListener('mouseenter', stopAutoPlay);
    sectionEl.addEventListener('mouseleave', startAutoPlay);
    sectionEl.addEventListener('touchstart', stopAutoPlay, { passive: true });
  {% endif %}

  // Initialize
  updateActive(0);
})();
</script>

{% schema %}
{
  "name": "Shop the Look Interactive",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle / Tagline",
      "default": "SOLUCIONES INTEGRALES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "EQUIPAMIENTO TÁCTICO POR PERFIL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Hotspots & Card Border)",
      "default": "#ea5c10"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card Position (Desktop)",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "floating", "label": "Floating Near Active Hotspot" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "header",
      "content": "Auto Play"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto rotate hotspots",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_play_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation Speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "SOLUCIÓN POR PERFIL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fuerza Policiaca"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Chalecos, placas, cascos y accesorios configurados para corporaciones municipales, estatales y federales."
        },
        {
