  <!-- Cards Container (Desktop Docked / Mobile One-Screen Glass Sheet) -->
  <div class="stl-card-container-{{ section.id }} stl-card-pos-{{ section.settings.card_position | default: 'bottom-right' }}" id="stl-card-container-{{ section.id }}" style="background: transparent !important;">
    {%- for block in section.blocks -%}
      <div
        class="stl-profile-card-{{ section.id }} {% if forloop.first %}is-active{% endif %}"
        id="stl-card-{{ section.id }}-{{ forloop.index0 }}"
