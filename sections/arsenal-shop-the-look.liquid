{% comment %}
Shop the Look Interactive - Profile Solutions
Section with interactive hotspots revealing tactical profile solution cards (Tagline, Title, Description, CTA).
Designed with Apple Design principles, responsive one-screen mobile fit, and fluid micro-animations.
@author: Jorge Cerna / Vexus & Antigravity
{% endcomment %}

{%- liquid
  assign accent_color = section.settings.accent_color | default: '#ea5c10'
  assign desktop_img = section.settings.image
  assign mobile_img = section.settings.image_mobile | default: desktop_img
-%}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

#shopify-section-{{ section.id }},
#shopify-section-{{ section.id }}.shopify-section,
[id*="shopify-section"][id*="{{ section.id }}"] {
  position: relative !important;
  width: 100vw !important;
  max-width: 100vw !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
  background-color: {{ section.settings.bg_color | default: '#09090b' }} !important;
}


.stl-section-{{ section.id }} {
  --stl-accent: {{ accent_color }};
  --stl-card-bg: rgba(14, 14, 18, 0.94);
  --stl-card-border: {{ accent_color }};
  --stl-text-main: #ffffff;
  --stl-text-muted: #a1a1aa;
  --stl-radius: 16px;
  --stl-ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --stl-duration: 300ms;
  position: relative;
  width: 100%;
  margin: 0 auto;
}

.stl-header-{{ section.id }} {
  margin-bottom: 24px;
  text-align: center;
  padding: 0 20px;
}

.stl-header-{{ section.id }} .stl-tagline {
  display: inline-block;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--stl-accent);
  margin-bottom: 6px;
}

.stl-header-{{ section.id }} .stl-title {
  font-size: clamp(22px, 3.8vw, 36px);
  font-weight: 900;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0;
  text-transform: uppercase;
  line-height: 1.15;
}

/* Image & Scene Stage */
.stl-stage-{{ section.id }} {
  position: relative;
  width: 100%;
  line-height: 0;
  user-select: none;
  -webkit-user-select: none;
  overflow: hidden;
  border-radius: 0;
}

.stl-main-img-{{ section.id }} {
  width: 100%;
  height: auto;
  min-height: 480px;
  object-fit: cover;
  display: block;
  transition: filter 0.4s ease;
}

/* Hotspots Container */
.stl-hotspots-container-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

/* Hotspot Trigger Item (Apple-style 44px hit target) */
#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }} {
  all: unset !important;
  box-sizing: border-box !important;
  position: absolute !important;
  top: var(--top, var(--top-desktop)) !important;
  left: var(--left, var(--left-desktop)) !important;
  width: 44px !important;
  height: 44px !important;
  margin-top: -22px !important;
  margin-left: -22px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: transparent !important;
  background-color: transparent !important;
  border: none !important;
  border-radius: 50% !important;
  padding: 0 !important;
  margin-right: 0 !important;
  margin-bottom: 0 !important;
  min-width: 0 !important;
  min-height: 0 !important;
  max-width: 44px !important;
  max-height: 44px !important;
  box-shadow: none !important;
  cursor: pointer !important;
  pointer-events: auto !important;
  z-index: 12 !important;
  outline: none !important;
  -webkit-tap-highlight-color: transparent !important;
  transition: transform 0.25s var(--stl-ease-spring) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}:focus-visible {
  outline: 2px solid var(--stl-accent) !important;
  outline-offset: 4px !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}:hover {
  transform: scale(1.15) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}:active {
  transform: scale(0.9) !important;
}

/* Hotspot Visual Marker */
#shopify-section-{{ section.id }} .stl-hotspot-marker {
  box-sizing: border-box !important;
  position: relative !important;
  width: 20px !important;
  height: 20px !important;
  border-radius: 50% !important;
  background: var(--stl-accent) !important;
  border: 2px solid #ffffff !important;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.6), 0 0 14px var(--stl-accent) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.3s var(--stl-ease-spring) !important;
}

/* Marker Inner Dot */
#shopify-section-{{ section.id }} .stl-hotspot-dot {
  box-sizing: border-box !important;
  width: 8px !important;
  height: 8px !important;
  background: #ffffff !important;
  border-radius: 50% !important;
  opacity: 0 !important;
  transform: scale(0.5) !important;
  transition: all 0.25s var(--stl-ease-spring) !important;
}

/* Marker Pulsing Ring (Inactive state) */
#shopify-section-{{ section.id }} .stl-hotspot-marker::before {
  content: '' !important;
  position: absolute !important;
  top: -5px !important;
  left: -5px !important;
  right: -5px !important;
  bottom: -5px !important;
  border-radius: 50% !important;
  border: 1.5px solid var(--stl-accent) !important;
  opacity: 0.75 !important;
  animation: stlPulse 2.4s cubic-bezier(0.25, 1, 0.5, 1) infinite !important;
  pointer-events: none !important;
}

@keyframes stlPulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  60% { transform: scale(2.0); opacity: 0; }
  100% { transform: scale(2.0); opacity: 0; }
}

/* Active Hotspot State (Prominent Dual Ring & Radiant Center) */
#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-marker {
  width: 30px !important;
  height: 30px !important;
  background: var(--stl-accent) !important;
  border: 3px solid #ffffff !important;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.85), 0 0 24px var(--stl-accent) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-dot {
  opacity: 1 !important;
  transform: scale(1) !important;
}

#shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-marker::before {
  display: none !important;
}

/* Profile Information Card (Obsidian Dark Glass with Accent Border) */
#shopify-section-{{ section.id }} .stl-card-container-{{ section.id }} {
  position: absolute !important;
  z-index: 20 !important;
  pointer-events: auto !important;
  display: grid !important;
  grid-template-areas: "card" !important;
  align-items: end !important;
  justify-items: end !important;
}

/* Docked Positions Desktop */
#shopify-section-{{ section.id }} .stl-card-pos-bottom-right {
  bottom: 36px !important;
  right: 36px !important;
  justify-items: end !important;
}

#shopify-section-{{ section.id }} .stl-card-pos-bottom-left {
  bottom: 36px !important;
  left: 36px !important;
  justify-items: start !important;
}

#shopify-section-{{ section.id }} .stl-card-pos-top-right {
  top: 36px !important;
  right: 36px !important;
  justify-items: end !important;
  align-items: start !important;
}

#shopify-section-{{ section.id }} .stl-card-pos-top-left {
  top: 36px !important;
  left: 36px !important;
  justify-items: start !important;
  align-items: start !important;
}

/* Floating Card Mode */
#shopify-section-{{ section.id }} .stl-card-pos-floating {
  position: absolute !important;
  transition: top 0.35s var(--stl-ease-spring), left 0.35s var(--stl-ease-spring) !important;
}

#shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }},
.stl-section-{{ section.id }} .stl-profile-card-{{ section.id }},
[id*="shopify-section"][id*="{{ section.id }}"] .stl-profile-card-{{ section.id }},
div.stl-profile-card-{{ section.id }} {
  grid-area: card !important;
  width: 100% !important;
  max-width: 380px !important;
  min-width: 290px !important;
  background: rgba(14, 14, 18, 0.96) !important;
  background-color: #0e0e12 !important;
  backdrop-filter: blur(24px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
  border: 1.5px solid var(--stl-card-border) !important;
  border-radius: var(--stl-radius) !important;
  padding: 24px 28px !important;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.06) inset !important;
  color: #ffffff !important;
  text-align: left !important;
  line-height: normal !important;
  transform-origin: bottom right !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  transform: translateY(12px) scale(0.96) !important;
  transition: opacity var(--stl-duration) var(--stl-ease-spring),
              transform var(--stl-duration) var(--stl-ease-spring),
              visibility var(--stl-duration) !important;
}

#shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }}.is-active,
.stl-section-{{ section.id }} .stl-profile-card-{{ section.id }}.is-active,
[id*="shopify-section"][id*="{{ section.id }}"] .stl-profile-card-{{ section.id }}.is-active,
div.stl-profile-card-{{ section.id }}.is-active {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  transform: translateY(0) scale(1) !important;
}

/* Card Content Typography */
#shopify-section-{{ section.id }} .stl-card-header-row {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  margin-bottom: 6px !important;
}

#shopify-section-{{ section.id }} .stl-card-tagline {
  font-size: 11px !important;
  font-weight: 800 !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase !important;
  color: var(--stl-accent) !important;
  line-height: 1.3 !important;
  margin: 0 !important;
}

#shopify-section-{{ section.id }} .stl-card-counter {
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.05em !important;
  color: rgba(255, 255, 255, 0.65) !important;
  background: rgba(255, 255, 255, 0.08) !important;
  padding: 2px 8px !important;
  border-radius: 12px !important;
  line-height: 1.2 !important;
}

#shopify-section-{{ section.id }} .stl-card-title {
  font-size: 22px !important;
  font-weight: 800 !important;
  letter-spacing: -0.02em !important;
  color: #ffffff !important;
  margin: 0 0 10px 0 !important;
  line-height: 1.2 !important;
}

#shopify-section-{{ section.id }} .stl-card-desc {
  font-size: 13.5px !important;
  font-weight: 400 !important;
  line-height: 1.5 !important;
  color: var(--stl-text-muted) !important;
  margin: 0 0 18px 0 !important;
}

/* Card Footer Row: CTA + Controls */
#shopify-section-{{ section.id }} .stl-card-footer-row {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 12px !important;
}

/* CTA Button Link */
#shopify-section-{{ section.id }} .stl-card-cta {
  all: unset !important;
  box-sizing: border-box !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  font-size: 12.5px !important;
  font-weight: 800 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  color: var(--stl-accent) !important;
  text-decoration: none !important;
  cursor: pointer !important;
  padding: 4px 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  transition: gap 0.25s var(--stl-ease-spring), color 0.2s ease !important;
}

#shopify-section-{{ section.id }} .stl-card-cta .stl-cta-arrow {
  display: inline-block !important;
  font-size: 15px !important;
  line-height: 1 !important;
  color: inherit !important;
  transition: transform 0.25s var(--stl-ease-spring) !important;
}

#shopify-section-{{ section.id }} .stl-card-cta:hover {
  color: #ffffff !important;
}

#shopify-section-{{ section.id }} .stl-card-cta:hover .stl-cta-arrow {
  transform: translateX(5px) !important;
}

#shopify-section-{{ section.id }} .stl-card-cta:active {
  transform: scale(0.97) !important;
}

/* Mobile Nav Pill Buttons (Thumb-friendly) */
#shopify-section-{{ section.id }} .stl-mobile-nav {
  display: none !important;
  align-items: center !important;
  gap: 6px !important;
}

#shopify-section-{{ section.id }} .stl-nav-btn,
.stl-nav-btn {
  all: unset !important;
  box-sizing: border-box !important;
  position: relative !important;
  overflow: hidden !important;
  isolation: isolate !important;
  width: 32px !important;
  height: 32px !important;
  border-radius: 50% !important;
  background: rgba(255, 255, 255, 0.08) !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  color: #ffffff !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 16px !important;
  cursor: pointer !important;
  user-select: none !important;
  -webkit-user-select: none !important;
  transition: all 0.2s ease !important;
}

#shopify-section-{{ section.id }} .stl-nav-btn:active,
.stl-nav-btn:active {
  background: var(--stl-accent) !important;
  transform: scale(0.9) !important;
}

/* =========================================================
   Mobile Layout Adaptations: One-Screen Fit & Full Visibility
   ========================================================= */
@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding {
    padding-top: 18px !important;
    padding-bottom: 24px !important;
  }

  .stl-header-{{ section.id }} {
    margin-bottom: 14px !important;
    padding: 0 16px !important;
  }

  .stl-header-{{ section.id }} .stl-tagline {
    font-size: 10.5px !important;
    font-weight: 800 !important;
    letter-spacing: 0.12em !important;
    margin-bottom: 4px !important;
  }

  .stl-header-{{ section.id }} .stl-title {
    font-size: clamp(18px, 5.2vw, 24px) !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em !important;
    line-height: 1.15 !important;
  }

  /* Stage scaled to fit cleanly within single screen view */
  .stl-stage-{{ section.id }} {
    width: calc(100% - 24px) !important;
    max-width: 520px !important;
    margin: 0 auto !important;
    border-radius: 16px !important;
    overflow: hidden !important;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
  }

  .stl-main-img-{{ section.id }} {
    width: 100% !important;
    height: {{ section.settings.stage_height_mobile | default: 280 }}px !important;
    min-height: unset !important;
    max-height: 40vh !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
  }

  /* Hotspots: Apple-grade 44px thumb touch target */
  #shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }} {
    top: var(--top-mobile, var(--top-desktop)) !important;
    left: var(--left-mobile, var(--left-desktop)) !important;
    width: 44px !important;
    height: 44px !important;
    margin-top: -22px !important;
    margin-left: -22px !important;
  }

  #shopify-section-{{ section.id }} .stl-hotspot-marker {
    width: 20px !important;
    height: 20px !important;
  }

  #shopify-section-{{ section.id }} .stl-hotspot-item-{{ section.id }}.is-active .stl-hotspot-marker {
    width: 28px !important;
    height: 28px !important;
  }

  /* Profile Card Container: Seamlessly centered on deep obsidian background */
  #shopify-section-{{ section.id }} .stl-card-container-{{ section.id }} {
    position: relative !important;
    bottom: auto !important;
    right: auto !important;
    left: auto !important;
    top: auto !important;
    width: calc(100% - 24px) !important;
    max-width: 520px !important;
    margin: 14px auto 0 !important;
    padding: 0 !important;
    background: transparent !important;
    display: grid !important;
    grid-template-areas: "card" !important;
    align-items: stretch !important;
  }

  /* Profile Card: Apple Obsidian Glass with Crisp 1.5px Orange Border */
  #shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }},
  .stl-section-{{ section.id }} .stl-profile-card-{{ section.id }},
  [id*="shopify-section"][id*="{{ section.id }}"] .stl-profile-card-{{ section.id }},
  div.stl-profile-card-{{ section.id }} {
    grid-area: card !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    background: rgba(14, 14, 18, 0.96) !important;
    background-color: #0e0e12 !important;
    backdrop-filter: blur(24px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
    border: 1.5px solid var(--stl-accent) !important;
    border-radius: 16px !important;
    padding: 20px 22px !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.08) inset !important;
    color: #ffffff !important;
    transform: translateY(10px) scale(0.97) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: opacity var(--stl-duration) var(--stl-ease-spring),
                transform var(--stl-duration) var(--stl-ease-spring),
                visibility var(--stl-duration) !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    text-align: left !important;
  }

  #shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }}.is-active,
  .stl-section-{{ section.id }} .stl-profile-card-{{ section.id }}.is-active,
  [id*="shopify-section"][id*="{{ section.id }}"] .stl-profile-card-{{ section.id }}.is-active,
  div.stl-profile-card-{{ section.id }}.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) scale(1) !important;
    pointer-events: auto !important;
  }

  .stl-card-header-row,
  #shopify-section-{{ section.id }} .stl-card-header-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    margin-bottom: 6px !important;
  }

  .stl-card-tagline,
  #shopify-section-{{ section.id }} .stl-card-tagline {
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    color: var(--stl-accent) !important;
    line-height: 1.3 !important;
    margin: 0 !important;
    display: block !important;
  }

  .stl-card-counter,
  #shopify-section-{{ section.id }} .stl-card-counter {
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    color: rgba(255, 255, 255, 0.75) !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    padding: 2px 8px !important;
    border-radius: 12px !important;
    line-height: 1.2 !important;
  }

  .stl-card-title,
  #shopify-section-{{ section.id }} .stl-card-title {
    font-size: 20px !important;
    font-weight: 800 !important;
    letter-spacing: -0.02em !important;
    color: #ffffff !important;
    margin: 0 0 8px 0 !important;
    line-height: 1.2 !important;
  }

  .stl-card-desc,
  #shopify-section-{{ section.id }} .stl-card-desc {
    font-size: 13.5px !important;
    font-weight: 400 !important;
    line-height: 1.5 !important;
    color: #a1a1aa !important;
    margin: 0 0 16px 0 !important;
  }

  .stl-card-footer-row,
  #shopify-section-{{ section.id }} .stl-card-footer-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
    margin-top: auto !important;
    padding-top: 4px !important;
  }

  .stl-card-cta,
  #shopify-section-{{ section.id }} .stl-card-cta {
    font-size: 12px !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: var(--stl-accent) !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    min-height: 40px !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: gap 0.25s var(--stl-ease-spring), color 0.2s ease !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .stl-card-cta .stl-cta-arrow,
  #shopify-section-{{ section.id }} .stl-card-cta .stl-cta-arrow {
    display: inline-block !important;
    font-size: 15px !important;
    line-height: 1 !important;
    color: var(--stl-accent) !important;
    transition: transform 0.25s var(--stl-ease-spring) !important;
  }

  .stl-card-cta:active {
    transform: scale(0.96) !important;
  }

  /* Tactile Pill Navigation with Apple Haptic-like Instant Feedback */
  .stl-mobile-nav,
  #shopify-section-{{ section.id }} .stl-mobile-nav {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .stl-nav-btn,
  #shopify-section-{{ section.id }} .stl-nav-btn {
    all: unset !important;
    box-sizing: border-box !important;
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
    width: 38px !important;
    height: 38px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 18px !important;
    line-height: 1 !important;
    cursor: pointer !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    -webkit-tap-highlight-color: transparent !important;
    transition: background 0.15s ease, transform 0.1s var(--stl-ease-spring), border-color 0.15s ease !important;
  }

  .stl-nav-btn:active,
  #shopify-section-{{ section.id }} .stl-nav-btn:active {
    background: var(--stl-accent) !important;
    border-color: var(--stl-accent) !important;
    transform: scale(0.88) !important;
  }
}

/* Accessibility: Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .stl-hotspot-marker::before {
    animation: none !important;
  }

  #shopify-section-{{ section.id }} .stl-profile-card-{{ section.id }} {
    transition: opacity 0.2s ease !important;
    transform: none !important;
  }

  #shopify-section-{{ section.id }} .stl-card-cta:hover .stl-cta-arrow {
    transform: none !important;
  }
}
{%- endstyle -%}

<section class="section-{{ section.id }}-padding shopify-section stl-section-{{ section.id }}" id="stl-section-{{ section.id }}" style="margin:0 !important; max-width:100% !important;">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="stl-header-{{ section.id }}">
      {%- if section.settings.subtitle != blank -%}
        <span class="stl-tagline">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="stl-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="stl-stage-{{ section.id }}" id="stl-stage-{{ section.id }}">
    {%- if desktop_img != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
        {%- endif -%}
        <img
          src="{{ desktop_img | image_url: width: 2500 }}"
          loading="eager"
          fetchpriority="high"
          width="{{ desktop_img.width }}"
          height="{{ desktop_img.height }}"
          class="stl-main-img-{{ section.id }}"
          alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
        >
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg stl-main-img-placeholder' }}
