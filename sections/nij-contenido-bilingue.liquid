{% comment %}Arsenal NIJ: Spanish/English storefront content. Native section locale keys. {% endcomment %}
<style>
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }} !important; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_desktop }}px; }
    {% if section.settings.spacing_desktop < 0 %}
    #shopify-section-{{ section.id }} + *.has-kinetic-text { pointer-events: none; }
    {% endif %}
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_mobile }}px; }
    {% if section.settings.spacing_mobile < 0 %}
    #shopify-section-{{ section.id }} + *.has-kinetic-text { pointer-events: none; }
    {% endif %}
  }
</style>
{% case section.settings.nij_part %}
{% when 'p01' %}
<style>
  .ars-nij-intro {
    background: #fff;
    color: #1d2426;
    padding: 40px 24px;
    font-family: var(--font-body-family, inherit);
    font-style: var(--font-body-style, normal);
    font-weight: var(--font-body-weight, 400);
    line-height: 1.5;
    scroll-margin-top: 100px;
  }

  .ars-nij-intro,
  .ars-nij-intro * {
    box-sizing: border-box;
  }

  .ars-nij-intro__inner {
    max-width: 1250px;
    margin: 0 auto;
  }

  .ars-nij-intro .ars-nij-intro__label {
    margin: 0 0 20px;
    color: #dd5409;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1;
    text-transform: uppercase;
  }

  .ars-nij-intro__heading {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: end;
    gap: 40px;
    margin-bottom: 32px;
  }

  .ars-nij-intro h2,
  .ars-nij-intro h3 {
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 700);
    color: #1d2426;
    line-height: 1;
    text-transform: none;
  }

  .ars-nij-intro h2 {
    margin: 0;
    font-size: 64px;
    letter-spacing: -1.5px;
  }

  .ars-nij-intro .ars-nij-intro__summary {
    max-width: 430px;
    margin: 0;
    color: #626c70;
    font-size: 17px;
    line-height: 1.5;
  }

  .ars-nij-intro__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid #d9ddde;
    border-bottom: 1px solid #d9ddde;
  }

  .ars-nij-intro__item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: start;
    gap: 18px;
    padding: 28px 32px 28px 0;
  }

  .ars-nij-intro__item + .ars-nij-intro__item {
    border-left: 1px solid #d9ddde;
    padding-left: 32px;
    padding-right: 0;
  }

  .ars-nij-intro__number {
    color: #b9bfc1;
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
  }

  .ars-nij-intro .ars-nij-intro__standard {
    margin: 0 0 12px;
    color: #dd5409;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1;
  }

  .ars-nij-intro h3 {
    margin: 0 0 16px;
    font-size: clamp(24px, 2.3vw, 30px);
    letter-spacing: -0.5px;
  }

  .ars-nij-intro .ars-nij-intro__copy {
    margin: 0 0 16px;
    color: #626c70;
    font-size: 16px;
    line-height: 1.5;
  }

  .ars-nij-intro a {
    display: inline-block;
    padding: 4px 0;
    color: #1d2426;
    font-family: inherit;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.5;
    text-transform: none;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ars-nij-intro a:hover {
    color: #dd5409;
  }

  .ars-nij-intro a:focus-visible {
    outline: 2px solid #dd5409;
    outline-offset: 5px;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ars-nij-intro__heading {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ars-nij-intro h2 {
      font-size: 56px;
    }

    .ars-nij-intro .ars-nij-intro__summary {
      max-width: 580px;
    }
  }

  @media screen and (max-width: 749px) {
    .ars-nij-intro {
      padding: 28px 20px;
    }

    .ars-nij-intro .ars-nij-intro__label {
      margin-bottom: 16px;
      font-size: 11px;
      letter-spacing: 1px;
    }

    .ars-nij-intro__heading {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .ars-nij-intro h2 {
      font-size: 40px;
      letter-spacing: -1px;
    }

    .ars-nij-intro .ars-nij-intro__summary {
      font-size: 15px;
    }

    .ars-nij-intro__grid {
      grid-template-columns: 1fr;
    }

    .ars-nij-intro__item,
    .ars-nij-intro__item + .ars-nij-intro__item {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 12px;
      padding: 22px 0;
      border-left: none;
    }

    .ars-nij-intro__item + .ars-nij-intro__item {
      border-top: 1px solid #d9ddde;
    }

    .ars-nij-intro__number {
      font-size: 28px;
    }

    .ars-nij-intro .ars-nij-intro__standard {
      margin-bottom: 10px;
      font-size: 12px;
    }

    .ars-nij-intro h3 {
      margin-bottom: 12px;
      font-size: 24px;
    }

    .ars-nij-intro .ars-nij-intro__copy {
      margin-bottom: 14px;
      font-size: 15px;
    }

    .ars-nij-intro a {
      font-size: 11px;
    }
  }
</style>

<section
  class="ars-nij-intro"
  id="entender-actualizacion"
