<section
  id="ars-paneles-{{ section.id }}"
  aria-labelledby="ars-paneles-title-{{ section.id }}"
>
  <div class="ars-paneles__inner">

    <p class="ars-paneles__eyebrow">
      04 / Arsenal Protection Mexico
    </p>

    <div class="ars-paneles__header">
      <h2
        id="ars-paneles-title-{{ section.id }}"
        class="ars-paneles__title"
      >{{ 'nij.p04.heading_html' | t }}</h2>

      <p class="ars-paneles__intro">
        {{ 'nij.p04.text_58a2a2c3da' | t | escape }}
      </p>
    </div>

    <div class="ars-paneles__grid">

      {% for numero in (1..2) %}
        {% liquid
          if numero == 1
            assign panel = panel_gr507
            assign modelo = 'GR507'
            assign destino = nij_locale_root | append: '/products/panel-balistico-gr-507'
            assign descripcion = 'nij.p04.text_6e008cf1b4' | t
          else
            assign panel = panel_gr407
            assign modelo = 'GR407'
            assign destino = nij_locale_root | append: '/products/panel-balistico-gr-407'
            assign descripcion = 'nij.p04.text_9ad586da33' | t
          endif

          assign imagen_panel = panel.featured_image
          assign texto_alternativo = 'nij.p04.panel_alt' | t: model: modelo
        %}

        <article class="ars-paneles__card">
          <a
            class="ars-paneles__media"
            href="{{ destino }}"
            aria-label="{{ 'nij.p04.panel_link' | t: model: modelo | escape }}"
          >
            <span class="ars-paneles__badge">
              NIJ 0101.07
            </span>

            {% if imagen_panel != blank %}
              {{
                imagen_panel
                | image_url: width: 1400
                | image_tag:
                  class: 'ars-paneles__image',
                  loading: 'lazy',
                  widths: '360, 540, 720, 960, 1200, 1400',
                  sizes: '(max-width: 749px) calc(100vw - 40px), (max-width: 1298px) calc((100vw - 80px) / 2), 609px',
                  alt: texto_alternativo
              }}
            {% else %}
              <div class="ars-paneles__placeholder">
                {{ 'nij.p04.panel_missing' | t: model: modelo | escape }}
              </div>
            {% endif %}
          </a>

          <p class="ars-paneles__category">
            {{ 'nij.p04.text_3c8caafcff' | t | escape }}
          </p>

          <div class="ars-paneles__model-row">
            <h3 class="ars-paneles__model">
              <a href="{{ destino }}">
                {{ modelo }}
              </a>
            </h3>

            <a
              class="ars-paneles__arrow"
              href="{{ destino }}"
              aria-label="{{ 'nij.p04.panel_link' | t: model: modelo | escape }}"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 18 18 6M6 6h12v12"/>
              </svg>
            </a>
          </div>

          <p class="ars-paneles__description">
            {{ descripcion }}
          </p>
        </article>
      {% endfor %}

    </div>
  </div>
</section>
{% when 'p05' %}
{% liquid
  assign panel_femenino = all_products['panel-balistico-femenino']

  assign archivo_con_funda = panel_femenino.metafields.custom.nij_con_funda.value
  assign archivo_sin_funda = panel_femenino.metafields.custom.nij_sin_funda.value
  assign imagen_con_funda = archivo_con_funda.preview_image | default: archivo_con_funda
  assign imagen_sin_funda = archivo_sin_funda.preview_image | default: archivo_sin_funda

  comment
    Campos de imagen del producto, si existen. Como respaldo se utiliza
    la galería actual: imagen 1 con funda, imagen 2 sin funda.
    No hay direcciones de archivo fijas: las imágenes se leen del producto.
  endcomment

  if imagen_con_funda == blank or imagen_con_funda == nil
    assign imagen_con_funda = panel_femenino.images[0]
  endif
  if imagen_sin_funda == blank or imagen_sin_funda == nil
    assign imagen_sin_funda = panel_femenino.images[1]
  endif
%}

