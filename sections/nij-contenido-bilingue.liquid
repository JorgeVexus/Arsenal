<section
  id="ars-asesoria-{{ section.id }}"
  aria-labelledby="ars-asesoria-title-{{ section.id }}"
>
  <div class="ars-asesoria__inner">

    <div class="ars-asesoria__content">
      <p class="ars-asesoria__label">
        {{ 'nij.p08.text_6fc24e2993' | t | escape }}
      </p>

      <h2
        class="ars-asesoria__title"
        id="ars-asesoria-title-{{ section.id }}"
      >{{ 'nij.p08.heading_html' | t }}</h2>

      <p class="ars-asesoria__intro">
        {{ 'nij.p08.text_fc092e8937' | t | escape }}
      </p>

      <a
        class="ars-asesoria__email"
        href="mailto:cotizaciones@arsenalprotect.com"
      >
        cotizaciones@arsenalprotect.com
        <span aria-hidden="true">↗</span>
      </a>

      <p class="ars-asesoria__note">
        {{ 'nij.p08.text_b7b917753d' | t | escape }}
      </p>
    </div>

    <div class="ars-asesoria__box">

      {% form 'contact',
        id: asesoria_form_id,
        class: 'ars-asesoria__form',
        return_to: asesoria_return
      %}

        {% if form.posted_successfully? %}
          <p
            class="ars-asesoria__status ars-asesoria__status--success"
            role="status"
          >
            {{ 'nij.p08.text_b9f89ca48a' | t | escape }}
          </p>
        {% endif %}

        {% if form.errors %}
          <div
            class="ars-asesoria__status ars-asesoria__status--error"
            role="alert"
          >
            <p>{{ 'nij.p08.text_5aaa9d597d' | t | escape }}</p>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <input
          type="hidden"
          name="contact[Origen]"
          value="Landing NIJ 0101.07 — {{ localization.language.iso_code | escape }}"
        >

        <div class="ars-asesoria__fields">

          <div class="ars-asesoria__field">
            <label
              class="ars-asesoria__field-label"
              for="ars-nombre-{{ section.id }}"
            >
              {{ 'nij.p08.text_15d38639ee' | t | escape }}
            </label>

            <input
              class="ars-asesoria__input"
              type="text"
              id="ars-nombre-{{ section.id }}"
              name="contact[name]"
              autocomplete="name"
              value="{{ form.name | escape }}"
              required
            >
          </div>

          <div class="ars-asesoria__field">
            <label
              class="ars-asesoria__field-label"
              for="ars-empresa-{{ section.id }}"
            >
              {{ 'nij.p08.text_1a928a29a5' | t | escape }}
            </label>

            <input
              class="ars-asesoria__input"
              type="text"
              id="ars-empresa-{{ section.id }}"
              name="contact[Empresa o dependencia]"
              autocomplete="organization"
              value="{{ form['Empresa o dependencia'] | escape }}"
              required
            >
          </div>

          <div class="ars-asesoria__field">
            <label
              class="ars-asesoria__field-label"
              for="ars-correo-{{ section.id }}"
            >
              {{ 'nij.p08.text_49f37f515c' | t | escape }}
            </label>

            <input
              class="ars-asesoria__input"
              type="email"
              id="ars-correo-{{ section.id }}"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              value="{{ form.email | escape }}"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}
              required
            >
          </div>

          <div class="ars-asesoria__field">
            <label
              class="ars-asesoria__field-label"
              for="ars-telefono-{{ section.id }}"
            >
              {{ 'nij.p08.text_408019c9f6' | t | escape }}
            </label>

            <input
              class="ars-asesoria__input"
              type="tel"
              id="ars-telefono-{{ section.id }}"
              name="contact[phone]"
              autocomplete="tel"
              value="{{ form.phone | escape }}"
              required
            >
          </div>

          <div class="ars-asesoria__field ars-asesoria__field--full">
            <label
              class="ars-asesoria__field-label"
              for="ars-producto-{{ section.id }}"
            >
              {{ 'nij.p08.text_f8a95e81b8' | t | escape }}
            </label>

            <select
              class="ars-asesoria__input"
              id="ars-producto-{{ section.id }}"
              name="contact[Producto de interés]"
              required
            >
              <option
                value=""
                disabled
                {% if form['Producto de interés'] == blank %}
                  selected
                {% endif %}
              >
                {{ 'nij.p08.text_a150d4a325' | t | escape }}
              </option>

              <option value="Panel balístico GR507" {% if form['Producto de interés'] == 'Panel balístico GR507' %}selected{% endif %}>{{ 'nij.p08.text_09e5ae652f' | t | escape }}</option>
<option value="Panel balístico GR407" {% if form['Producto de interés'] == 'Panel balístico GR407' %}selected{% endif %}>{{ 'nij.p08.text_12277648c2' | t | escape }}</option>
<option value="Panel balístico femenino" {% if form['Producto de interés'] == 'Panel balístico femenino' %}selected{% endif %}>{{ 'nij.p08.text_02de5cf09d' | t | escape }}</option>
<option value="Chalecos y configuraciones" {% if form['Producto de interés'] == 'Chalecos y configuraciones' %}selected{% endif %}>{{ 'nij.p08.text_e3842f57c7' | t | escape }}</option>
<option value="Otro equipamiento" {% if form['Producto de interés'] == 'Otro equipamiento' %}selected{% endif %}>{{ 'nij.p08.text_1e862c3020' | t | escape }}</option>
<option value="Asesoría sobre NIJ 0101.07" {% if form['Producto de interés'] == 'Asesoría sobre NIJ 0101.07' %}selected{% endif %}>{{ 'nij.p08.text_dffb8597e6' | t | escape }}</option>
            </select>
          </div>

          <div class="ars-asesoria__field ars-asesoria__field--full">
            <label
              class="ars-asesoria__field-label"
              for="ars-mensaje-{{ section.id }}"
            >
              {{ 'nij.p08.text_f8494badc9' | t | escape }}
            </label>

            <textarea
              class="ars-asesoria__input"
              id="ars-mensaje-{{ section.id }}"
              name="contact[body]"
              rows="4"
              placeholder="{{ 'nij.p08.text_90d010e771' | t | escape }}"
              required
            >{{ form.body | escape }}</textarea>
          </div>

        </div>

        <p class="ars-asesoria__privacy">
          {{ 'nij.p08.text_29ceb3833a' | t | escape }}
          {% if shop.privacy_policy.url != blank %}
            <a href="{{ shop.privacy_policy.url }}">
              {{ 'nij.p08.text_6c678902b8' | t | escape }}
            </a>
          {% endif %}
        </p>

        <button
          class="ars-asesoria__submit"
          type="submit"
        >
          <span>{{ 'nij.p08.text_065d3702c0' | t | escape }}</span>
          <span class="ars-asesoria__arrow" aria-hidden="true">↗</span>
        </button>

      {% endform %}

    </div>
  </div>
</section>
{% endcase %}
