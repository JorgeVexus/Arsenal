{% when 'p02' %}
<style>
  .ars-compare {
    background: #f3f4f1;
    color: #1d2426;
    padding: 40px 24px;
    font-family: var(--font-body-family, inherit);
    font-style: var(--font-body-style, normal);
    font-weight: var(--font-body-weight, 400);
    line-height: 1.5;
    scroll-margin-top: 100px;
  }

  .ars-compare,
  .ars-compare * {
    box-sizing: border-box;
  }

  .ars-compare__inner {
    max-width: 1250px;
    margin: 0 auto;
  }

  .ars-compare .ars-compare__eyebrow {
    color: #dd5409;
    margin: 0 0 20px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .ars-compare__heading {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 32px;
  }

  .ars-compare h2 {
    margin: 0;
    color: #1d2426;
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 700);
    font-size: 64px;
    line-height: 1;
    letter-spacing: -1.5px;
    text-transform: none;
  }

  .ars-compare .ars-compare__intro {
    max-width: 430px;
    margin: 0;
    color: #626c70;
    font-size: 17px;
    line-height: 1.5;
  }

  .ars-compare__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ars-compare__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 22px;
  }

  .ars-compare__filters {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid #cdd2d3;
    border-radius: 3px;
  }

  .ars-compare__filters label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 22px;
    margin: 0;
    color: #626c70;
    background: transparent;
    font-size: 14px;
    line-height: 1;
    font-weight: 400;
    cursor: pointer;
  }

  .ars-compare__filters label + label {
    border-left: 1px solid #cdd2d3;
  }

  .ars-compare__all:checked ~ .ars-compare__toolbar
  .ars-compare__filter-all,
  .ars-compare__handgun:checked ~ .ars-compare__toolbar
  .ars-compare__filter-handgun,
  .ars-compare__rifle:checked ~ .ars-compare__toolbar
  .ars-compare__filter-rifle {
    background: #dd5409;
    color: #fff;
  }

  .ars-compare__all:focus-visible ~ .ars-compare__toolbar
  .ars-compare__filter-all,
  .ars-compare__handgun:focus-visible ~ .ars-compare__toolbar
  .ars-compare__filter-handgun,
  .ars-compare__rifle:focus-visible ~ .ars-compare__toolbar
  .ars-compare__filter-rifle {
    outline: 2px solid #1d2426;
    outline-offset: -4px;
  }

  .ars-compare__handgun:checked ~ .ars-compare__table-wrap
  tr[data-category="rifle"],
  .ars-compare__rifle:checked ~ .ars-compare__table-wrap
  tr[data-category="handgun"] {
    display: none;
  }

  .ars-compare .ars-compare__units {
    margin: 0;
    font-size: 12px;
    color: #626c70;
    line-height: 1.5;
  }

  .ars-compare__table-wrap {
    width: 100%;
  }

  .ars-compare table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    table-layout: fixed;
    background: #fff;
    box-shadow: none;
    font-size: 14px;
    line-height: 1.5;
  }

  .ars-compare th,
  .ars-compare td {
    padding: 22px 14px;
    border: 1px solid #d9ddde;
    text-align: left;
    vertical-align: middle;
    color: #1d2426;
    overflow-wrap: break-word;
  }

  .ars-compare thead th {
    font-family: var(--font-body-family, inherit);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
  }

  .ars-compare thead .ars-compare__before,
  .ars-compare thead .ars-compare__changes {
    background: #242b2d;
    color: #fff;
  }

  .ars-compare thead .ars-compare__now {
    background: #dd5409;
    color: #fff;
  }

  .ars-compare thead .ars-compare__subhead {
    background: #e8ece9;
    color: #1d2426;
  }

  .ars-compare tbody th {
    font-weight: inherit;
    background: #fff;
  }

  .ars-compare .ars-compare__level {
    display: block;
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 700);
    font-size: 28px;
    line-height: 1;
    color: #1d2426;
  }

  .ars-compare td.ars-compare__old-ammo {
    border-right: 3px solid #b9c1bf;
  }

  .ars-compare .ars-compare__new-badge {
    display: inline-block;
    margin-top: 9px;
    padding: 4px 6px;
    background: #fbe9de;
    color: #b54106;
    font-family: var(--font-body-family, inherit);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.5px;
  }

  .ars-compare .ars-compare__ammo-list {
    display: grid;
    gap: 14px;
  }

  .ars-compare .ars-compare__ammo {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .ars-compare .ars-compare__ammo-name {
    display: block;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 400;
    color: #1d2426;
  }

  .ars-compare .ars-compare__ammo--new
  .ars-compare__ammo-name {
    color: #c44805;
    font-weight: 700;
  }

  .ars-compare .ars-compare__speed {
    display: block;
    color: #626c70;
    font-size: 12px;
    line-height: 1.5;
  }

  .ars-compare .ars-compare__cartridge {
    display: block;
    flex: 0 0 16px;
    width: 16px;
    height: 36px;
    overflow: visible;
  }

  .ars-compare .ars-compare__empty {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .ars-compare td.ars-compare__change-copy {
    color: #566166;
    font-size: 14px;
    line-height: 1.5;
  }

  .ars-compare .ars-compare__note {
    margin: 20px 0 0;
    color: #626c70;
    font-size: 12px;
    line-height: 1.5;
  }

  .ars-compare details {
    margin-top: 24px;
    padding: 0;
    border-top: 1px solid #d9ddde;
    border-bottom: 1px solid #d9ddde;
    background: transparent;
  }

  .ars-compare summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    color: #1d2426;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    list-style: none;
    cursor: pointer;
  }

  .ars-compare summary::-webkit-details-marker {
    display: none;
  }

  .ars-compare summary::after {
    content: "+";
    flex-shrink: 0;
    color: #dd5409;
    font-size: 24px;
    line-height: 1;
  }

  .ars-compare details[open] summary::after {
    content: "−";
  }

  .ars-compare .ars-compare__technical {
    padding-bottom: 18px;
  }

  .ars-compare .ars-compare__technical p {
    margin: 0 0 12px;
    color: #626c70;
    font-size: 13px;
    line-height: 1.5;
  }

  .ars-compare .ars-compare__technical p:last-child {
    margin-bottom: 0;
  }

  .ars-compare .ars-compare__technical a {
    color: #1d2426;
    font-size: 12px;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ars-compare__heading {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ars-compare h2 {
      font-size: 56px;
    }

    .ars-compare th,
    .ars-compare td {
      padding: 18px 10px;
    }

    .ars-compare .ars-compare__level {
      font-size: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ars-compare {
      padding: 28px 20px;
    }

    .ars-compare .ars-compare__eyebrow {
      font-size: 11px;
      margin-bottom: 16px;
      letter-spacing: 1px;
    }

    .ars-compare__heading {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .ars-compare h2 {
      font-size: 40px;
      letter-spacing: -1px;
    }

    .ars-compare .ars-compare__intro {
      font-size: 15px;
    }

    .ars-compare__toolbar {
      gap: 10px;
      margin-bottom: 16px;
    }

    .ars-compare__filters {
      width: 100%;
    }

    .ars-compare__filters label {
      flex: 1;
      padding: 10px 8px;
      font-size: 13px;
    }

    .ars-compare table,
    .ars-compare tbody {
      display: block;
      width: 100%;
    }

    .ars-compare thead,
    .ars-compare colgroup {
      display: none;
    }

    .ars-compare tbody tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 16px;
      border: 1px solid #d9ddde;
      background: #fff;
    }

    .ars-compare tbody th,
    .ars-compare tbody td {
      display: block;
      min-width: 0;
      padding: 14px 10px;
      border: 0;
    }

    .ars-compare tbody th:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
      background: #242b2d;
    }

    .ars-compare tbody th:nth-child(3) {
      grid-column: 2;
      grid-row: 1;
      background: #dd5409;
    }

    .ars-compare tbody th:nth-child(1)::before,
    .ars-compare tbody th:nth-child(3)::before {
      display: block;
      margin-bottom: 10px;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      line-height: 1.5;
    }

    .ars-compare tbody th:nth-child(1)::before {
      content: {{ 'nij.p02.mobile_before' | t | json }};
    }

    .ars-compare tbody th:nth-child(3)::before {
      content: {{ 'nij.p02.mobile_now' | t | json }};
    }

    .ars-compare tbody th .ars-compare__level {
      color: #fff;
      font-size: 26px;
    }

    .ars-compare tbody td:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
      border-right: 1px solid #d9ddde;
    }

    .ars-compare tbody td:nth-child(4) {
      grid-column: 2;
      grid-row: 2;
    }

    .ars-compare tbody td:nth-child(5) {
      grid-column: 1 / -1;
      grid-row: 3;
      border-top: 1px solid #d9ddde;
      background: #f9faf8;
      font-size: 13px;
    }

    .ars-compare tbody td:nth-child(5)::before {
      content: "QUÉ CAMBIÓ";
      display: block;
      margin-bottom: 6px;
      color: #c44805;
      font-size: 10px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.8px;
    }

    .ars-compare .ars-compare__ammo {
      gap: 7px;
      align-items: flex-start;
    }

    .ars-compare .ars-compare__ammo-name,
    .ars-compare .ars-compare__empty {
      font-size: 12px;
    }

    .ars-compare .ars-compare__speed {
      font-size: 11px;
    }

    .ars-compare .ars-compare__cartridge {
      flex-basis: 13px;
      width: 13px;
      height: 32px;
    }

    .ars-compare .ars-compare__note {
      font-size: 11px;
      margin-top: 16px;
    }

    .ars-compare summary {
      font-size: 13px;
    }

    .ars-compare .ars-compare__technical p {
      font-size: 12px;
    }
  }
</style>

