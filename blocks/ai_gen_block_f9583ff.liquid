{% doc %}
  @prompt
    seccion de texto con 1 imagenes destacadas, texto a la izaquierda, las 1 imagenes a la derecha, responsive con efecto de animación de entrada y hover efect sobre la imagen
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-image-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-text-image-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.container_border_radius | default: 12 }}px;
  }

  /* Proporciones de Columna */
  .ai-text-image-text-{{ ai_gen_id }} {
    {% if block.settings.column_ratio == '65_35' %}
      flex: 0 0 calc(65% - ({{ block.settings.gap }}px / 2));
    {% elsif block.settings.column_ratio == '60_40' %}
      flex: 0 0 calc(60% - ({{ block.settings.gap }}px / 2));
    {% elsif block.settings.column_ratio == '70_30' %}
      flex: 0 0 calc(70% - ({{ block.settings.gap }}px / 2));
    {% else %}
      flex: 1;
    {% endif %}
    opacity: 0;
    transform: translateX(-30px);
  }

  .ai-text-image-text-{{ ai_gen_id }}.ai-animate-in {
    animation: ai-slide-in-left-{{ ai_gen_id }} 0.8s ease-out forwards;
  }

  .ai-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 16px;
    background: {{ block.settings.badge_bg_color | default: 'rgba(234, 92, 16, 0.1)' }};
    color: {{ block.settings.badge_color | default: '#ea5c10' }};
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
  }

  .ai-text-image-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    line-height: 1.25;
  }

  .ai-text-image-heading-{{ ai_gen_id }} p,
  .ai-text-image-heading-{{ ai_gen_id }} strong {
    margin: 0;
  }

  .ai-text-image-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.7;
    margin: 0;
    text-align: {{ block.settings.text_alignment | default: 'left' }};
    {% if block.settings.text_alignment == 'justify' %}
      text-justify: inter-word;
      -webkit-hyphens: auto;
      hyphens: auto;
    {% endif %}
  }

  .ai-text-image-description-{{ ai_gen_id }} p {
    margin: 0 0 14px 0;
  }
  .ai-text-image-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  /* Columna de Imagen / Logos */
  .ai-text-image-image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.column_ratio == '65_35' %}
      flex: 0 0 calc(35% - ({{ block.settings.gap }}px / 2));
    {% elsif block.settings.column_ratio == '60_40' %}
      flex: 0 0 calc(40% - ({{ block.settings.gap }}px / 2));
    {% elsif block.settings.column_ratio == '70_30' %}
      flex: 0 0 calc(30% - ({{ block.settings.gap }}px / 2));
    {% else %}
      flex: 1;
    {% endif %}
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: {% if block.settings.image_alignment == 'left' %}flex-start{% elsif block.settings.image_alignment == 'right' %}flex-end{% else %}center{% endif %};
    justify-content: center;
    opacity: 0;
    transform: translateX(30px);
  }

  .ai-text-image-image-wrapper-{{ ai_gen_id }}.ai-animate-in {
    animation: ai-slide-in-right-{{ ai_gen_id }} 0.8s ease-out forwards;
  }

  /* Tarjeta de Showcase para Logos */
  .ai-image-card-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width | default: 380 }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    {% if block.settings.enable_image_card %}
      background: {{ block.settings.card_bg | default: '#ffffff' }};
      border: 1px solid {{ block.settings.card_border | default: '#e8e8e8' }};
      border-radius: {{ block.settings.image_border_radius }}px;
      padding: {{ block.settings.card_padding | default: 24 }}px;
      box-shadow: 0 10px 28px -6px rgba(0, 0, 0, 0.07);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% else %}
      border-radius: {{ block.settings.image_border_radius }}px;
    {% endif %}
  }

  {% if block.settings.enable_image_card %}
    .ai-image-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.12);
    }
  {% endif %}

  .ai-text-image-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width | default: 380 }}px;
    max-height: {{ block.settings.image_max_height | default: 240 }}px;
    object-fit: contain;
    height: auto;
    display: block;
    margin: 0 auto;
    transition: transform 0.4s ease;
  }

  .ai-text-image-image-wrapper-{{ ai_gen_id }}:hover .ai-text-image-image-{{ ai_gen_id }} {
    {% unless block.settings.enable_image_card %}
      transform: scale({{ block.settings.hover_scale }});
    {% endunless %}
  }

  .ai-text-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-text-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-text-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @keyframes ai-slide-in-left-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateX(-30px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes ai-slide-in-right-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateX(30px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media screen and (max-width: 989px) {
    .ai-text-image-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.gap_mobile }}px;
      text-align: left;
    }

    .ai-text-image-text-{{ ai_gen_id }},
    .ai-text-image-image-wrapper-{{ ai_gen_id }} {
      flex: 1 1 100%;
      width: 100%;
    }

    .ai-text-image-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-text-image-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-image-card-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-text-image-image-{{ ai_gen_id }} {
      max-width: 320px;
    }
  }
{% endstyle %}

<text-image-section-{{ ai_gen_id }}
  class="ai-text-image-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-text-image-container-{{ ai_gen_id }}">
    <div class="ai-text-image-text-{{ ai_gen_id }}" data-animate>
      {% if block.settings.badge_text != blank %}
        <span class="ai-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
      {% endif %}

      {% if block.settings.heading != blank %}
        <div class="ai-text-image-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-text-image-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-text-image-image-wrapper-{{ ai_gen_id }}" data-animate>
      <div class="ai-image-card-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | default: 'Certificado y Acreditaciones' | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-text-image-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-text-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-text-image-empty-state-{{ ai_gen_id }}">
              Siguiente, agrega una imagen
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</text-image-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TextImageSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.observer = null;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.2
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('ai-animate-in');
              this.observer.unobserve(entry.target);
            }
          });
        }, options);

        const animateElements = this.querySelectorAll('[data-animate]');
        animateElements.forEach((el) => {
          this.observer.observe(el);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('text-image-section-{{ ai_gen_id }}', TextImageSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Texto con imagen",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Insignia / Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto de la insignia",
      "default": "Norma Internacional"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Color de la insignia",
      "default": "#ea5c10"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Fondo de la insignia",
      "default": "rgba(234, 92, 16, 0.1)"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Título",
      "default": "<p>Nuestro compromiso</p>"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente del título",
      "default": "inter_n7"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Ofrecemos productos de la más alta calidad con un servicio excepcional. Nuestra misión es superar tus expectativas en cada compra.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "justify", "label": "Justificado" },
        { "value": "center", "label": "Centrado" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Imagen / Logos"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Ancho máximo de la imagen / logos",
      "min": 150,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 380
    },
    {
      "type": "range",
      "id": "image_max_height",
      "label": "Altura máxima de la imagen / logos",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Alineación horizontal de la imagen",
