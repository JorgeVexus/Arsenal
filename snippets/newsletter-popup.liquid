{% if settings.newsletter_popup_image != blank %}
  <article
    class="popup-a arsenal-promo-popup"
    data-title="newsletter-popup"
    {% unless settings.show_cookiebanner %}
      data-popup-delay="{{ settings.newsletter_popup_seconds | minus: 0.5 | times: 1000 | round }}"
    {% endunless %}
  >
    <figure class="arsenal-promo-popup__image">
      <a
        href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/botas-tacticas-spider"
        aria-label="Ver botas tácticas SPIDER"
      >
        <img
          src="{{ settings.newsletter_popup_image | image_url }}"
          width="{{ settings.newsletter_popup_image.width }}"
          height="{{ settings.newsletter_popup_image.height }}"
          alt="{{ settings.newsletter_popup_image.alt | default: 'Botas tácticas SPIDER de Arsenal Protection Mexico' | escape }}"
          loading="eager"
        >
      </a>
    </figure>
  </article>

  <style>
    /* La capa ocupa toda la pantalla para centrar el anuncio. */
    .popup-a.arsenal-promo-popup {
      width: 100% !important;
      max-width: none !important;
      padding: 0 !important;
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      --width: 620px;
      --imgw: 0px;
    }

    .arsenal-promo-popup .box-outer {
      padding: 24px !important;
      justify-content: center !important;
      align-items: center !important;
    }

    .arsenal-promo-popup .box-inner {
      width: 100% !important;
      max-width: 620px !important;
      margin: auto !important;
    }

    /* Este es el contenedor blanco que agrega el tema. */
    .arsenal-promo-popup .box-inset {
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .arsenal-promo-popup .box-inset::before {
      display: none !important;
    }

    .arsenal-promo-popup .arsenal-promo-popup__image {
      display: block !important;
      position: static !important;
      float: none !important;
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      background: transparent !important;
    }

    .arsenal-promo-popup__image a {
      display: block;
      margin: 0;
      padding: 0;
    }

    .arsenal-promo-popup__image img {
      display: block;
      position: static;
      width: 100%;
      height: auto;
      max-height: calc(100vh - 48px);
      max-height: calc(100dvh - 48px);
      margin: 0;
      border-radius: 10px;
      object-fit: contain;
    }

    /* Cierre visible sobre la imagen. */
    .arsenal-promo-popup .box-inset > a.close {
      top: 8px !important;
      right: 8px !important;
      left: auto !important;
      width: 36px !important;
      height: 36px !important;
      border-radius: 50%;
      background: #111 !important;
      color: #fff !important;
    }
  </style>
{% endif %}