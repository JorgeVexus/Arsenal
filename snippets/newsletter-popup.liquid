{% if settings.newsletter_popup_image != blank %}
  <article
    class="popup-a arsenal-promo-popup"
    data-title="newsletter-popup"
    {% unless settings.show_cookiebanner %}
      data-popup-delay="{{ settings.newsletter_popup_seconds | minus: 0.5 | times: 1000 | round }}"
    {% endunless %}
  >
    <figure class="arsenal-promo-popup__image">
      <a
        href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/botas-tacticas-spider"
        aria-label="Ver botas tácticas SPIDER"
      >
        <img
          src="{{ settings.newsletter_popup_image | image_url }}"
          width="{{ settings.newsletter_popup_image.width }}"
          height="{{ settings.newsletter_popup_image.height }}"
          alt="{{ settings.newsletter_popup_image.alt | default: 'Conoce las botas tácticas SPIDER de Arsenal Protection Mexico' | escape }}"
          loading="eager"
        >
      </a>
    </figure>
  </article>

  <style>
    .popup-a.arsenal-promo-popup {
      width: min(620px, calc(100vw - 32px));
      max-width: calc(100vw - 32px);
      padding: 0;
      background: transparent;
    }

    .arsenal-promo-popup .arsenal-promo-popup__image {
      display: block;
      position: static;
      float: none;
      width: 100%;
      max-width: none;
      height: auto;
      margin: 0;
      padding: 0;
    }

    .arsenal-promo-popup__image a {
      display: block;
    }

    .arsenal-promo-popup__image img {
      display: block;
      position: static;
      width: 100%;
      height: auto;
      max-height: 85vh;
      max-height: 85dvh;
      object-fit: contain;
    }
  </style>
{% endif %}