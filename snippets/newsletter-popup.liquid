{% if settings.newsletter_popup_image != blank %}

  {% capture arsenal_product_url %}
    {{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/botas-tacticas-spider
  {% endcapture %}

  <script>
    /*
      Permite mostrar la promoción nuevamente
      en cada carga o recarga de la página.
    */
    document.cookie =
      'has-newsletter=; Max-Age=0; path=/; SameSite=Lax';
  </script>

  <article
    class="popup-a arsenal-promo-popup"
    data-title="newsletter-popup"
    data-popup-delay="{{ settings.newsletter_popup_seconds | times: 1000 | round }}"
  >
    <div class="arsenal-promo-popup__card">

      <figure class="arsenal-promo-popup__image">
        <a
          href="{{ arsenal_product_url | strip | escape }}"
          aria-label="Ver botas tácticas SPIDER"
        >
          <img
            src="{{ settings.newsletter_popup_image | image_url }}"
            width="{{ settings.newsletter_popup_image.width }}"
            height="{{ settings.newsletter_popup_image.height }}"
            alt="{{ settings.newsletter_popup_image.alt | default: 'Botas tácticas SPIDER de Arsenal Protection Mexico' | escape }}"
            loading="eager"
          >
        </a>
      </figure>

      <div class="arsenal-promo-popup__actions">
        <a
          class="arsenal-promo-popup__button"
          href="{{ arsenal_product_url | strip | escape }}"
        >
          Ver producto
        </a>
      </div>

    </div>
  </article>

  <style>
    /* Capa del pop-up. */
    .popup-a.arsenal-promo-popup {
      width: 100% !important;
      max-width: none !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;

      --width: 620px;
      --imgw: 0px;
    }

    /* Fondo oscuro y desenfocado. */
    .arsenal-promo-popup::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      pointer-events: none;
    }

    /* Centrado del anuncio. */
    .arsenal-promo-popup .box-outer {
      padding: 24px !important;
      justify-content: center !important;
      align-items: center !important;
    }

    .arsenal-promo-popup .box-inner {
      width: 100% !important;
      max-width: 620px !important;
      margin: auto !important;
    }

    /* Elimina el marco blanco del tema. */
    .arsenal-promo-popup .box-inset {
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .arsenal-promo-popup .box-inset::before {
      display: none !important;
    }

    /* Sombra del anuncio. */
    .arsenal-promo-popup__card {
      margin: 0;
      padding: 0;
      filter: drop-shadow(
        0 16px 35px rgba(0, 0, 0, 0.65)
      );
    }

    /* Contenedor de la imagen. */
    .arsenal-promo-popup .arsenal-promo-popup__image {
      display: block !important;
      position: static !important;
      float: none !important;
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      background: transparent !important;
    }

    .arsenal-promo-popup__image a {
      display: block;
      margin: 0;
      padding: 0;
    }

    /* Imagen completa, sin recortar. */
    .arsenal-promo-popup__image img {
      display: block;
      position: static;
      width: 100%;
      height: auto;
      max-height: calc(100vh - 140px);
      max-height: calc(100dvh - 140px);
      margin: 0;
      border-radius: 10px;
      object-fit: contain;
    }

    /* Espacio del botón. */
    .arsenal-promo-popup__actions {
      display: flex;
      justify-content: center;
      margin: 16px 0 0;
      padding: 0;
    }

    /* Botón Ver producto. */
    .arsenal-promo-popup a.arsenal-promo-popup__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 32px;
      border: 0;
      border-radius: 999px;
      background: #ff6500;
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
      transition: background 0.2s ease;
    }

    .arsenal-promo-popup a.arsenal-promo-popup__button:hover {
      background: #d95000;
      color: #ffffff;
    }

    .arsenal-promo-popup a.arsenal-promo-popup__button:focus-visible {
      outline: 3px solid #ffffff;
      outline-offset: 4px;
    }

    /* Botón de cierre. */
    .arsenal-promo-popup .box-inset > a.close {
      top: 8px !important;
      right: 8px !important;
      left: auto !important;
      width: 36px !important;
      height: 36px !important;
      border-radius: 50%;
      background: #111111 !important;
      color: #ffffff !important;
    }
  </style>

{% endif %}