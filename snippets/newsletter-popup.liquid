{% if settings.newsletter_popup_image != blank %}

  {% capture arsenal_product_url %}{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/botas-tacticas-spider{% endcapture %}

  <article
    class="popup-a arsenal-promo-popup"
    data-title="newsletter-popup"
    data-arsenal-delay="{{ settings.newsletter_popup_seconds | times: 1000 | round }}"
  >
    <div class="arsenal-promo-popup__card">

      <figure class="arsenal-promo-popup__image">
        <a
          href="{{ arsenal_product_url | strip | escape }}"
          aria-label="Ver botas tácticas SPIDER"
        >
          <img
            src="{{ settings.newsletter_popup_image | image_url }}"
            width="{{ settings.newsletter_popup_image.width }}"
            height="{{ settings.newsletter_popup_image.height }}"
            alt="{{ settings.newsletter_popup_image.alt | default: 'Botas tácticas SPIDER de Arsenal Protection Mexico' | escape }}"
            loading="eager"
          >
        </a>
      </figure>

      <div class="arsenal-promo-popup__actions">
        <a
          class="arsenal-promo-popup__button"
          href="{{ arsenal_product_url | strip | escape }}"
        >
          Ver producto
        </a>
      </div>

    </div>
  </article>

  <style>
    .popup-a.arsenal-promo-popup {
      width: 100% !important;
      max-width: none !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      --width: 620px;
      --imgw: 0px;
    }

    .arsenal-promo-popup::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      pointer-events: none;
    }

    .arsenal-promo-popup .box-outer {
      padding: 24px !important;
      justify-content: center !important;
      align-items: center !important;
    }

    .arsenal-promo-popup .box-inner {
      width: 100% !important;
      max-width: 620px !important;
      margin: auto !important;
    }

    .arsenal-promo-popup .box-inset {
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .arsenal-promo-popup .box-inset::before {
      display: none !important;
    }

    .arsenal-promo-popup__card {
      margin: 0;
      padding: 0;
      filter: drop-shadow(
        0 16px 35px rgba(0, 0, 0, 0.65)
      );
    }

    .arsenal-promo-popup .arsenal-promo-popup__image {
      display: block !important;
      position: static !important;
      float: none !important;
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      background: transparent !important;
    }

    .arsenal-promo-popup__image a {
      display: block;
      margin: 0;
      padding: 0;
    }

    .arsenal-promo-popup__image img {
      display: block;
      position: static;
      width: 100%;
      height: auto;
      max-height: calc(100vh - 140px);
      max-height: calc(100dvh - 140px);
      margin: 0;
      border-radius: 10px;
      object-fit: contain;
    }

    .arsenal-promo-popup__actions {
      display: flex;
      justify-content: center;
      margin: 16px 0 0;
      padding: 0;
    }

    .arsenal-promo-popup a.arsenal-promo-popup__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 32px;
      border: 0;
      border-radius: 999px;
      background: #ff6500;
      color: #fff;
      font: inherit;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
    }

    .arsenal-promo-popup a.arsenal-promo-popup__button:hover {
      background: #d95000;
      color: #fff;
    }

    .arsenal-promo-popup a.arsenal-promo-popup__button:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 4px;
    }

    .arsenal-promo-popup .box-inset > a.close {
      top: 8px !important;
      right: 8px !important;
      left: auto !important;
      width: 36px !important;
      height: 36px !important;
      border-radius: 50%;
      background: #111 !important;
      color: #fff !important;
    }
  </style>

  <script>
    (function () {
      function iniciarPromocion() {
        var popup = document.querySelector(
          '.arsenal-promo-popup'
        );

        if (!popup || popup.dataset.arsenalStarted === 'true') {
          return;
        }

        popup.dataset.arsenalStarted = 'true';

        var abiertoEnEstaCarga = popup.classList.contains('shown');
        var tiempo = Number(
          popup.getAttribute('data-arsenal-delay')
        );

        if (!Number.isFinite(tiempo) || tiempo < 0) {
          tiempo = 2000;
        }

        /*
          Si el tema lo abre al cerrar el aviso de cookies,
          lo registramos para evitar una segunda apertura
          durante esta misma carga.
        */
        var observador = new MutationObserver(function () {
          if (popup.classList.contains('shown')) {
            abiertoEnEstaCarga = true;
            observador.disconnect();
          }
        });

        observador.observe(popup, {
          attributes: true,
          attributeFilter: ['class']
        });

        var intentos = 0;

        function abrirPromocion() {
          if (
            abiertoEnEstaCarga ||
            !document.documentElement.contains(popup)
          ) {
            observador.disconnect();
            return;
          }

          /*
            Espera si hay otro pop-up abierto,
            para no cerrar el aviso de cookies.
          */
          var otroPopup = document.querySelector(
            '.popup-a.shown:not(.arsenal-promo-popup)'
          );

          if (
            otroPopup ||
            document.documentElement.classList.contains('page-blocked')
          ) {
            window.setTimeout(abrirPromocion, 500);
            return;
          }

          /*
            Usa la apertura y el cierre originales del tema,
            sin consultar el recordatorio de cierre anterior.
          */
          if (typeof window.loadPopup === 'function') {
            abiertoEnEstaCarga = true;
            observador.disconnect();
            window.loadPopup('newsletter-popup');
            return;
          }

          intentos += 1;

          if (intentos < 120) {
            window.setTimeout(abrirPromocion, 250);
          } else {
            observador.disconnect();
            console.warn(
              'Arsenal: no se pudo cargar el controlador del pop-up.'
            );
          }
        }

        window.setTimeout(abrirPromocion, tiempo);
      }

      if (document.readyState === 'loading') {
        document.addEventListener(
          'DOMContentLoaded',
          iniciarPromocion,
          { once: true }
        );
      } else {
        iniciarPromocion();
      }
    })();
  </script>

{% endif %}