                    {%- when 'limpieza', 'articulos-de-limpieza' -%}
                      <svg width="20" height="20" viewBox="0 0 18 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 8V2H16V0H2V2H4V8L0 12V22H18V12L14 8ZM6 2H12V8H6V2ZM16 20H2V13H16V20Z" fill="currentColor"/></svg>
                    {%- when 'bano', 'baño' -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 13V4.83C20 3.27 18.73 2 17.17 2C15.61 2 14.34 3.27 14.34 4.83V5H13V3H9V5H4V7H12.34V4.83C12.34 3.27 13.61 2 15.17 2C16.73 2 18 3.27 18 4.83V13H2V19C2 20.66 3.34 22 5 22H19C20.66 22 22 20.66 22 19V13H20ZM19 20H5C4.45 20 4 19.55 4 19V15H20V19C20 19.55 19.55 20 19 20Z" fill="currentColor"/></svg>
                    {%- when 'escolar-y-oficina', 'escolar', 'oficina' -%}
