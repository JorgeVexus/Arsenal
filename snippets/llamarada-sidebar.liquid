                    {%- when 'abarrotes' -%}
                      <svg width="20" height="20" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 6H16.71L12.55 0.17L10.92 1.33L14.26 6H7.74L11.08 1.33L9.45 0.17L5.29 6H3C1.34 6 0 7.34 0 9V17C0 18.66 1.34 20 3 20H19C20.66 20 22 18.66 22 17V9C22 7.34 20.66 6 19 6ZM19 18H3C2.45 18 2 17.55 2 17V9C2 8.45 2.45 8 3 8H19C19.55 8 20 8.45 20 9V17C20 17.55 19.55 18 19 18Z" fill="currentColor"/></svg>
                    {%- else -%}
                      <svg width="20" height="20" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 6H18V4H16V6V6M16 10H18V8H16V10V10M16 14H18V12H16V14V14M16 18V16H20V2H11V3.4L9 1.95V0H22V18H16V18M0 18V8L7 3L14 8V18H8V13H6V18H0V18M2 16H4V11H10V16H12V9L7 5.45L2 9V16V16M16 7V7V7V7V7V7V7V7M10 16V16V11H4V16V16V11H7H10V16V16" fill="currentColor"/></svg>
                  {%- endcase -%}
                </span>
                <span>{{ link.title }}</span>
              </a>
              <button type="button" class="ll-sidebar__toggle-btn" aria-label="Desplegar submenú {{ link.title }}" aria-expanded="{% if is_child_active or is_link_active %}true{% else %}false{% endif %}">
                <svg class="ll-sidebar__chevron" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            <div class="ll-sidebar__submenu">
              <div class="ll-sidebar__submenu-inner">
                {%- for child_link in link.links -%}
                  {%- assign is_sub_active = false -%}
                  {%- if child_link.active or child_link.current or current_handle == child_link.object.handle -%}
                    {%- assign is_sub_active = true -%}
                  {%- endif -%}

                  {%- if child_link.links.size > 0 -%}
                    <div class="ll-sidebar__sub-accordion" data-sub-accordion>
                      <div class="ll-sidebar__sub-header">
                        <a href="{{ child_link.url }}" class="ll-sidebar__sub-link{% if is_sub_active %} is-active{% endif %}">
                          <span class="ll-sidebar__sub-bullet"></span>
                          <span>{{ child_link.title }}</span>
                        </a>
                        <button type="button" class="ll-sidebar__sub-toggle-btn" aria-label="Desplegar {{ child_link.title }}">
                          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </div>
                      <div class="ll-sidebar__sub-sub-menu">
                        {%- for grand_child in child_link.links -%}
                          <a href="{{ grand_child.url }}" class="ll-sidebar__grandchild-link{% if grand_child.active or grand_child.current %} is-active{% endif %}">
                            <span>{{ grand_child.title }}</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <a href="{{ child_link.url }}" class="ll-sidebar__sub-link{% if is_sub_active %} is-active{% endif %}">
                      <span class="ll-sidebar__sub-bullet"></span>
                      <span>{{ child_link.title }}</span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
