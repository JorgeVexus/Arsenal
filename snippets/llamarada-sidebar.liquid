{%- assign current_handle = collection.handle -%}

<aside class="ll-sidebar" aria-label="Menú lateral de navegación mayorista">
  <!-- Top card CTA with single functional login button -->
  <div class="ll-sidebar__card">
    <h2 class="ll-sidebar__title">Importamos lo que necesitas</h2>
    <p class="ll-sidebar__subtitle">Venta por Mayoreo</p>
    
    {%- if customer -%}
      <div class="ll-sidebar__user-box">
        <a href="{{ routes.account_url }}" class="ll-sidebar__btn-login">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/></svg>
          <span>Mi Cuenta</span>
        </a>
        <a href="{{ routes.account_logout_url }}" class="ll-sidebar__btn-logout">
          Cerrar Sesión
        </a>
      </div>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="ll-sidebar__btn-login">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/></svg>
        <span>Iniciar Sesión</span>
      </a>
    {%- endif -%}
  </div>  <!-- Category Nav List with Apple Design fluid accordions -->
  <nav class="ll-sidebar__nav" aria-label="Categorías">
    {%- assign side_nav = linklists['main-menu'] -%}
    {%- if linklists['sidebar-menu'] != blank and linklists['sidebar-menu'].links.size > 0 -%}
      {%- assign side_nav = linklists['sidebar-menu'] -%}
    {%- endif -%}

    {%- if side_nav != blank and side_nav.links.size > 0 -%}
      {%- for link in side_nav.links -%}
        {%- assign link_handle = link.object.handle | default: link.title | handleize -%}
        {%- assign is_link_active = false -%}
        {%- assign is_child_active = false -%}
        
        {%- if request.page_type == 'index' -%}
          {%- if link.url == '/' or link.url == routes.root_url or link_handle == 'inicio' -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
        {%- elsif request.page_type == 'collection' -%}
          {%- if current_handle != blank and current_handle == link_handle -%}
            {%- assign is_link_active = true -%}
          {%- elsif link.active and link.url != '/' and link.url != routes.root_url -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
        {%- else -%}
          {%- if link.active and link.url != '/' and link.url != routes.root_url -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if link.links.size > 0 -%}
          {%- for child in link.links -%}
            {%- if child.active or child.current or current_handle == child.object.handle -%}
              {%- assign is_child_active = true -%}
            {%- endif -%}
            {%- for gchild in child.links -%}
              {%- if gchild.active or gchild.current or current_handle == gchild.object.handle -%}
                {%- assign is_child_active = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}

          <div class="ll-sidebar__accordion{% if is_child_active or is_link_active %} is-expanded{% endif %}" data-accordion-item>
            <div class="ll-sidebar__accordion-header">
              <a href="{{ link.url }}" class="ll-sidebar__nav-item ll-sidebar__nav-item--parent{% if is_link_active and is_child_active == false %} is-active{% endif %}">
                <span class="ll-sidebar__icon">
                  {%- case link_handle -%}
                    {%- when 'inicio' -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="currentColor"/></svg>
                    {%- when 'hogar' -%}
